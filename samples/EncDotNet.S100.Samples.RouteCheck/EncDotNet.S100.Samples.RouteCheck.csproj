<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EncDotNet.S100.Samples.RouteCheck</RootNamespace>
    <AssemblyName>EncDotNet.S100.Samples.RouteCheck</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Consumers would reference the published NuGet packages instead:
        <PackageReference Include="EncDotNet.S100.Navigation" />
        <PackageReference Include="EncDotNet.S100.Datasets.Pipelines" />
        <PackageReference Include="EncDotNet.S100.Crs.ProjNet" />
        <PackageReference Include="EncDotNet.S100.Routes.Rtz" />
      In-repo the sample uses project references so it builds in CI.
    -->
    <ProjectReference Include="..\..\src\EncDotNet.S100.Navigation\EncDotNet.S100.Navigation.csproj" />
    <ProjectReference Include="..\..\src\EncDotNet.S100.Datasets.Pipelines\EncDotNet.S100.Datasets.Pipelines.csproj" />
    <ProjectReference Include="..\..\src\EncDotNet.S100.Crs.ProjNet\EncDotNet.S100.Crs.ProjNet.csproj" />
    <ProjectReference Include="..\..\src\EncDotNet.S100.Routes.Rtz\EncDotNet.S100.Routes.Rtz.csproj" />

    <!--
      In-repo only: the test scenario generator writes the sample's SYNTHETIC
      data (charts, S-102, S-104, S-122 and S-124 over a fictitious sound)
      into a temporary folder, so the sample needs no download. It isn't a
      published package; with your own data, drop this reference.
    -->
    <ProjectReference Include="..\..\tests\EncDotNet.S100.Testing.Scenarios\EncDotNet.S100.Testing.Scenarios.csproj" />
  </ItemGroup>

</Project>
