<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>s100</AssemblyName>
    <RootNamespace>EncDotNet.S100.Cli</RootNamespace>
    <Version>0.0.0-dev</Version>
    <!-- See Directory.Build.targets: ship the NoDependencies Skia native on Linux (issue #23). -->
    <UseSkiaSharpLinuxNoDependencies>true</UseSkiaSharpLinuxNoDependencies>
    <!--
      Distributed as standalone, self-contained, per-RID release archives
      (`s100-<version>-<rid>.{zip,tar.gz}`) attached to each GitHub Release, not
      as a `dotnet tool install -g` global tool. A RID-agnostic packed tool does
      not reliably lay out SkiaSharp's `runtimes/<rid>/native/libSkiaSharp.*`
      native assets, so a self-contained publish (which lays them out correctly
      and bundles the .NET runtime) is used instead. `PackAsTool` therefore
      stays disabled. The `s100` command name comes from `AssemblyName` above.
    -->
    <PackAsTool>false</PackAsTool>
    <!-- Trim analyzers run on every build (issue #764): reflection they cannot
         follow is an error, as in the libraries. The app is not published trimmed. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- The web SDK writes an IIS web.config on publish; the CLI is never hosted in IIS. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <!--
    Microsoft.NET.Sdk.Web, for the tiles serve web page's Razor components
    (issue #1575): only the Web SDK adds the framework's blazor.web.js as a
    static web asset. It also brings the ASP.NET Core shared framework
    (Kestrel for the serve commands). Its ASP.NET implicit usings are removed,
    so the CLI compiles as it did under Microsoft.NET.Sdk.
  -->
  <ItemGroup>
    <Using Remove="System.Net.Http.Json" />
    <Using Remove="Microsoft.AspNetCore.Builder" />
    <Using Remove="Microsoft.AspNetCore.Hosting" />
    <Using Remove="Microsoft.AspNetCore.Http" />
    <Using Remove="Microsoft.AspNetCore.Routing" />
    <Using Remove="Microsoft.Extensions.Configuration" />
    <Using Remove="Microsoft.Extensions.DependencyInjection" />
    <Using Remove="Microsoft.Extensions.Hosting" />
    <Using Remove="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- MBTiles output for `s100 tiles export`. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Skill\**\*.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EncDotNet.S100.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EncDotNet.S100\EncDotNet.S100.csproj" />
    <ProjectReference Include="..\..\src\EncDotNet.S100.Collections\EncDotNet.S100.Collections.csproj" />
    <ProjectReference Include="..\..\src\EncDotNet.S100.Core\EncDotNet.S100.Core.csproj" />
