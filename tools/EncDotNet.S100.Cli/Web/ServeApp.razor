@page "/"
@* The tiles serve web page (issue #1573): rendered here, with the map's controls interactive over a circuit. *@
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    @* The token, when there is one, is the request's path base (TileServer), so links stay under it. *@
    <base href="@BaseHref" />
    <title>@ServeSummary.Title(Data)</title>
    <link rel="stylesheet" href="@Assets["lib/maplibre-gl/maplibre-gl.css"]">
    <link rel="stylesheet" href="@Assets["css/serve.css"]">
    <script src="@Assets["lib/maplibre-gl/maplibre-gl.js"]"></script>
    <script src="@Assets["js/serve-map.js"]"></script>
    <script src="@Assets["js/serve-pick.js"]"></script>
    <script src="@Assets["js/serve-live.js"]"></script>
</head>
<body>
    @* One page, so no Router (its generated code isn't trim-safe): the endpoint renders this document directly. *@
    @* The public base URL is the request's (issue #1582): the circuit has no request, so it's handed over. *@
    <ServePage @rendermode="InteractiveServer" BaseUrl="@BaseUrl" />
    @* Present, so Blazor reports its reconnection states as events rather than drawing its own dialog (D30, js/serve-live.js). *@
    <div id="components-reconnect-modal" hidden></div>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    [Inject]
    private IServePageData Data { get; set; } = null!;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string BaseUrl => HttpContext is { } context ? Data.PublicBaseUri(context.Request).AbsoluteUri : "";

    private string BaseHref => (HttpContext?.Request.PathBase.Value ?? "") + "/";
}
