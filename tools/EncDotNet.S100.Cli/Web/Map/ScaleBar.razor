@* The scale bar, top centre (handoff D6). The JS module sizes the bar and writes its label as the map moves. *@
<div class="scale-bar" aria-hidden="true">
    <span class="scale-zero">0</span>
    <span class="scale-label" data-scale-label></span>
    <span class="scale-line" data-scale-line></span>
</div>
