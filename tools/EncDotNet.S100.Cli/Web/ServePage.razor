@* The page (issues #1573, #1585): the header, the rail and docked panel (a sheet on a phone) and the map.
   One page, no router. The map is MapLibre, driven through js/serve-map.js; the state is here. *@
@implements IAsyncDisposable
@inject IServePageData Data
@inject IJSRuntime JS

<div class="serve" data-theme="@Theme">
    <ServeHeader Summary="@summary"
                 State="ServerState.Live"
                 StateDetail="@(Data.Revision is { } revision ? "revision " + revision : null)"
                 LinkCopied="linkCopied"
                 GisOpen="activePanel == ServePanel.UseInGis"
                 OnSummary="() => OpenPanel(railItems[0].Panel)"
                 OnCopyLink="CopyLinkAsync"
                 OnUseInGis="() => OpenPanel(ServePanel.UseInGis)" />
    <div class="serve-body" data-time-bar="@(times.Count == 0 ? "none" : TimeBarDocked ? "docked" : "floating")">
        <Sheet Height="sheet" PanelOpen="activePanel is not null" Summary="@summary" OnGesture="SheetGesture">
            <TopContent>
                @if (times.Count > 0 && TimeBarDocked)
                {
                    @TimeBarFragment(true)
                }
            </TopContent>
            <RailContent>
                <Rail Items="railItems" Active="activePanel" OnSelect="SelectPanel" />
            </RailContent>
            <ChildContent>
                @if (isPhone && pickPoint is not null)
                {
                    <div class="panel pick-sheet">@PickBody</div>
                }
                else if (activePanel is { } panel)
                {
                    <Panel Title="@(panel == ServePanel.Datasets && selectedDataset is not null ? "Dataset" : PanelTitle(panel))" OnClose="() => activePanel = null"
                           OnBack="@(panel == ServePanel.Datasets && selectedDataset is not null ? EventCallback.Factory.Create(this, () => SelectDatasetAsync(null)) : default)">
                        @switch (panel)
                        {
                            case ServePanel.Datasets:
                                <DatasetsPanel Selected="@selectedDataset" OnSelect="SelectDatasetAsync" OnMatches="SetDatasetMatchesAsync"
                                               OnZoomTo="ZoomToDatasetAsync" CopyLink="CopyDatasetLinkAsync" CopyText="CopyTextAsync" />
                                break;
                            case ServePanel.TileSet:
                                <TileSetPanel OnZoomTo="ZoomToDataAsync" />
                                break;
                            case ServePanel.Display:
                                <DisplayPanel HasDatasets="Data.HasDatasets" Palettes="Data.Palettes" Palette="@palette" PaletteChanged="SetPaletteAsync"
                                              Layers="layerChoices" Layer="@layer" LayerChanged="SetLayerAsync"
                                              Basemap="basemap" BasemapFailed="basemapFailed" BasemapChanged="SetBasemapAsync"
                                              HasTimes="times.Count > 0" TimesUtc="timesUtc" TimesUtcChanged="SetTimesUtc" LocalZone="@LocalZone"
                                              Page="page" PageChanged="SetPageAsync" />
                                break;
                            case ServePanel.UseInGis:
                                <UseInGisPanel />
                                break;
                        }
                    </Panel>
                }
            </ChildContent>
        </Sheet>
        <main class="map-area" aria-label="Map">
            <div id="map" class="map"></div>
            <ScaleBar />
            <MapOverlayButtons OnZoomIn="() => ZoomByAsync(1)" OnZoomOut="() => ZoomByAsync(-1)" OnZoomToData="ZoomToDataAsync" OnNorthUp="NorthUpAsync" />
            @if (zoomLimit == ZoomLimit.BelowMinimum)
            {
                <MapChip ActionLabel="Zoom to the data" ActionIcon="fit" OnAction="ZoomToDataAsync">
                    The chart draws from zoom @tileSet.MinZoom. Outlines show where the data is.
                </MapChip>
            }
            else if (zoomLimit == ZoomLimit.PastMaximum)
            {
                <MapChip ActionLabel="@("Back to " + tileSet.MaxZoom.ToString(CultureInfo.InvariantCulture))" OnAction="BackToMaximumAsync">
                    Past zoom @tileSet.MaxZoom, the last the server renders. Tiles are enlarged.
                </MapChip>
            }
            <MapReadout PastMaximum="zoomLimit == ZoomLimit.PastMaximum" />
            @if (times.Count > 0 && !TimeBarDocked)
            {
                @TimeBarFragment(false)
            }
            @if (noPickToast)
            {
                <Toast Title="@ServeTileSetInfo.NoPickTitle" Detail="@ServeTileSetInfo.NoPickDetail" IconName="info" OnClose="() => noPickToast = false" />
            }
            @if (!isPhone && pickPoint is not null)
            {
                <PickCard>@PickBody</PickCard>
            }
        </main>
    </div>
</div>

@code {
    private static readonly RailItem[] datasetRailItems =
    [
        new(ServePanel.Datasets, "Datasets", "layers"),
        new(ServePanel.Display, "Display", "sliders"),
        new(ServePanel.UseInGis, "GIS", "plug"),
    ];

    // A built tile set has no datasets: its metadata is the first item (D35).
    private static readonly RailItem[] tileSetRailItems =
    [
        new(ServePanel.TileSet, "Tile set", "grid"),
        new(ServePanel.Display, "Display", "sliders"),
        new(ServePanel.UseInGis, "GIS", "plug"),
    ];

    private RailItem[] railItems = datasetRailItems;

    // A click on a built tile set's map says there's nothing to pick (D35).
    private bool noPickToast;
    private int noPickGeneration;

    private ServedTileSet tileSet = null!;
    private IReadOnlyList<DateTime> times = [];
    private string summary = "";
    private string? palette;
    private int timeIndex;
    private PageAppearance page;
    private IReadOnlyList<ServeLayerChoice> layerChoices = [];
    private string? layer;
    private Basemap basemap;
    private bool basemapFailed;

    private ServePanel? activePanel = ServePanel.Datasets;
    private SheetHeight sheet;
    private bool isPhone;
    private ZoomLimit zoomLimit;
    private bool linkCopied;

    // The hash's name=value pairs, kept as read (D36): later slices add theirs.
    private readonly Dictionary<string, string> hashParameters = new(StringComparer.Ordinal);

    // The Datasets panel (SW2): the selected dataset (dataset= in the hash) and the datasets with a place (D15).
    private string? selectedDataset;
    private IReadOnlyList<ServedDataset> servedDatasets = [];
    // Features at a point (#1581): the point, what the query found, and the card's state.
    private (double Latitude, double Longitude)? pickPoint;
    private PickReport? pick;
    private string? pickError;
    private int pickExpanded;
    private bool pickShowMinor;
    private double pickMetresPerPixel = 10;
    private CancellationTokenSource? pickQuery;
    private bool pickMoved;

    private DotNetObjectReference<ServePage>? self;
    private bool shown;

    private string Theme => ServeTheme.Resolve(palette, page);

    // Time (SW4, D19, D20): the browser's zone (UTC until the circuit reads it), Local or UTC,
    // whether the step was chosen (so t= is in the hash), and play.
    private ServeTimeZone browserZone = ServeTimeZone.Utc;
    private bool timesUtc;
    private bool timeChosen;
    private bool playing;
    private CancellationTokenSource? playCancellation;

    private ServeTimeZone Zone => timesUtc ? ServeTimeZone.Utc : browserZone;

    // On a phone the bar docks into the sheet's top when the sheet rises (E3).
    private bool TimeBarDocked => isPhone && sheet != SheetHeight.Lowered;

    private string LocalZone => browserZone.Describe(times.Count > 0 ? times[timeIndex] : DateTime.UtcNow);

    private RenderFragment TimeBarFragment(bool docked) =>
        @<TimeBar Times="times" Index="timeIndex" IndexChanged="SetTimeAsync" Zone="Zone" Utc="timesUtc" UtcChanged="SetTimesUtc"
                  Playing="playing" PlayingChanged="SetPlayingAsync" Docked="docked"
                  Context="ServeTimes.Context(servedDatasets, times, timeIndex, Zone)"
                  Notice="ServeTimes.Notice(times, timeIndex, DateTime.UtcNow, Zone)" />;

    protected override void OnInitialized()
    {
        tileSet = Data.TileSet;
        times = Data.Times;
        timeIndex = ServeTimes.StartIndex(times, DateTime.UtcNow, null);
        servedDatasets = Data.Datasets;
        palette = tileSet.DefaultPalette;
        summary = ServeSummary.Describe(Data);
        if (!Data.HasDatasets)
        {
            railItems = tileSetRailItems;
            activePanel = ServePanel.TileSet;
        }
        layerChoices = ServeDisplay.LayerChoices(Data.Datasets, Data.Layers);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            await AfterPickRenderAsync();
            return;
        }
        self = DotNetObjectReference.Create(this);
        var (view, parameters) = ServeHash.Parse(await JS.InvokeAsync<string>("s100Map.readHash"));
        foreach (var (name, value) in parameters)
            hashParameters[name] = value;
        ReadDisplayHash();
        ReadTimeHash();
        await ReadZoneAsync();

        servedDatasets = Data.Datasets;
        selectedDataset = DatasetFromHash();

        var start = view ?? await StartViewAsync();
        zoomLimit = ServeMapView.Limit(start.Zoom, tileSet.MinZoom, tileSet.MaxZoom);
        await JS.InvokeVoidAsync("s100Map.show", "map", new
        {
            tileJsonUrl = TileJsonUrl(),
            highDpi = tileSet.HighDpi,
            minZoom = tileSet.MinZoom,
            maxZoom = tileSet.MaxZoom,
            view = start,
            outlines = ServeOutlines.FeatureCollection(servedDatasets).ToJsonString(),
            hashParameters = ServeHash.FormatParameters(hashParameters),
            theme = Theme,
            // A built tile set's bounds stand in for coverage (D16), and a click has nothing to pick (D35).
            tileSetBounds = Data.HasDatasets ? null : tileSet.Bounds,
            noPick = !Data.HasDatasets,
            basemap = ServeDisplay.ScriptName(basemap),
        }, self);
        await JS.InvokeVoidAsync("s100Shell.watchPhone", self);
        shown = true;
        if (selectedDataset is not null)
        {
            activePanel = ServePanel.Datasets;
            await SetDatasetOutlinesAsync();
        }

        await ReadPickHashAsync();
        StateHasChanged();
    }

    private static string PanelTitle(ServePanel panel) => panel switch
    {
        ServePanel.Display => "Display",
        ServePanel.UseInGis => "Use in GIS",
        ServePanel.TileSet => "Tile set",
        _ => "Datasets",
    };

    /// <summary>The TileJSON of the layer, palette and time chosen, relative to the page.</summary>
    private string TileJsonUrl() =>
        ServeDisplay.TileJsonUrl(layer, palette, tileSet.DefaultPalette, times.Count > 0 ? TileRenderSession.FormatTime(times[timeIndex]) : null);

    /// <summary>The view framing the data in the map as it's sized now (D12).</summary>
    private async Task<MapView> StartViewAsync()
    {
        var size = await JS.InvokeAsync<double[]>("s100Map.size", "map");
        return ServeMapView.Start(tileSet, size[0], size[1]);
    }

    // Rail and sheet (D1, D2).

    private async Task SelectPanel(ServePanel panel)
    {
        if (isPhone && pickPoint is not null)
        {
            // A tab takes the sheet back from the pick.
            await ClearPickAsync();
            activePanel = panel;
        }
        else if (isPhone)
        {
            // A tab raises the sheet; the open tab lowers it again.
            if (activePanel == panel && sheet != SheetHeight.Lowered)
            {
                sheet = SheetHeight.Lowered;
            }
            else
            {
                activePanel = panel;
                if (sheet == SheetHeight.Lowered)
                    sheet = SheetHeight.Half;
            }
        }
        else
        {
            // The active item closes its panel; the rail stays.
            activePanel = activePanel == panel ? null : panel;
        }
    }

    private void OpenPanel(ServePanel panel)
    {
        activePanel = panel;
        if (sheet == SheetHeight.Lowered)
            sheet = SheetHeight.Half;
    }

    private void SheetGesture(string gesture)
    {
        sheet = (gesture, sheet) switch
        {
            ("up", SheetHeight.Lowered) => SheetHeight.Half,
            ("up", _) => SheetHeight.Full,
            ("down", SheetHeight.Full) => SheetHeight.Half,
            ("down", _) => SheetHeight.Lowered,
            (_, SheetHeight.Lowered) => SheetHeight.Half,
            _ => SheetHeight.Lowered,
        };
        if (sheet != SheetHeight.Lowered)
            activePanel ??= railItems[0].Panel;
    }

    /// <summary>From the JS module: the page crossed the phone width (768 px).</summary>
    [JSInvokable]
    public void OnPhoneChanged(bool phone)
    {
        isPhone = phone;
        if (phone && pickPoint is not null)
        {
            // A pick opens the sheet at half height with the marker in view (D22).
            if (sheet == SheetHeight.Lowered)
                sheet = SheetHeight.Half;
            pickMoved = true;
        }

        StateHasChanged();
    }

    // Map.

    /// <summary>From the JS module: the map stopped moving, at <paramref name="zoom"/> (the tile set's zoom).</summary>
    [JSInvokable]
    public void OnViewChanged(double zoom)
    {
        var limit = ServeMapView.Limit(zoom, tileSet.MinZoom, tileSet.MaxZoom);
        if (limit == zoomLimit)
            return;
        zoomLimit = limit;
        StateHasChanged();
    }

    /// <summary>From the JS module: the hash was edited. Its view moves the map; its parameters replace the page's.</summary>
    [JSInvokable]
    public async Task OnHashChanged(string hash)
    {
        var (view, parameters) = ServeHash.Parse(hash);
        hashParameters.Clear();
        foreach (var (name, value) in parameters)
            hashParameters[name] = value;
        var (oldPalette, oldLayer, oldTime) = (palette, layer, timeIndex);
        var oldPick = pickPoint;
        ReadDisplayHash();
        ReadTimeHash();
        await MapAsync("s100Map.setHashParameters", ServeHash.FormatParameters(hashParameters));
        if (timeIndex != oldTime)
        {
            await MapAsync("s100Map.setChart", TileJsonUrl());
            StateHasChanged();
        }

        if (palette != oldPalette || layer != oldLayer)
        {
            await MapAsync("s100Map.setChart", TileJsonUrl());
            await MapAsync("s100Map.setTheme", Theme);
            StateHasChanged();
        }

        if (view is { } v)
            await MapAsync("s100Map.jumpTo", v);
        if (DatasetFromHash() is var dataset && dataset != selectedDataset)
        {
            selectedDataset = dataset;
            if (dataset is not null)
                activePanel = ServePanel.Datasets;
            await SetDatasetOutlinesAsync();
            StateHasChanged();
        }
        await ReadPickHashAsync();

        // A new t= changes the coverage values at an unchanged pick.
        if (timeIndex != oldTime && pickPoint is not null && pickPoint == oldPick)
            await RepickAsync();
    }

    /// <summary>From the JS module: a click on a built tile set's map, which has nothing to pick (D35).</summary>
    [JSInvokable]
    public async Task OnNoPick()
    {
        noPickToast = true;
        var generation = ++noPickGeneration;
        StateHasChanged();
        await Task.Delay(TimeSpan.FromSeconds(4));
        if (generation != noPickGeneration)
            return;
        noPickToast = false;
        StateHasChanged();
    }

    private Task ZoomByAsync(int delta) => MapAsync("s100Map.zoomBy", delta);

    private async Task ZoomToDataAsync()
    {
        if (shown)
            await JS.InvokeVoidAsync("s100Map.flyTo", await StartViewAsync());
    }

    private Task BackToMaximumAsync() => MapAsync("s100Map.zoomTo", tileSet.MaxZoom);

    private Task NorthUpAsync() => MapAsync("s100Map.northUp");

    private async Task CopyLinkAsync()
    {
        if (!shown || !await JS.InvokeAsync<bool>("s100Map.copyLink"))
            return;
        linkCopied = true;
        StateHasChanged();
        await Task.Delay(TimeSpan.FromSeconds(2));
        linkCopied = false;
    }

    // Datasets (SW2, handoff D10, D15, D36).

    /// <summary>The hash's <c>dataset=</c>, when it names a dataset served.</summary>
    private string? DatasetFromHash() =>
        hashParameters.TryGetValue("dataset", out var id) && servedDatasets.Any(d => d.Id == id) ? id : null;

    private async Task SelectDatasetAsync(string? id)
    {
        selectedDataset = id;
        if (id is null)
            hashParameters.Remove("dataset");
        else
            hashParameters["dataset"] = id;
        if (id is not null && isPhone)
            sheet = SheetHeight.Full;
        await MapAsync("s100Map.setHashParameters", ServeHash.FormatParameters(hashParameters));
        await SetDatasetOutlinesAsync();
    }

    private string[]? datasetMatches;

    private Task SetDatasetMatchesAsync(string[]? ids)
    {
        datasetMatches = ids;
        return SetDatasetOutlinesAsync();
    }

    private Task SetDatasetOutlinesAsync() => MapAsync("s100Map.setDatasetOutlines", selectedDataset, datasetMatches);

    private async Task ZoomToDatasetAsync(string id)
    {
        if (!shown || servedDatasets.FirstOrDefault(d => d.Id == id) is not { Bounds: { Length: 4 } bounds })
            return;
        if (isPhone)
            sheet = SheetHeight.Half;
        var size = await JS.InvokeAsync<double[]>("s100Map.size", "map");
        await JS.InvokeVoidAsync("s100Map.flyTo", ServeMapView.Start(tileSet with { Bounds = bounds, Center = null }, size[0], size[1]));
    }

    private async Task<bool> CopyDatasetLinkAsync() => shown && await JS.InvokeAsync<bool>("s100Map.copyLink");

    private async Task<bool> CopyTextAsync(string text) => shown && await JS.InvokeAsync<bool>("s100Map.copyText", text);

    // Display (D17, D18, D36).

    /// <summary>The palette and layer from the hash, when they're ones served; the hash is rewritten to match.</summary>
    private void ReadDisplayHash()
    {
        if (Data.HasDatasets)
        {
            palette = ServeDisplay.PaletteFromHash(hashParameters, Data.Palettes) ?? tileSet.DefaultPalette;
            layer = ServeDisplay.LayerFromHash(hashParameters, Data.Layers);
        }

        ServeDisplay.WriteHash(hashParameters, palette, tileSet.DefaultPalette, layer);
    }

    private Task WriteDisplayHashAsync()
    {
        ServeDisplay.WriteHash(hashParameters, palette, tileSet.DefaultPalette, layer);
        return MapAsync("s100Map.setHashParameters", ServeHash.FormatParameters(hashParameters));
    }

    private async Task SetPaletteAsync(string? value)
    {
        palette = value;
        await MapAsync("s100Map.setChart", TileJsonUrl());
        await MapAsync("s100Map.setTheme", Theme);
        await WriteDisplayHashAsync();
    }

    private async Task SetLayerAsync(string? value)
    {
        layer = value;
        await MapAsync("s100Map.setChart", TileJsonUrl());
        await WriteDisplayHashAsync();
    }

    private Task SetBasemapAsync(Basemap value)
    {
        basemap = value;
        basemapFailed = false;
        return MapAsync("s100Map.setBasemap", ServeDisplay.ScriptName(value));
    }

    /// <summary>From the JS module: OpenStreetMap didn't load, so the map shows none (D17).</summary>
    [JSInvokable]
    public void OnBasemapFailed()
    {
        basemap = Basemap.None;
        basemapFailed = true;
        StateHasChanged();
    }

    // Time (SW4, D19, D20, D36).

    /// <summary>The step <c>t=</c> names (the nearest), else the default; the hash is rewritten to match.</summary>
    private void ReadTimeHash()
    {
        var time = ServeTimes.FromHash(hashParameters);
        timeChosen = time is not null && times.Count > 0;
        timeIndex = ServeTimes.StartIndex(times, DateTime.UtcNow, time);
        WriteTimeHash();
    }

    // t= once a step is chosen, so a link opens on it; until then the page follows now.
    private void WriteTimeHash()
    {
        if (timeChosen && times.Count > 0)
            hashParameters[ServeTimes.HashParameter] = ServeTimes.FormatHash(times[timeIndex]);
        else
            hashParameters.Remove(ServeTimes.HashParameter);
    }

    /// <summary>The browser's zone, its offset and abbreviation at each time the page shows (D20).</summary>
    private async Task ReadZoneAsync()
    {
        if (times.Count == 0)
            return;
        var now = DateTime.UtcNow;
        var instants = times
            .Concat(servedDatasets.Select(d => d.IssueTime).OfType<DateTime>())
            .Append(new DateTime(now.Ticks - now.Ticks % TimeSpan.TicksPerSecond, DateTimeKind.Utc))
            .Select(ServeTimeZone.AsUtc)
            .Distinct()
            .ToArray();
        try
        {
            var zone = await JS.InvokeAsync<BrowserZone>("s100Time.zone", (object)instants.Select(TileRenderSession.FormatTime).ToArray());
            if (zone.Offsets.Length == instants.Length && zone.Abbreviations.Length == instants.Length)
                browserZone = ServeTimeZone.FromBrowser(zone.Id, instants.Select((t, i) => new ServeZoneSample(t, TimeSpan.FromMinutes(zone.Offsets[i]), zone.Abbreviations[i])));
        }
        catch (JSException)
        {
            // An old browser: times stay in UTC.
        }
    }

    private async Task SetTimeAsync(int index)
    {
        if (times.Count == 0)
            return;
        timeIndex = Math.Clamp(index, 0, times.Count - 1);
        timeChosen = true;
        WriteTimeHash();
        await MapAsync("s100Map.setChart", TileJsonUrl());
        await MapAsync("s100Map.setHashParameters", ServeHash.FormatParameters(hashParameters));
        await RepickAsync();
    }

    private void SetTimesUtc(bool utc) => timesUtc = utc;

    /// <summary>Play advances a step a second and stops at the end; from the end it starts again at the first.</summary>
    private async Task SetPlayingAsync(bool play)
    {
        StopPlaying();
        if (!play || times.Count < 2)
            return;
        if (timeIndex >= times.Count - 1)
            await SetTimeAsync(0);
        playing = true;
        var cancellation = playCancellation = new CancellationTokenSource();
        _ = PlayAsync(cancellation.Token);
    }

    private async Task PlayAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (playing && await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    if (cancellationToken.IsCancellationRequested)
                        return;
                    if (timeIndex < times.Count - 1)
                        await SetTimeAsync(timeIndex + 1);
                    if (timeIndex >= times.Count - 1)
                        StopPlaying();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Paused, or the page closed.
        }
        catch (JSDisconnectedException)
        {
            // The tab is gone.
        }
    }

    private void StopPlaying()
    {
        playing = false;
        playCancellation?.Cancel();
        playCancellation?.Dispose();
        playCancellation = null;
    }

    /// <summary>What <c>s100Time.zone</c> returns.</summary>
    private sealed record BrowserZone(string Id, int[] Offsets, string[] Abbreviations);

    private Task SetPageAsync(PageAppearance value)
    {
        page = value;
        return MapAsync("s100Map.setTheme", Theme);
    }

    private async Task MapAsync(string identifier, params object?[] args)
    {
        if (shown)
            await JS.InvokeVoidAsync(identifier, args);
    }

    // Features at a point (#1581, D21–D24).

    private RenderFragment PickBody => __builder =>
    {
        <ObjectInformation Position="@ServePick.Position(pickPoint!.Value.Latitude, pickPoint.Value.Longitude)"
                           Report="pick" Error="@pickError" Expanded="pickExpanded" ShowMinor="pickShowMinor"
                           OnToggle="TogglePickFeatureAsync" OnShowMinor="() => pickShowMinor = true" OnClose="ClearPickAsync" />
    };

    /// <summary>From the JS module: a click on the map (not a drag) at a point, with the map's scale there.</summary>
    [JSInvokable]
    public async Task OnMapClick(double latitude, double longitude, double metresPerPixel)
    {
        if (!Data.HasDatasets)
            return;
        pickMetresPerPixel = metresPerPixel;
        await PickAsync(latitude, longitude, writeHash: true);
    }

    /// <summary>From the JS module: Esc clears the pick.</summary>
    [JSInvokable]
    public async Task OnPickEscape()
    {
        await ClearPickAsync();
        StateHasChanged();
    }

    private async Task PickAsync(double latitude, double longitude, bool writeHash)
    {
        pickQuery?.Cancel();
        var query = pickQuery = new CancellationTokenSource();
        pickPoint = (latitude, longitude);
        pick = null;
        pickError = null;
        pickExpanded = 0;
        pickShowMinor = false;
        pickMoved = true;
        if (isPhone && sheet == SheetHeight.Lowered)
            sheet = SheetHeight.Half;
        if (writeHash)
        {
            hashParameters["pick"] = ServePick.FormatHash(latitude, longitude);
            await MapAsync("s100Map.setHashParameters", ServeHash.FormatParameters(hashParameters));
        }

        await MapAsync("s100Pick.setPoint", latitude, longitude);
        StateHasChanged();

        try
        {
            var radius = Math.Clamp(pickMetresPerPixel * ServePick.RadiusPixels, 1, 5000);
            DateTime? time = times.Count > 0 ? times[timeIndex] : null;
            var result = await Data.QueryFeaturesAsync(latitude, longitude, radius, ServePick.MaxResults, time, query.Token);
            if (query.IsCancellationRequested)
                return;
            if (result is null)
            {
                pickError = "There's no feature information in a tile set.";
            }
            else
            {
                pick = ServePick.Report(result, Data.Datasets);
                pickExpanded = pick.Features.Count > 0 ? 0 : -1;
                await MapAsync("s100Pick.setFeatures", ServePick.Geometries(result).ToJsonString(), pickExpanded);
            }
        }
        catch (OperationCanceledException) when (query.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException)
        {
            pickError = "The datasets couldn't be queried: " + ex.Message;
        }

        StateHasChanged();
    }

    /// <summary>The time changed: the coverage values at the pick change with it.</summary>
    private async Task RepickAsync()
    {
        if (pickPoint is { } point)
            await PickAsync(point.Latitude, point.Longitude, writeHash: false);
    }

    private async Task ClearPickAsync()
    {
        if (pickPoint is null)
            return;
        pickQuery?.Cancel();
        pickPoint = null;
        pick = null;
        pickError = null;
        hashParameters.Remove("pick");
        await MapAsync("s100Map.setHashParameters", ServeHash.FormatParameters(hashParameters));
        await MapAsync("s100Pick.setPoint", null, null);
    }

    private async Task TogglePickFeatureAsync(int index)
    {
        pickExpanded = pickExpanded == index ? -1 : index;
        await MapAsync("s100Pick.setExpanded", pickExpanded);
    }

    /// <summary>The hash's <c>pick=</c>: picks there, or clears the pick when it's gone.</summary>
    private async Task ReadPickHashAsync()
    {
        var point = ServePick.ParseHash(hashParameters.GetValueOrDefault("pick"));
        if (point is { } p && Data.HasDatasets)
        {
            if (pickPoint is { } current && Math.Abs(current.Latitude - p.Latitude) < 1e-7 && Math.Abs(current.Longitude - p.Longitude) < 1e-7)
                return;
            pickMetresPerPixel = await JS.InvokeAsync<double>("s100Pick.metresPerPixel", p.Latitude);
            await PickAsync(p.Latitude, p.Longitude, writeHash: false);
        }
        else
        {
            hashParameters.Remove("pick");
            await ClearPickAsync();
        }
    }

    // After a render with the pick: place the card beside the marker, or on a
    // phone keep the marker above the sheet.
    private async Task AfterPickRenderAsync()
    {
        if (!shown || pickPoint is null)
            return;
        if (isPhone)
        {
            if (pickMoved)
                await JS.InvokeVoidAsync("s100Pick.keepInView");
        }
        else
        {
            await JS.InvokeVoidAsync("s100Pick.place", pickMoved && pick is not null);
        }

        if (pick is not null || pickError is not null)
            pickMoved = false;
    }

    public async ValueTask DisposeAsync()
    {
        StopPlaying();
        pickQuery?.Cancel();
        pickQuery?.Dispose();
        try
        {
            if (shown)
                await JS.InvokeVoidAsync("s100Map.dispose");
        }
        catch (JSDisconnectedException)
        {
            // The tab is gone, and the map with it.
        }

        self?.Dispose();
    }
}
