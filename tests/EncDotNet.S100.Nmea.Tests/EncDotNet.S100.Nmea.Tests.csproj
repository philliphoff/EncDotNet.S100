<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EncDotNet.S100.Nmea\EncDotNet.S100.Nmea.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hand-written NMEA recordings; see tests/datasets/NMEA/README.md. -->
    <Content Include="..\datasets\NMEA\*.nmea" CopyToOutputDirectory="PreserveNewest" Link="TestData\NMEA\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
