<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    Spike: a Blazor WebAssembly front end for `s100 tiles serve`.
    Two questions: can a richer page be built in C# over the serve API, and do
    the existing libraries (Core, Features, Datasets.S101) run in the browser?
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>EncDotNet.S100.WebApp</RootNamespace>
    <!-- Same rule as the libraries (issue #764): reflection the trimmer cannot follow is an error. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- Razor's generated code for Router/LayoutView sets [DynamicallyAccessedMembers]
         properties through reflection; the framework keeps them, so these are noise. -->
    <NoWarn>$(NoWarn);IL2110;IL2111</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EncDotNet.S100.Core\EncDotNet.S100.Core.csproj" />
    <ProjectReference Include="..\..\src\EncDotNet.S100.Datasets.S101\EncDotNet.S100.Datasets.S101.csproj" />
  </ItemGroup>

</Project>
