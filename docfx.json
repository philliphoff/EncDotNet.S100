{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/**/*.csproj"
          ],
          "exclude": [
            "src/EncDotNet.S100.AppHost/**",
            "src/EncDotNet.S100.Datasets.S129.Fusion/**",
            "src/EncDotNet.S100.Diagnostics.Export/**",
            "src/EncDotNet.S100.DynamicSources.Ais/**",
            "src/EncDotNet.S100.DynamicSources.Ais.Drivers.AisStreamIo/**",
            "src/EncDotNet.S100.Mcp/**",
            "src/EncDotNet.S100.Mcp.Tools/**",
            "src/EncDotNet.S100.Viewer/**"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "docs/**.md",
          "docs/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      },
      {
        "files": [
          "src/**/README.md",
          "src/toc.yml",
          "samples/**/README.md",
          "tools/*/README.md"
        ],
        "exclude": [
          "**/bin/**",
          "**/obj/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "docs/images/**",
          "readme/**",
          "src/*/images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "docs/template"
    ],
    "globalMetadata": {
      "_appLogoPath": "docs/images/logo.svg",
      "_appFaviconPath": "docs/images/logo.svg",
      "_appTitle": "EncDotNet.S100 Docs"
    }
  }
}
