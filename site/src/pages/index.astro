---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Products from '../components/Products.astro';
import Features from '../components/Features.astro';
import Palettes from '../components/Palettes.astro';
import Developers from '../components/Developers.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="SoundCharts: S-100 marine charts on your desktop"
  description="SoundCharts is a free, open-source viewer for IHO S-100 charts, depths, tides, currents and more, built on the EncDotNet.S100 .NET SDK."
>
  <Nav />
  <main id="top">
    <Hero />
    <Products />
    <Features />
    <Palettes />
    <Developers />
  </main>
  <Footer />
</Base>
