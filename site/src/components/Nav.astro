---
import iconSvg from '../../../src/EncDotNet.S100.Viewer/Branding/icon.svg?url';
import { docs, links, withBase } from '../data/content';
---
<header class="nav">
  <div class="wrap">
    <a class="brand" href={withBase('')} aria-label="SoundCharts home">
      <img src={iconSvg} alt="" width="30" height="30" />
      SoundCharts
    </a>
    <ul>
      <li><a href="#viewer">Viewer</a></li>
      <li><a href="#data">Data</a></li>
      <li><a href="#developers">Developers</a></li>
      <li><a href={withBase(docs.home)}>Docs</a></li>
    </ul>
    <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Theme: follow system">
      <svg class="auto" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="8"></circle><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path></svg>
      <svg class="light" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      <svg class="dark" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path></svg>
      <span id="theme-label">Auto</span>
    </button>
    <a class="gh" href={links.repo}>
      <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      GitHub
    </a>
  </div>
</header>

<script>
  // Theme toggle: Auto (follow the system) → Light → Dark. The choice is kept in
  // localStorage and applied before first paint by Base.astro; here it also
  // repoints the screenshots' dark sources (see Shot.astro), whose media query
  // can't see data-theme.
  type Mode = 'auto' | 'light' | 'dark';
  const modes: Mode[] = ['auto', 'light', 'dark'];
  const names = { auto: 'Auto', light: 'Light', dark: 'Dark' } as const;
  const system = '(prefers-color-scheme: dark)';
  const root = document.documentElement;
  const button = document.getElementById('theme-toggle');
  const label = document.getElementById('theme-label');

  function apply(mode: Mode) {
    if (mode === 'auto') delete root.dataset.theme;
    else root.dataset.theme = mode;
    document.querySelectorAll<HTMLSourceElement>('source[data-theme-dark]').forEach((source) => {
      source.media = mode === 'auto' ? system : mode === 'dark' ? 'all' : 'not all';
    });
    if (button && label) {
      button.dataset.mode = mode;
      label.textContent = names[mode];
      button.setAttribute('aria-label', mode === 'auto' ? 'Theme: follow system' : `Theme: ${names[mode]}`);
    }
  }

  const stored = root.dataset.theme;
  let mode: Mode = stored === 'light' || stored === 'dark' ? stored : 'auto';
  apply(mode);
  button?.addEventListener('click', () => {
    mode = modes[(modes.indexOf(mode) + 1) % modes.length];
    apply(mode);
    try {
      if (mode === 'auto') localStorage.removeItem('theme');
      else localStorage.setItem('theme', mode);
    } catch {}
  });
</script>
