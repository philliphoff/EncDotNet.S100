        "model": "gfswave",
        "modelName": "GFS-Wave",
        "dataRoot": "https://nomads.ncep.noaa.gov/pub/data/nccf/com/gfs/prod/",
        "file": "gfs.{date}/{cycle}/wave/gridded/gfswave.t{cycle}z.global.0p25.f{hour}.grib2",
        "cadenceHours": 6,
        "stepHours": 3,
        "maxHours": 120,
        "defaultHours": 48,
        "gridDegrees": 0.25,
        "parameters": [
          { "id": "HTSGW", "name": "Significant wave height", "level": "surface", "default": true },
          { "id": "PERPW", "name": "Peak wave period", "level": "surface", "default": true },
          { "id": "DIRPW", "name": "Peak wave direction", "level": "surface", "default": true },
          { "id": "WVHGT", "name": "Wind-sea height", "level": "surface" },
          { "id": "WVDIR", "name": "Wind-sea direction", "level": "surface" },
          { "id": "UGRD", "name": "Wind, east component", "level": "surface", "default": true },
          { "id": "VGRD", "name": "Wind, north component", "level": "surface", "default": true }
        ]
      }
    },
