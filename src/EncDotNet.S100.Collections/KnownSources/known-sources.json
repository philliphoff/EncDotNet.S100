    {
      "id": "noaa-nomads-gfswave",
      "name": "GFS-Wave wave forecast — NOMADS GRIB filter",
      "provider": "NOAA National Centers for Environmental Prediction",
      "region": ["Worldwide"],
      "format": "weather",
      "catalogUri": "https://nomads.ncep.noaa.gov/cgi-bin/filter_gfswave.pl",
      "homepage": "https://nomads.ncep.noaa.gov/",
      "coverage": "boundingBoxes",
      "editions": false,
      "sizes": false,
      "note": "WAVEWATCH III wave height, period and direction at 0.25°, cut to the map view. The model runs every 6 hours; each refresh lists its latest run, downloaded as one GRIB2 file. Choose parameters and forecast days next.",
      "product": "GRIB2",
      "notForNavigation": true,
      "licence": "Public domain",
      "attribution": "NOAA/NCEP GFS-Wave (WAVEWATCH III)",
      "weather": {
        "service": "gribFilter",
        "model": "gfswave",
        "modelName": "GFS-Wave",
        "dataRoot": "https://nomads.ncep.noaa.gov/pub/data/nccf/com/gfs/prod/",
        "file": "gfs.{date}/{cycle}/wave/gridded/gfswave.t{cycle}z.global.0p25.f{hour}.grib2",
        "cadenceHours": 6,
        "stepHours": 3,
        "maxHours": 120,
        "defaultHours": 48,
        "gridDegrees": 0.25,
        "parameters": [
          { "id": "HTSGW", "name": "Significant wave height", "level": "surface", "default": true },
          { "id": "PERPW", "name": "Peak wave period", "level": "surface", "default": true },
          { "id": "DIRPW", "name": "Peak wave direction", "level": "surface", "default": true },
          { "id": "WVHGT", "name": "Wind-sea height", "level": "surface" },
          { "id": "WVDIR", "name": "Wind-sea direction", "level": "surface" },
          { "id": "UGRD", "name": "Wind, east component", "level": "surface", "default": true },
          { "id": "VGRD", "name": "Wind, north component", "level": "surface", "default": true }
        ]
      }
    },
