    {
      "id": "noaa-nomads-gfswave",
      "name": "GFS-Wave wave forecast — NOMADS GRIB filter",
      "provider": "NOAA National Centers for Environmental Prediction",
      "region": ["Worldwide"],
      "format": "weather",
      "catalogUri": "https://nomads.ncep.noaa.gov/cgi-bin/filter_gfswave.pl",
