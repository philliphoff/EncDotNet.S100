<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <Version>0.0.0-dev</Version>
    <Authors>Phillip Hoff</Authors>
    <Description>Libraries for manipulating S-100 based nautical charts.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://soundcharts.app/docs/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/philliphoff/EncDotNet.S100</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Ship XML documentation in every package so consumers get IntelliSense,
         and fail the build (via TreatWarningsAsErrors) on missing (CS1591) or
         malformed doc comments. Non-packable projects opt out explicitly with
         <GenerateDocumentationFile>false</GenerateDocumentationFile>; packages
         still being documented carry a temporary NoWarn for 1591 (issue #656).
         Set here rather than conditioned on IsPackable because the SDK resolves
         GenerateDocumentationFile before Directory.Build.targets is imported. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Publish a .snupkg symbol package beside each .nupkg so consumers can
         step into library source (via the SDK's built-in Source Link) from the
         NuGet.org symbol server (issue #1361). `dotnet nuget push *.nupkg`
         pushes the matching .snupkg automatically. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Deterministic CI builds: normalise source paths in PDBs so the published
       symbols do not embed build-agent paths and Source Link maps cleanly. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Libraries are trimmable (issue #764): the trim analyzers run in every
       build and, with TreatWarningsAsErrors, keep reflection that cannot be
       statically analysed out of them. The applications (viewer, app host)
       are not libraries; MoonSharp's Lua interop needs reflection by design. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'EncDotNet.S100.Viewer'
                            And '$(MSBuildProjectName)' != 'EncDotNet.S100.AppHost'
                            And '$(MSBuildProjectName)' != 'EncDotNet.S100.Scripting.MoonSharp'">
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

</Project>
