<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <Version>0.0.0-dev</Version>
    <Authors>Phillip Hoff</Authors>
    <Description>Libraries for manipulating S-100 based nautical charts.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://soundcharts.app/docs/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/philliphoff/EncDotNet.S100</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Ship XML documentation in every package so consumers get IntelliSense,
         and fail the build (via TreatWarningsAsErrors) on missing (CS1591) or
         malformed doc comments. Non-packable projects opt out explicitly with
         <GenerateDocumentationFile>false</GenerateDocumentationFile>; packages
         still being documented carry a temporary NoWarn for 1591 (issue #656).
         Set here rather than conditioned on IsPackable because the SDK resolves
         GenerateDocumentationFile before Directory.Build.targets is imported. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Libraries are trimmable (issue #764): the trim analyzers run in every
       build and, with TreatWarningsAsErrors, keep reflection that cannot be
       statically analysed out of them. Analysed on the net10.0 target only:
       the same sources build for net8.0, and IsTrimmable there would pull in
       the net8.0 ILLink pack. The applications (viewer, app host) are not
       libraries; MoonSharp's Lua interop needs reflection by design. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'
                            And '$(MSBuildProjectName)' != 'EncDotNet.S100.Viewer'
                            And '$(MSBuildProjectName)' != 'EncDotNet.S100.AppHost'
                            And '$(MSBuildProjectName)' != 'EncDotNet.S100.Scripting.MoonSharp'">
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
