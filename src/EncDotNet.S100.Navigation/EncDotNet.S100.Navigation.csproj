  <ItemGroup>
    <InternalsVisibleTo Include="EncDotNet.S100.Navigation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EncDotNet.S100.Core\EncDotNet.S100.Core.csproj" />
  </ItemGroup>

</Project>
