<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EncDotNet.S100.Viewer.ViewModels"
             xmlns:lib="using:EncDotNet.S100.Viewer.Library"
             xmlns:loc="using:EncDotNet.S100.Viewer.Resources"
             x:Class="EncDotNet.S100.Viewer.Views.AddToLibraryDialogView"
             x:DataType="vm:AddToLibraryDialogViewModel"
             MinWidth="440">

    <UserControl.Resources>
        <DataTemplate x:Key="FacetTemplate" x:DataType="vm:FacetOptionViewModel">
            <CheckBox IsChecked="{Binding IsSelected}" Margin="2,1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Label}" />
                    <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </CheckBox>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20,12,20,16">

        <!-- Header (the dialog host supplies the close button). -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,24,12">
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SourceDescription}" FontSize="12" Opacity="0.7"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourceDescription}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="14">

            <!-- NOAA: what to include -->
            <StackPanel IsVisible="{Binding IsNoaaFeed}" Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Library_NoaaChooseScope}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static loc:Strings.Library_NoaaLoading}" Opacity="0.7"
                           IsVisible="{Binding IsLoading}" />
                <TextBlock Text="{Binding LoadError}" Foreground="#c0504d" TextWrapping="Wrap"
                           IsVisible="{Binding HasLoadError}" />
                <TabControl IsVisible="{Binding !IsLoading}" Height="260">
                    <TabItem Header="{x:Static loc:Strings.Library_NoaaStates}">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding States}" ItemTemplate="{StaticResource FacetTemplate}" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{x:Static loc:Strings.Library_NoaaDistricts}">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding CoastGuardDistricts}" ItemTemplate="{StaticResource FacetTemplate}" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{x:Static loc:Strings.Library_NoaaRegions}">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Regions}" ItemTemplate="{StaticResource FacetTemplate}" />
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsLoading}">
                    <TextBlock Grid.Column="0" Text="{Binding SelectionSummary}" Opacity="0.8" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="Ghost" Content="{x:Static loc:Strings.Library_NoaaClearSelection}"
                            Command="{Binding SelectNoneCommand}" />
                </Grid>
            </StackPanel>

            <!-- Target collection -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Library_AddTo}" FontWeight="SemiBold" />
                <RadioButton GroupName="Target" IsChecked="{Binding CreateNew}"
                             Content="{x:Static loc:Strings.Library_NewCollection}" />
                <TextBox Text="{Binding NewCollectionName}" Margin="26,0,0,0"
                         IsEnabled="{Binding CreateNew}"
                         Watermark="{x:Static loc:Strings.Library_CollectionNameWatermark}" />
                <RadioButton GroupName="Target" IsChecked="{Binding AddToExisting}"
                             IsEnabled="{Binding HasExistingCollections}"
                             Content="{x:Static loc:Strings.Library_ExistingCollection}" />
                <ComboBox ItemsSource="{Binding ExistingCollections}"
                          SelectedItem="{Binding SelectedCollection}"
                          IsEnabled="{Binding AddToExisting}"
                          HorizontalAlignment="Stretch" Margin="26,0,0,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="lib:LibraryCollection">
                            <TextBlock Text="{Binding Definition.Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <TextBlock Text="{x:Static loc:Strings.Library_AddNote}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Classes="Outline" Content="{x:Static loc:Strings.Button_Cancel}" Command="{Binding CancelCommand}" />
            <Button Classes="Primary" Content="{x:Static loc:Strings.Button_AddToLibrary}" Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </Grid>

</UserControl>
