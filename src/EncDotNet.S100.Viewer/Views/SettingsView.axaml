<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EncDotNet.S100.Viewer.ViewModels"
             xmlns:keys="using:EncDotNet.S100.Viewer.ViewModels.Keys"
             xmlns:loc="using:EncDotNet.S100.Viewer.Resources"
             xmlns:settings="using:EncDotNet.S100.Viewer.Views.Settings"
             x:Class="EncDotNet.S100.Viewer.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <!--
      The Settings panel (#845): a category list on the left and the selected
      category's page on the right. The panel fills the content area (see
      IActivityTab.FillsContent), so pages get a readable column instead of
      the side dock's 320 px. Each page lives in Views/Settings and keeps the
      Settings.* automation ids of its controls; a page's controls are in the
      visual tree only while its category is selected.
    -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:GeneralSettingsPageViewModel">
            <settings:GeneralSettingsPage />
        </DataTemplate>
        <DataTemplate DataType="vm:AppearanceSettingsPageViewModel">
            <settings:AppearanceSettingsPage />
        </DataTemplate>
        <DataTemplate DataType="vm:ChartSettingsPageViewModel">
            <settings:ChartSettingsPage />
        </DataTemplate>
        <DataTemplate DataType="vm:VesselsSettingsPageViewModel">
            <settings:VesselsSettingsPage />
        </DataTemplate>
        <DataTemplate DataType="vm:IntegrationsSettingsPageViewModel">
            <settings:IntegrationsSettingsPage />
        </DataTemplate>
        <DataTemplate DataType="keys:KeysAndCertificatesViewModel">
            <settings:KeysAndCertificatesSettingsPage />
        </DataTemplate>
        <DataTemplate DataType="vm:AdvancedSettingsPageViewModel">
            <settings:AdvancedSettingsPage />
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <!-- Category list: a vertical strip of tabs beside the selected page. -->
        <Style Selector="TabControl.settingsNav">
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Spacing="2" />
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="200,*">
                        <Border Grid.Column="0"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="0,0,1,0"
                                Padding="8,12">
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Name="PART_SelectedContentHost"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabControl.settingsNav > TabItem" x:DataType="vm:ISettingsPage">
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding StatusText}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="PART_Tint"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="6"
                                Opacity="0" />
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Padding="10,7" />
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabControl.settingsNav > TabItem:pointerover /template/ Border#PART_Tint">
            <Setter Property="Opacity" Value="0.06" />
        </Style>
        <Style Selector="TabControl.settingsNav > TabItem:selected /template/ Border#PART_Tint">
            <Setter Property="Opacity" Value="0.12" />
        </Style>
        <Style Selector="TabControl.settingsNav > TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="TextBlock.settingsNavStatus">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.settingsNavStatus.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
        </Style>
        <Style Selector="TextBlock.settingsNavStatus.destructive">
            <Setter Property="Foreground" Value="{DynamicResource DestructiveColor}" />
        </Style>

        <!-- Page layout shared by Views/Settings/*SettingsPage. -->
        <Style Selector="StackPanel.settingsPage">
            <Setter Property="Spacing" Value="16" />
            <Setter Property="Margin" Value="28,20,28,28" />
            <Setter Property="MaxWidth" Value="720" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="TextBlock.settingsPageTitle">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.settingsPageHelp">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.settingsSection">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="TextBlock.settingsHelp">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <!--
      The pages are the view model's Pages (ISettingsPage, in their order); each
      page's view comes from the data templates above, and its entry in the
      category list takes its automation id and name from the page.
    -->
    <TabControl Classes="settingsNav"
                AutomationProperties.AutomationId="Settings.Categories"
                AutomationProperties.Name="{x:Static loc:Strings.Label_SettingsCategories}"
                ItemsSource="{Binding Pages}"
                SelectedItem="{Binding SelectedPage}">
        <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ISettingsPage">
                <ContentControl Content="{Binding}">
                    <ContentControl.DataTemplates>
                        <!-- The status line under the label is the Settings warning for an
                             identity that ends within 30 days or was revoked (#845 A2). -->
                        <DataTemplate DataType="keys:KeysAndCertificatesViewModel">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Title}" />
                                <TextBlock Classes="settingsNavStatus"
                                           Classes.destructive="{Binding StatusIsDestructive}"
                                           Classes.warning="{Binding StatusIsWarning}"
                                           Text="{Binding StatusText}"
                                           IsVisible="{Binding HasStatus}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="vm:ISettingsPage">
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </DataTemplate>
        </TabControl.ItemTemplate>
    </TabControl>
</UserControl>
