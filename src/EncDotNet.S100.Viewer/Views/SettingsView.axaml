<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EncDotNet.S100.Viewer.ViewModels"
             xmlns:viewer="using:EncDotNet.S100.Viewer"
             xmlns:loc="using:EncDotNet.S100.Viewer.Resources"
             x:Class="EncDotNet.S100.Viewer.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                   VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12" Spacing="16">
            <TextBlock Text="{x:Static loc:Strings.Settings_Heading}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Opacity="0.7" />

            <!-- Accent Color -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_AccentColor}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <ColorPicker Color="{Binding AccentColor}"
                             IsAlphaVisible="False"
                             HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Chrome Theme -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_ChromeTheme}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Static loc:Strings.Settings_ChromeTheme_Help}"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding AvailableChromeThemes}"
                          AutomationProperties.AutomationId="Settings.ChromeTheme"
                          AutomationProperties.Name="{x:Static loc:Strings.Settings_ChromeTheme}"
                          SelectedItem="{Binding SelectedChromeTheme}"
                          ToolTip.Tip="{x:Static loc:Strings.Settings_ChromeTheme_Help}"
                          MinWidth="140"
                          HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static viewer:ChromeThemeNameConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Color Profile -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_ColorProfile}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Static loc:Strings.Settings_ColorProfile_Help}"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding AvailablePalettes}"
                          AutomationProperties.AutomationId="Settings.Palette"
                          AutomationProperties.Name="{x:Static loc:Strings.Settings_ColorProfile}"
                          SelectedItem="{Binding SelectedPalette}"
                          ToolTip.Tip="{x:Static loc:Strings.Settings_ColorProfile_Help}"
                          MinWidth="140"
                          HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static viewer:PaletteTypeNameConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Symbol Scale -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_SymbolScale}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Static loc:Strings.Settings_SymbolScale_Help}"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto">
                    <Slider Grid.Column="0"
                            AutomationProperties.AutomationId="Settings.SymbolScale"
                            AutomationProperties.Name="{x:Static loc:Strings.Settings_SymbolScale}"
                            Minimum="0.5"
                            Maximum="3.0"
                            TickFrequency="0.1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding SymbolScale}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding SymbolScale, StringFormat={}{0:F1}x}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               MinWidth="36" />
                </Grid>
            </StackPanel>

            <!-- Text Scale -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_TextScale}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Static loc:Strings.Settings_TextScale_Help}"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto">
                    <Slider Grid.Column="0"
                            AutomationProperties.AutomationId="Settings.TextScale"
                            AutomationProperties.Name="{x:Static loc:Strings.Settings_TextScale}"
                            Minimum="0.5"
                            Maximum="3.0"
                            TickFrequency="0.1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding TextScale}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding TextScale, StringFormat={}{0:F1}x}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               MinWidth="36" />
                </Grid>
            </StackPanel>

            <!-- Distance Unit -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_DistanceUnits}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Static loc:Strings.Settings_DistanceUnits_Help}"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding AvailableDistanceUnits}"
                          AutomationProperties.AutomationId="Settings.DistanceUnit"
                          AutomationProperties.Name="{x:Static loc:Strings.Settings_DistanceUnits}"
                          SelectedItem="{Binding DistanceUnit}"
                          MinWidth="180"
                          HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="viewer:DistanceUnit">
                            <TextBlock Text="{Binding Converter={x:Static viewer:DistanceUnitNameConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Time Format -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_TimeFormat_Label}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Static loc:Strings.Settings_TimeFormat_Tooltip}"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding AvailableTimeFormats}"
                          AutomationProperties.AutomationId="Settings.TimeFormat"
                          AutomationProperties.Name="{x:Static loc:Strings.Settings_TimeFormat_Label}"
                          SelectedItem="{Binding SelectedTimeFormat}"
                          ToolTip.Tip="{x:Static loc:Strings.Settings_TimeFormat_Tooltip}"
                          MinWidth="180"
                          HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="viewer:TimeFormat">
                            <TextBlock Text="{Binding Converter={x:Static viewer:TimeFormatNameConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Map (issue #295) -->
            <Separator Margin="0,8,0,0" />
            <TextBlock Text="{x:Static loc:Strings.Settings_MapSection}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Opacity="0.7" />
            <TextBlock Text="{x:Static loc:Strings.Settings_MapSection_Help}"
                       FontSize="11"
                       Opacity="0.6"
                       TextWrapping="Wrap" />
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto"
                  ToolTip.Tip="{x:Static loc:Strings.Tooltip_BasemapEnabled}">
                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_BasemapEnabled}" />
                <ComboBox Grid.Column="1" Classes="setting"
                          AutomationProperties.AutomationId="Settings.BasemapMode"
                          AutomationProperties.Name="{x:Static loc:Strings.Settings_BasemapEnabled}"
                          ItemsSource="{Binding AvailableBasemapModes}"
                          SelectedItem="{Binding SelectedBasemapMode}"
                          MinWidth="160">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static viewer:BasemapModeNameConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <Grid Classes="settingRow" ColumnDefinitions="*,Auto"
                  ToolTip.Tip="{x:Static loc:Strings.Tooltip_ShowOutOfScaleExtentIndicators}">
                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_ShowOutOfScaleExtentIndicators}" />
                <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding ShowOutOfScaleExtentIndicators}"  AutomationProperties.AutomationId="Settings.ShowOutOfScaleExtentIndicators" AutomationProperties.Name="{x:Static loc:Strings.Settings_ShowOutOfScaleExtentIndicators}"/>
            </Grid>

            <Grid Classes="settingRow" ColumnDefinitions="*,Auto"
                  ToolTip.Tip="{x:Static loc:Strings.Tooltip_ShowOverscaleIndication}">
                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_ShowOverscaleIndication}" />
                <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding ShowOverscaleIndication}"  AutomationProperties.AutomationId="Settings.ShowOverscaleIndication" AutomationProperties.Name="{x:Static loc:Strings.Settings_ShowOverscaleIndication}"/>
            </Grid>

            <!-- Base-plane tiled-renderer knobs (issue #331) -->
            <TextBlock Text="{x:Static loc:Strings.Settings_RenderSubsystemSubsection}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,8,0,0" />
            <TextBlock Text="{x:Static loc:Strings.Settings_RenderSubsystemSubsection_Help}"
                       FontSize="11"
                       Opacity="0.6"
                       TextWrapping="Wrap" />

            <!-- Tiled scene knobs -->
            <StackPanel Spacing="12"
                        Margin="16,0,0,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Static loc:Strings.Settings_SceneMode}"
                               FontSize="12" />
                    <ComboBox ItemsSource="{Binding AvailableSceneModes}"
                              AutomationProperties.AutomationId="Settings.SceneMode"
                              AutomationProperties.Name="{x:Static loc:Strings.Settings_SceneMode}"
                              SelectedItem="{Binding SelectedSceneMode}"
                              IsEnabled="{Binding SceneModeEditable}"
                              ToolTip.Tip="{x:Static loc:Strings.Tooltip_SceneMode}"
                              MinWidth="160"
                              HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static viewer:VectorSceneModeNameConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Tile-specific knobs — shown only in tiled scene mode -->
                <StackPanel Spacing="12" IsVisible="{Binding TiledModeActive}">
                    <StackPanel Spacing="6"
                                IsEnabled="{Binding PerformanceProfileEditable}"
                                ToolTip.Tip="{x:Static loc:Strings.Tooltip_PerformanceProfile}">
                        <TextBlock Text="{x:Static loc:Strings.Settings_PerformanceProfile}" FontSize="12" />
                        <ComboBox ItemsSource="{Binding PerformanceProfiles}"
                                  AutomationProperties.AutomationId="Settings.PerformanceProfile"
                                  AutomationProperties.Name="{x:Static loc:Strings.Settings_PerformanceProfile}"
                                  SelectedItem="{Binding SelectedPerformanceProfile}"
                                  MinWidth="160" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding ResolvedProfileLabel}" FontSize="11" Opacity="0.6" />
                    </StackPanel>

                    <Grid Classes="settingRow" ColumnDefinitions="*,Auto"
                          IsEnabled="{Binding TilePredictionEditable}"
                          ToolTip.Tip="{x:Static loc:Strings.Tooltip_TilePredictionEnabled}">
                        <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_TilePredictionEnabled}" />
                        <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding TilePredictionEnabled}"  AutomationProperties.AutomationId="Settings.TilePredictionEnabled" AutomationProperties.Name="{x:Static loc:Strings.Settings_TilePredictionEnabled}"/>
                    </Grid>

                    <Grid Classes="settingRow" ColumnDefinitions="*,Auto"
                          IsEnabled="{Binding TileCrossBandPrewarmEditable}"
                          ToolTip.Tip="{x:Static loc:Strings.Tooltip_TileCrossBandPrewarmEnabled}">
                        <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_TileCrossBandPrewarmEnabled}" />
                        <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding TileCrossBandPrewarmEnabled}"  AutomationProperties.AutomationId="Settings.TileCrossBandPrewarmEnabled" AutomationProperties.Name="{x:Static loc:Strings.Settings_TileCrossBandPrewarmEnabled}"/>
                    </Grid>

                    <Grid Classes="settingRow" ColumnDefinitions="*,Auto"
                          IsEnabled="{Binding TileMetatileEditable}"
                          ToolTip.Tip="{x:Static loc:Strings.Tooltip_TileMetatileEnabled}">
                        <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_TileMetatileEnabled}" />
                        <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding TileMetatileEnabled}"  AutomationProperties.AutomationId="Settings.TileMetatileEnabled" AutomationProperties.Name="{x:Static loc:Strings.Settings_TileMetatileEnabled}"/>
                    </Grid>

                    <Grid Classes="settingRow" ColumnDefinitions="*,Auto"
                          IsEnabled="{Binding TileGpuResidencyEditable}"
                          ToolTip.Tip="{x:Static loc:Strings.Tooltip_TileGpuResidencyEnabled}">
                        <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_TileGpuResidencyEnabled}" />
                        <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding TileGpuResidencyEnabled}"  AutomationProperties.AutomationId="Settings.TileGpuResidencyEnabled" AutomationProperties.Name="{x:Static loc:Strings.Settings_TileGpuResidencyEnabled}"/>
                    </Grid>

                    <Grid Classes="settingRow" ColumnDefinitions="*,Auto"
                          IsEnabled="{Binding TileDiskCacheEditable}"
                          ToolTip.Tip="{x:Static loc:Strings.Tooltip_TileDiskCacheEnabled}">
                        <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_TileDiskCacheEnabled}" />
                        <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding TileDiskCacheEnabled}"  AutomationProperties.AutomationId="Settings.TileDiskCacheEnabled" AutomationProperties.Name="{x:Static loc:Strings.Settings_TileDiskCacheEnabled}"/>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Static loc:Strings.Settings_TileGutterDip}"
                                   FontSize="12" />
                        <NumericUpDown Value="{Binding TileGutterDip}"
                                       AutomationProperties.AutomationId="Settings.TileGutterDip"
                                       AutomationProperties.Name="{x:Static loc:Strings.Settings_TileGutterDip}"
                                       Minimum="0"
                                       Maximum="256"
                                       Increment="8"
                                       FormatString="0.#"
                                       IsEnabled="{Binding TileGutterDipEditable}"
                                       ToolTip.Tip="{x:Static loc:Strings.Tooltip_TileGutterDip}"
                                       MinWidth="140"
                                       HorizontalAlignment="Left" />
                        <TextBlock Text="{x:Static loc:Strings.Settings_TileBudgetMb}"
                                   FontSize="12" />
                        <NumericUpDown Value="{Binding TileBudgetMb}"
                                       AutomationProperties.AutomationId="Settings.TileBudgetMb"
                                       AutomationProperties.Name="{x:Static loc:Strings.Settings_TileBudgetMb}"
                                       Minimum="4"
                                       Maximum="4096"
                                       Increment="32"
                                       FormatString="0"
                                       IsEnabled="{Binding TileBudgetMbEditable}"
                                       ToolTip.Tip="{x:Static loc:Strings.Tooltip_TileBudgetMb}"
                                       MinWidth="140"
                                       HorizontalAlignment="Left" />
                        <TextBlock Text="{x:Static loc:Strings.Settings_TileDiskMb}"
                                   FontSize="12" />
                        <NumericUpDown Value="{Binding TileDiskMb}"
                                       AutomationProperties.AutomationId="Settings.TileDiskMb"
                                       AutomationProperties.Name="{x:Static loc:Strings.Settings_TileDiskMb}"
                                       Minimum="16"
                                       Maximum="8192"
                                       Increment="64"
                                       FormatString="0"
                                       IsEnabled="{Binding TileDiskMbEditable}"
                                       ToolTip.Tip="{x:Static loc:Strings.Tooltip_TileDiskMb}"
                                       MinWidth="140"
                                       HorizontalAlignment="Left" />
                        <TextBlock Text="{x:Static loc:Strings.Settings_TileGpuBudgetMb}"
                                   FontSize="12" />
                        <NumericUpDown Value="{Binding TileGpuBudgetMb}"
                                       AutomationProperties.AutomationId="Settings.TileGpuBudgetMb"
                                       AutomationProperties.Name="{x:Static loc:Strings.Settings_TileGpuBudgetMb}"
                                       Minimum="4"
                                       Maximum="4096"
                                       Increment="32"
                                       FormatString="0"
                                       IsEnabled="{Binding TileGpuBudgetMbEditable}"
                                       ToolTip.Tip="{x:Static loc:Strings.Tooltip_TileGpuBudgetMb}"
                                       MinWidth="140"
                                       HorizontalAlignment="Left" />
                        <TextBlock Text="{x:Static loc:Strings.Settings_TileWorkerCount}"
                                   FontSize="12" />
                        <NumericUpDown Value="{Binding TileWorkerCount}"
                                       AutomationProperties.AutomationId="Settings.TileWorkerCount"
                                       AutomationProperties.Name="{x:Static loc:Strings.Settings_TileWorkerCount}"
                                       Minimum="1"
                                       Maximum="8"
                                       Increment="1"
                                       FormatString="0"
                                       IsEnabled="{Binding TileWorkerCountEditable}"
                                       ToolTip.Tip="{x:Static loc:Strings.Tooltip_TileWorkerCount}"
                                       MinWidth="140"
                                       HorizontalAlignment="Left" />
                        <TextBlock Text="{x:Static loc:Strings.Settings_RenderKnob_RestartHint}"
                                   FontSize="11"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Mariner Settings (S-100 Part 9 §4.2) -->
            <Separator Margin="0,8,0,0" />
            <TextBlock Text="{x:Static loc:Strings.Settings_MarinerSection}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Opacity="0.7" />
            <TextBlock Text="{x:Static loc:Strings.Settings_MarinerSection_Help}"
                       FontSize="11"
                       Opacity="0.6"
                       TextWrapping="Wrap" />

            <!-- Depth Unit -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_DepthUnit}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Static loc:Strings.Settings_DepthUnit_Help}"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding AvailableDepthUnits}"
                          AutomationProperties.AutomationId="Settings.DepthUnit"
                          AutomationProperties.Name="{x:Static loc:Strings.Settings_DepthUnit}"
                          SelectedItem="{Binding SelectedDepthUnit}"
                          ToolTip.Tip="{x:Static loc:Strings.Settings_DepthUnit_Help}"
                          MinWidth="180"
                          HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static viewer:DepthUnitNameConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Safety Contour -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_SafetyContour}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBox Text="{Binding SafetyContourDisplay, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         AutomationProperties.AutomationId="Settings.SafetyContour"
                         AutomationProperties.Name="{x:Static loc:Strings.Settings_SafetyContour}"
                         ToolTip.Tip="{x:Static loc:Strings.Tooltip_SafetyContour}"
                         MinWidth="120"
                         HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Safety Depth -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_SafetyDepth}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBox Text="{Binding SafetyDepthDisplay, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         AutomationProperties.AutomationId="Settings.SafetyDepth"
                         AutomationProperties.Name="{x:Static loc:Strings.Settings_SafetyDepth}"
                         ToolTip.Tip="{x:Static loc:Strings.Tooltip_SafetyDepth}"
                         MinWidth="120"
                         HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Shallow Contour -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_ShallowContour}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBox Text="{Binding ShallowContourDisplay, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         AutomationProperties.AutomationId="Settings.ShallowContour"
                         AutomationProperties.Name="{x:Static loc:Strings.Settings_ShallowContour}"
                         ToolTip.Tip="{x:Static loc:Strings.Tooltip_ShallowContour}"
                         MinWidth="120"
                         HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Deep Contour -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_DeepContour}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBox Text="{Binding DeepContourDisplay, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         AutomationProperties.AutomationId="Settings.DeepContour"
                         AutomationProperties.Name="{x:Static loc:Strings.Settings_DeepContour}"
                         ToolTip.Tip="{x:Static loc:Strings.Tooltip_DeepContour}"
                         MinWidth="120"
                         HorizontalAlignment="Left" />
            </StackPanel>

            <!-- S-101 toggles -->
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto"
                  ToolTip.Tip="{x:Static loc:Strings.Tooltip_FourShades}">
                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_FourShades}" />
                <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding FourShades}"  AutomationProperties.AutomationId="Settings.FourShades" AutomationProperties.Name="{x:Static loc:Strings.Settings_FourShades}"/>
            </Grid>
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto"
                  ToolTip.Tip="{x:Static loc:Strings.Tooltip_ShallowWaterDangers}">
                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_ShallowWaterDangers}" />
                <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding ShallowWaterDangers}"  AutomationProperties.AutomationId="Settings.ShallowWaterDangers" AutomationProperties.Name="{x:Static loc:Strings.Settings_ShallowWaterDangers}"/>
            </Grid>
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto"
                  ToolTip.Tip="{x:Static loc:Strings.Tooltip_PlainBoundaries}">
                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_PlainBoundaries}" />
                <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding PlainBoundaries}"  AutomationProperties.AutomationId="Settings.PlainBoundaries" AutomationProperties.Name="{x:Static loc:Strings.Settings_PlainBoundaries}"/>
            </Grid>
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto"
                  ToolTip.Tip="{x:Static loc:Strings.Tooltip_SimplifiedSymbols}">
                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_SimplifiedSymbols}" />
                <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding SimplifiedSymbols}"  AutomationProperties.AutomationId="Settings.SimplifiedSymbols" AutomationProperties.Name="{x:Static loc:Strings.Settings_SimplifiedSymbols}"/>
            </Grid>
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto"
                  ToolTip.Tip="{x:Static loc:Strings.Tooltip_FullLightLines}">
                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_FullLightLines}" />
                <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding FullLightLines}"  AutomationProperties.AutomationId="Settings.FullLightLines" AutomationProperties.Name="{x:Static loc:Strings.Settings_FullLightLines}"/>
            </Grid>
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto"
                  ToolTip.Tip="{x:Static loc:Strings.Tooltip_RadarOverlay}">
                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_RadarOverlay}" />
                <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding RadarOverlay}"  AutomationProperties.AutomationId="Settings.RadarOverlay" AutomationProperties.Name="{x:Static loc:Strings.Settings_RadarOverlay}"/>
            </Grid>
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto"
                  ToolTip.Tip="{x:Static loc:Strings.Tooltip_IgnoreScaleMinimum}">
                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_IgnoreScaleMinimum}" />
                <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding IgnoreScaleMinimum}"  AutomationProperties.AutomationId="Settings.IgnoreScaleMinimum" AutomationProperties.Name="{x:Static loc:Strings.Settings_IgnoreScaleMinimum}"/>
            </Grid>

            <!-- National Language -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_NationalLanguage}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding AvailableLanguages}"
                          AutomationProperties.AutomationId="Settings.NationalLanguage"
                          AutomationProperties.Name="{x:Static loc:Strings.Settings_NationalLanguage}"
                          SelectedValue="{Binding NationalLanguage}"
                          SelectedValueBinding="{Binding Code}"
                          ToolTip.Tip="{x:Static loc:Strings.Tooltip_NationalLanguage}"
                          MinWidth="180"
                          HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <!-- Own vessel dimensions -->
            <TextBlock Text="{x:Static loc:Strings.Settings_OwnVesselSection}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,12,0,0" />
            <TextBlock Text="{x:Static loc:Strings.Settings_OwnVesselSection_Help}"
                       TextWrapping="Wrap"
                       Opacity="0.75" />
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto"
                  ToolTip.Tip="{x:Static loc:Strings.Settings_OwnVessel_OverlayEnabled_Tooltip}">
                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_OwnVessel_OverlayEnabled}" />
                <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding OwnShipOverlayEnabled}"  AutomationProperties.AutomationId="Settings.OwnShipOverlayEnabled" AutomationProperties.Name="{x:Static loc:Strings.Settings_OwnVessel_OverlayEnabled}"/>
            </Grid>
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_OwnVessel_Length}"
                           FontSize="12" />
                <NumericUpDown Value="{Binding OwnShipLengthMetres}"
                               AutomationProperties.AutomationId="Settings.OwnShipLengthMetres"
                               AutomationProperties.Name="{x:Static loc:Strings.Settings_OwnVessel_Length}"
                               Minimum="1"
                               Maximum="500"
                               Increment="1"
                               FormatString="0.#"
                               ToolTip.Tip="{x:Static loc:Strings.Settings_OwnVessel_Length_Tooltip}"
                               MinWidth="120"
                               HorizontalAlignment="Left" />
                <TextBlock Text="{x:Static loc:Strings.Settings_OwnVessel_Beam}"
                           FontSize="12" />
                <NumericUpDown Value="{Binding OwnShipBeamMetres}"
                               AutomationProperties.AutomationId="Settings.OwnShipBeamMetres"
                               AutomationProperties.Name="{x:Static loc:Strings.Settings_OwnVessel_Beam}"
                               Minimum="1"
                               Maximum="100"
                               Increment="0.5"
                               FormatString="0.#"
                               ToolTip.Tip="{x:Static loc:Strings.Settings_OwnVessel_Beam_Tooltip}"
                               MinWidth="120"
                               HorizontalAlignment="Left" />
                <TextBlock Text="{x:Static loc:Strings.Settings_OwnVessel_BowOffset}"
                           FontSize="12" />
                <NumericUpDown Value="{Binding OwnShipBowOffsetMetres}"
                               AutomationProperties.AutomationId="Settings.OwnShipBowOffsetMetres"
                               AutomationProperties.Name="{x:Static loc:Strings.Settings_OwnVessel_BowOffset}"
                               Minimum="0"
                               Maximum="500"
                               Increment="0.5"
                               FormatString="0.#"
                               ToolTip.Tip="{x:Static loc:Strings.Settings_OwnVessel_BowOffset_Tooltip}"
                               MinWidth="120"
                               HorizontalAlignment="Left" />
                <TextBlock Text="{x:Static loc:Strings.Settings_OwnVessel_PortOffset}"
                           FontSize="12" />
                <NumericUpDown Value="{Binding OwnShipPortOffsetMetres}"
                               AutomationProperties.AutomationId="Settings.OwnShipPortOffsetMetres"
                               AutomationProperties.Name="{x:Static loc:Strings.Settings_OwnVessel_PortOffset}"
                               Minimum="0"
                               Maximum="100"
                               Increment="0.5"
                               FormatString="0.#"
                               ToolTip.Tip="{x:Static loc:Strings.Settings_OwnVessel_PortOffset_Tooltip}"
                               MinWidth="120"
                               HorizontalAlignment="Left" />
            </StackPanel>
            <!-- MCP server -->
            <TextBlock Text="{x:Static loc:Strings.Settings_McpSection}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,12,0,0" />
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto"
                  ToolTip.Tip="{x:Static loc:Strings.Settings_McpEnabledTooltip}">
                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_McpEnabled}" />
                <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding McpEnabled}"  AutomationProperties.AutomationId="Settings.McpEnabled" AutomationProperties.Name="{x:Static loc:Strings.Settings_McpEnabled}"/>
            </Grid>
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_McpPort}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumericUpDown Value="{Binding McpPort}"
                                   AutomationProperties.AutomationId="Settings.McpPort"
                                   AutomationProperties.Name="{x:Static loc:Strings.Settings_McpPort}"
                                   Minimum="0"
                                   Maximum="65535"
                                   Increment="1"
                                   FormatString="0"
                                   ToolTip.Tip="{x:Static loc:Strings.Settings_McpPortTooltip}"
                                   MinWidth="120" />
                    <Button Content="{x:Static loc:Strings.Settings_McpPort_ResetToAuto}"
                            AutomationProperties.AutomationId="Settings.ResetMcpPort"
                            Command="{Binding ResetMcpPortCommand}"
                            ToolTip.Tip="{x:Static loc:Strings.Settings_McpPort_ResetToAutoTooltip}"
                            VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- S-100 Feature Catalogue eXaminer links (issue #442) -->
            <Separator Margin="0,8,0,0" />
            <TextBlock Text="{x:Static loc:Strings.Settings_ExaminerSection}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Opacity="0.7" />
            <TextBlock Text="{x:Static loc:Strings.Settings_ExaminerSection_Help}"
                       FontSize="11"
                       Opacity="0.6"
                       TextWrapping="Wrap" />
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto"
                  ToolTip.Tip="{x:Static loc:Strings.Settings_ExaminerEnabledTooltip}">
                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_ExaminerEnabled}" />
                <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding ExaminerLinksEnabled}"  AutomationProperties.AutomationId="Settings.ExaminerLinksEnabled" AutomationProperties.Name="{x:Static loc:Strings.Settings_ExaminerEnabled}"/>
            </Grid>
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_ExaminerBaseUrl}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             AutomationProperties.AutomationId="Settings.ExaminerBaseUrl"
                             AutomationProperties.Name="{x:Static loc:Strings.Settings_ExaminerBaseUrl}"
                             Text="{Binding ExaminerBaseUrl}"
                             ToolTip.Tip="{x:Static loc:Strings.Settings_ExaminerBaseUrlTooltip}"
                             MinWidth="120"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            AutomationProperties.AutomationId="Settings.ResetExaminerBaseUrl"
                            Content="{x:Static loc:Strings.Settings_ExaminerBaseUrl_Reset}"
                            Command="{Binding ResetExaminerBaseUrlCommand}"
                            ToolTip.Tip="{x:Static loc:Strings.Settings_ExaminerBaseUrl_ResetTooltip}"
                            VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- AIS overlay (PR-D3) -->
            <Separator Margin="0,8,0,0" />
            <TextBlock Text="{x:Static loc:Strings.Settings_AisSection}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Opacity="0.7" />
            <TextBlock Text="{x:Static loc:Strings.Settings_AisSection_Help}"
                       FontSize="11"
                       Opacity="0.6"
                       TextWrapping="Wrap" />
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto"
                  ToolTip.Tip="{x:Static loc:Strings.Settings_AisEnabledTooltip}">
                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_AisEnabled}" />
                <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding AisEnabled}"  AutomationProperties.AutomationId="Settings.AisEnabled" AutomationProperties.Name="{x:Static loc:Strings.Settings_AisEnabled}"/>
            </Grid>
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_AisApiKey}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBox Text="{Binding AisApiKey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         AutomationProperties.AutomationId="Settings.AisApiKey"
                         AutomationProperties.Name="{x:Static loc:Strings.Settings_AisApiKey}"
                         PasswordChar="•"
                         ToolTip.Tip="{x:Static loc:Strings.Settings_AisApiKeyTooltip}"
                         MinWidth="280"
                         HorizontalAlignment="Left" />
                <TextBlock Text="{Binding AisApiKeyHint}"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_AisActivationSpan}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <NumericUpDown Value="{Binding AisActivationViewportSpanDegrees, Mode=TwoWay}"
                               AutomationProperties.AutomationId="Settings.AisActivationViewportSpanDegrees"
                               AutomationProperties.Name="{x:Static loc:Strings.Settings_AisActivationSpan}"
                               Minimum="0"
                               Maximum="360"
                               Increment="5"
                               FormatString="0.##"
                               ToolTip.Tip="{x:Static loc:Strings.Settings_AisActivationSpanTooltip}"
                               MinWidth="160"
                               HorizontalAlignment="Left" />
                <TextBlock Text="{x:Static loc:Strings.Settings_AisActivationSpanHint}"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Maintenance: clear caches / reset all settings -->
            <Separator Margin="0,8,0,0" />
            <TextBlock Text="{x:Static loc:Strings.Settings_MaintenanceSubsection}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Opacity="0.7" />
            <TextBlock Text="{x:Static loc:Strings.Settings_MaintenanceSubsection_Help}"
                       FontSize="11"
                       Opacity="0.6"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Static loc:Strings.Settings_ClearCaches_Button}"
                        AutomationProperties.AutomationId="Settings.ClearCaches"
                        Command="{Binding ClearCachesCommand}"
                        ToolTip.Tip="{x:Static loc:Strings.Tooltip_ClearCaches}" />
                <Button Content="{x:Static loc:Strings.Settings_ResetAll_Button}"
                        AutomationProperties.AutomationId="Settings.ResetAllSettings"
                        Command="{Binding ResetAllSettingsCommand}"
                        Classes="Destructive"
                        ToolTip.Tip="{x:Static loc:Strings.Tooltip_ResetAllSettings}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
