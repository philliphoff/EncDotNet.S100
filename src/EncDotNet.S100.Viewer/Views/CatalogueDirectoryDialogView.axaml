<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EncDotNet.S100.Viewer.ViewModels"
             xmlns:loc="using:EncDotNet.S100.Viewer.Resources"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="EncDotNet.S100.Viewer.Views.CatalogueDirectoryDialogView"
             x:DataType="vm:CatalogueDirectoryDialogViewModel">

    <!--
      Layout follows the body's width (D2), set as a class by the code-behind:
      wide (≥ 840): categories, list, details pane;
      compact (720–840): categories, list with the chosen row's details inline (D9);
      narrow (< 720): a segmented category strip above the list, details inline.
    -->
    <UserControl.Styles>
        <!-- Rows draw their own selection (a tinted row), so the container is bare. -->
        <Style Selector="ListBox#CatalogueList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Background="Transparent"
                                      HorizontalContentAlignment="Stretch" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox#CatalogueList ListBoxItem:pointerover Border.catalogueRow">
            <Setter Property="Background" Value="{DynamicResource MutedBackgroundColor}" />
        </Style>
        <Style Selector="ListBox#CatalogueList ListBoxItem:pointerover Border.catalogueRow.chosen">
            <Setter Property="Background" Value="{DynamicResource WizardSelectedBrush}" />
        </Style>
        <Style Selector="Border.catalogueRow">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.catalogueRow.chosen">
            <Setter Property="Background" Value="{DynamicResource WizardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WizardSelectedBorderBrush}" />
        </Style>

        <!-- Breakpoints: what each width shows. -->
        <Style Selector="StackPanel.inlineDetails">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(UserControl).compact StackPanel.inlineDetails.chosen, :is(UserControl).narrow StackPanel.inlineDetails.chosen">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector=":is(UserControl).compact Border#DetailsPane, :is(UserControl).narrow Border#DetailsPane">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border#CategoryStrip">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(UserControl).narrow Border#CategoryStrip">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector=":is(UserControl).narrow Border#Sidebar">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Status boxes: a tint of the status colour behind the text. -->
        <Style Selector="Border.tint">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Opacity" Value="0.12" />
            <Setter Property="Background" Value="{DynamicResource WarningColor}" />
        </Style>
        <Style Selector="Border.tint.ok">
            <Setter Property="Background" Value="{DynamicResource SuccessColor}" />
        </Style>
        <Style Selector="Ellipse.statusDot">
            <Setter Property="Fill" Value="{DynamicResource WarningColor}" />
        </Style>
        <Style Selector="Ellipse.statusDot.ok">
            <Setter Property="Fill" Value="{DynamicResource SuccessColor}" />
        </Style>
        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Sidebar categories: a quiet row, tinted when open, dimmed when a search finds nothing in it. -->
        <Style Selector="Button.categoryRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Row" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.categoryRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource MutedBackgroundColor}" />
        </Style>
        <Style Selector="Button.categoryRow.open">
            <Setter Property="Background" Value="{DynamicResource WizardSelectedBrush}" />
        </Style>
        <Style Selector="Button.categoryRow TextBlock.categoryLabel">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.categoryRow.open TextBlock.categoryLabel">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.categoryRow.dimmed">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <!-- The narrow segmented strip, like the facet tabs in step 3. -->
        <Style Selector="Button.stripItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Strip" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.stripItem.open">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
        </Style>
        <Style Selector="Button.stripItem.open /template/ Border#PART_Strip">
            <Setter Property="BoxShadow" Value="0 1 2 0 #22000000" />
        </Style>
        <!-- The registry row's action: a quiet card that reads as part of the list. -->
        <Style Selector="Button.registryAction">
            <Setter Property="Background" Value="{DynamicResource MutedBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.registryAction:pointerover /template/ Border#PART_Card">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button#StripAddByUrl">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(UserControl).narrow Button#StripAddByUrl">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="TextBox.error">
            <Setter Property="BorderBrush" Value="{DynamicResource DestructiveColor}" />
        </Style>
        <Style Selector="TextBox.error:focus /template/ Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DestructiveColor}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Search across every category (D7); the counts are in the sidebar. -->
        <TextBox Grid.Row="0" Margin="0,0,0,10" Text="{Binding SearchText}"
                 AutomationProperties.Name="{x:Static loc:Strings.Label_SearchCatalogues}"
                 AutomationProperties.HelpText="{x:Static loc:Strings.Library_DirectorySearchWatermark}"
                 AutomationProperties.AutomationId="Catalogues.Search"
                 PlaceholderText="{x:Static loc:Strings.Library_DirectorySearchWatermark}" />

        <!-- Narrow: the categories as a segmented strip (D2), and Add by URL beside it. -->
        <Button Grid.Row="1" Name="StripAddByUrl" Classes="link" HorizontalAlignment="Right"
                VerticalAlignment="Top" Margin="0,8,0,0" Command="{Binding ShowAddByUrlCommand}"
                AutomationProperties.Name="{x:Static loc:Strings.Library_DirectoryAddByUrl}"
                AutomationProperties.AutomationId="Catalogues.AddByUrl">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <ic:FluentIcon Icon="Add" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="{x:Static loc:Strings.Library_DirectoryAddByUrl}" FontSize="13" FontWeight="Medium" />
            </StackPanel>
        </Button>
        <Border Grid.Row="1" Name="CategoryStrip" Background="{DynamicResource MutedBackgroundColor}" CornerRadius="6"
                Padding="3" Margin="0,0,0,10" HorizontalAlignment="Left">
            <ItemsControl ItemsSource="{Binding Categories}"
                          AutomationProperties.Name="{x:Static loc:Strings.Label_SourceCategories}"
                          AutomationProperties.AutomationId="Catalogues.CategoryStrip">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CatalogueCategoryViewModel">
                        <Button Classes="stripItem" Classes.open="{Binding IsOpen}" Classes.dimmed="{Binding IsDimmed}"
                                Command="{Binding SelectCommand}" Margin="0,0,2,0"
                                AutomationProperties.Name="{Binding AccessibleName}"
                                AutomationProperties.AutomationId="Catalogues.StripCategory">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding ShortLabel}" FontWeight="Medium" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CountText}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
            <!-- Categories first, each with its count (D6); match counts while searching. -->
            <Border Grid.Column="0" Name="Sidebar" Width="176" Padding="0,0,12,0" Margin="0,0,12,0"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                <DockPanel>
                <!-- Add by URL from any category: it opens My sources, where the form is (D10). -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                        Padding="10,8,0,0" IsVisible="{Binding CanAddByUrl}">
                    <Button Classes="link" HorizontalAlignment="Left" Command="{Binding ShowAddByUrlCommand}"
                            AutomationProperties.Name="{x:Static loc:Strings.Library_DirectoryAddByUrl}"
                            AutomationProperties.AutomationId="Catalogues.AddByUrl">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:FluentIcon Icon="Add" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static loc:Strings.Library_DirectoryAddByUrl}" FontSize="13" FontWeight="Medium" />
                        </StackPanel>
                    </Button>
                </Border>
                <ItemsControl ItemsSource="{Binding Categories}"
                              AutomationProperties.Name="{x:Static loc:Strings.Label_SourceCategories}"
                              AutomationProperties.AutomationId="Catalogues.Categories">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CatalogueCategoryViewModel">
                            <Button Classes="categoryRow" Classes.open="{Binding IsOpen}" Classes.dimmed="{Binding IsDimmed}"
                                    Command="{Binding SelectCommand}"
                                    AutomationProperties.Name="{Binding AccessibleName}"
                                    AutomationProperties.AutomationId="Catalogues.Category">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Classes="categoryLabel" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="muted" FontSize="12"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <!-- My sources: the URL form heads the list (D10). -->
                <Border Grid.Row="0" IsVisible="{Binding ShowsUrlForm}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="0,0,0,1" Padding="0,2,0,12" Margin="0,0,0,6">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Static loc:Strings.Library_DirectoryUrlHeading}" FontSize="12.5" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Name="UrlBox" Text="{Binding CatalogueUrl}" Classes.error="{Binding HasUrlError}"
                                     FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                                     AutomationProperties.Name="{x:Static loc:Strings.Library_DirectoryUrlHeading}"
                                     AutomationProperties.AutomationId="Catalogues.Url"
                                     PlaceholderText="https://…/catalog.xml or feed.json" />
                            <Button Grid.Column="1" Classes="Outline" Command="{Binding AddUrlCommand}" IsDefault="False"
                                    AutomationProperties.Name="{x:Static loc:Strings.Button_CheckAndAdd}"
                                    AutomationProperties.AutomationId="Catalogues.CheckAndAdd">
                                <Panel>
                                    <TextBlock Text="{x:Static loc:Strings.Button_CheckAndAdd}" IsVisible="{Binding !IsChecking}" />
                                    <TextBlock Text="{x:Static loc:Strings.Button_Checking}" IsVisible="{Binding IsChecking}" />
                                </Panel>
                            </Button>
                        </Grid>
                        <TextBlock Text="{x:Static loc:Strings.Library_DirectoryUrlHelp}" IsVisible="{Binding ShowsUrlHelp}"
                                   Classes="muted" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding UrlError}" IsVisible="{Binding HasUrlError}"
                                   Classes="destructive" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding UrlSuccess}" IsVisible="{Binding UrlSuccess, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Classes="success" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            <Panel Grid.Row="1">
                <ListBox Name="CatalogueList"
                         AutomationProperties.AutomationId="Catalogues.List"
                         ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <!-- Rows are named after their source or header, not their view model (#784). -->
                        <!-- ShadUI's ListBoxItem theme sets FontWeight Medium; rows are body text (#1171). -->
                        <Style Selector="ListBoxItem" x:DataType="vm:CatalogueEntryViewModel">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                            <Setter Property="FontWeight" Value="Normal" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CatalogueEntryViewModel">
                            <Panel>
                                <!-- Region or category header (not selectable). -->
                                <TextBlock IsVisible="{Binding IsHeaderText}" Text="{Binding HeaderText}"
                                           Classes="muted" FontSize="11.5" FontWeight="SemiBold" LetterSpacing="0.7"
                                           Padding="4,10,4,4" />

                                <!-- SECOM services: the registry's own row (D10), read only when asked (#822). -->
                                <StackPanel IsVisible="{Binding IsRegistryRow}" Spacing="6" Margin="0,8,0,4">
                                    <Button Classes="registryAction" Command="{Binding Directory.ShowRegistryCommand}"
                                            IsVisible="{Binding Directory.CanShowRegistry, FallbackValue=False}"
                                            AutomationProperties.Name="{x:Static loc:Strings.Label_ShowSecomServices}"
                                            AutomationProperties.HelpText="{x:Static loc:Strings.Library_RegistryShow}"
                                            AutomationProperties.AutomationId="Catalogues.ShowRegistry">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <ic:FluentIcon Icon="Globe" FontSize="15" VerticalAlignment="Top" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Static loc:Strings.Library_RegistryListTitle}" FontSize="13.5"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{x:Static loc:Strings.Library_RegistryShow}" Classes="muted"
                                                           FontSize="12.5" TextWrapping="Wrap" FontWeight="Normal" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="4,0"
                                          IsVisible="{Binding Directory.IsRegistryLoaded, FallbackValue=False}">
                                        <TextBlock Text="{Binding Directory.RegistryText}" Classes="muted" FontSize="12"
                                                   TextWrapping="Wrap" AutomationProperties.AutomationId="Catalogues.RegistrySummary" />
                                        <Button Grid.Column="1" Classes="link" Content="{x:Static loc:Strings.Label_RefreshRegistry}"
                                                Command="{Binding Directory.RefreshRegistryCommand}" VerticalAlignment="Top"
                                                AutomationProperties.AutomationId="Catalogues.RefreshRegistry" />
                                    </Grid>
                                    <TextBlock Text="{x:Static loc:Strings.Library_RegistryLoading}" Margin="4,0"
                                               IsVisible="{Binding Directory.IsLoadingRegistry, FallbackValue=False}"
                                               Classes="muted" FontSize="12" />
                                    <TextBlock Text="{Binding Directory.RegistryError}" Margin="4,0"
                                               IsVisible="{Binding Directory.HasRegistryError, FallbackValue=False}"
                                               FontSize="12" TextWrapping="Wrap" Classes="destructive" />
                                </StackPanel>

                                <!-- Two lines; the tint is the selection, no radio mark (D8). -->
                                <Border IsVisible="{Binding IsSourceRow}" Classes="catalogueRow"
                                        Classes.chosen="{Binding IsSelected}">
                                    <StackPanel Spacing="1">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding FormatText}" Classes="muted" FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding RowDetail}" Classes="muted" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Compact details of the chosen source, when there is no pane (D9). -->
                                        <StackPanel Classes="inlineDetails" Classes.chosen="{Binding IsSelected}"
                                                    Spacing="2" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding ReachabilityText}" IsVisible="{Binding HasReachability}"
                                                       Classes="muted" Classes.warning="{Binding IsReachabilityLimited}"
                                                       FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding ReachabilityExplanation}"
                                                       AutomationProperties.AutomationId="Catalogues.Row.Reachability" />
                                            <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Note}" />
                                            <TextBlock Text="{Binding LimitationsLine}" IsVisible="{Binding HasLimitations}"
                                                       Classes="warning" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding LimitationsLine}" />
                                            <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Button Classes="link" Content="{Binding FixText}" Margin="0,0,14,0"
                                                        AutomationProperties.AutomationId="Catalogues.Row.Fix"
                                                        AutomationProperties.Name="{Binding FixText}"
                                                        AutomationProperties.HelpText="{x:Static loc:Strings.Keys_Fix_Help}"
                                                        ToolTip.Tip="{x:Static loc:Strings.Keys_Fix_Help}"
                                                        IsVisible="{Binding HasFix}" Command="{Binding OpenFixCommand}" />
                                                <Button Classes="link" Content="{x:Static loc:Strings.Label_CopyCatalogueUrl}" Margin="0,0,14,0"
                                                        AutomationProperties.AutomationId="Catalogues.Row.CopyUrl"
                                                        AutomationProperties.Name="{x:Static loc:Strings.Label_CopyCatalogueUrl}"
                                                        ToolTip.Tip="{Binding CatalogUrl}" Command="{Binding CopyUrlCommand}" />
                                                <Button Classes="link" Content="{x:Static loc:Strings.Library_DirectoryTerms}" Margin="0,0,14,0"
                                                        AutomationProperties.AutomationId="Catalogues.Row.Terms"
                                                        IsVisible="{Binding HasHomepage}" Command="{Binding OpenHomepageCommand}" />
                                                <Button Classes="link danger" Content="{x:Static loc:Strings.Library_DirectoryRemove}"
                                                        AutomationProperties.AutomationId="Catalogues.Row.Remove"
                                                        IsVisible="{Binding IsUser}" Command="{Binding RemoveCommand}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Panel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- Nothing matches: offer to add it by URL (D10). -->
                <StackPanel IsVisible="{Binding HasNoMatches}" Spacing="4" HorizontalAlignment="Center" Margin="12,28,12,0">
                    <TextBlock Text="{Binding NoMatchesText}" Classes="muted" FontSize="13" TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <Button Classes="link" Content="{x:Static loc:Strings.Library_DirectoryAddItByUrl}" FontSize="13"
                            HorizontalAlignment="Center" IsVisible="{Binding CanAddByUrl}"
                            Command="{Binding ShowAddByUrlCommand}"
                            AutomationProperties.AutomationId="Catalogues.NoMatches.AddByUrl" />
                </StackPanel>
                <TextBlock Text="{Binding EmptyCategoryText}" IsVisible="{Binding IsCategoryEmpty}"
                           Classes="muted" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="12,24,12,0" />
            </Panel>
            </Grid>

            <!-- Wide: the chosen source's details on the side, so selecting never moves the list (D8, D14). -->
            <Border Grid.Column="2" Name="DetailsPane" Width="300" Margin="12,0,0,0" Padding="16,4,0,4"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0"
                    AutomationProperties.Name="{x:Static loc:Strings.Label_SelectedSource}"
                    AutomationProperties.AutomationId="Catalogues.Details">
                <Panel>
                    <ScrollViewer IsVisible="{Binding HasSelection}" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel DataContext="{Binding SelectedEntry}" x:DataType="vm:CatalogueEntryViewModel" Spacing="10" Margin="0,0,12,0">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="Catalogues.Details.Name" />
                                <TextBlock Text="{Binding ProviderAndPlace}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- A registry service: whether it can be read now, and the fix (#822, #880). -->
                            <Panel IsVisible="{Binding HasReachability}">
                                <Border Classes="tint" Classes.ok="{Binding !IsReachabilityLimited}" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="10,8">
                                    <Ellipse Classes="statusDot" Classes.ok="{Binding !IsReachabilityLimited}"
                                             Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding ReachabilityText}" FontSize="12.5" TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="Catalogues.Details.Reachability" />
                                        <TextBlock Text="{Binding ReachabilityExplanation}" IsVisible="{Binding HasReachabilityExplanation}"
                                                   Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                        <Button Classes="link" Content="{Binding FixText}" HorizontalAlignment="Left"
                                                AutomationProperties.AutomationId="Catalogues.Details.Fix"
                                                AutomationProperties.Name="{Binding FixText}"
                                                AutomationProperties.HelpText="{x:Static loc:Strings.Keys_Fix_Help}"
                                                ToolTip.Tip="{x:Static loc:Strings.Keys_Fix_Help}"
                                                IsVisible="{Binding HasFix}" Command="{Binding OpenFixCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Panel>

                            <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="13" TextWrapping="Wrap" />

                            <!-- Only what the source can't tell in advance (D14); nothing when it has it all. -->
                            <Panel IsVisible="{Binding HasLimitations}">
                                <Border Classes="tint" />
                                <StackPanel Spacing="4" Margin="10,8" AutomationProperties.AutomationId="Catalogues.Details.Limitations">
                                    <TextBlock Text="{x:Static loc:Strings.Library_DetailsBeforeDownload}" Classes="sectionLabel warning" />
                                    <ItemsControl ItemsSource="{Binding Limitations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,3" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Panel>

                            <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Static loc:Strings.Library_DetailsCatalogueUrl}" Classes="sectionLabel muted" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <TextBlock Text="{Binding CatalogUrl}" Classes="muted" FontSize="11.5"
                                                   FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CatalogUrl}" />
                                        <Button Grid.Column="1" Classes="Outline" Width="26" Height="26" Padding="0" MinHeight="0"
                                                Command="{Binding CopyUrlCommand}"
                                                ToolTip.Tip="{x:Static loc:Strings.Label_CopyCatalogueUrl}"
                                                AutomationProperties.Name="{x:Static loc:Strings.Label_CopyCatalogueUrl}"
                                                AutomationProperties.AutomationId="Catalogues.Details.CopyUrl">
                                            <ic:FluentIcon Icon="Copy" FontSize="13" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Button Classes="link" Content="{x:Static loc:Strings.Library_DirectoryTerms}" FontSize="13"
                                        AutomationProperties.AutomationId="Catalogues.Details.Terms"
                                        IsVisible="{Binding HasHomepage}" Command="{Binding OpenHomepageCommand}" />
                                <Button Classes="link danger" Content="{x:Static loc:Strings.Library_DirectoryRemove}" FontSize="13"
                                        AutomationProperties.AutomationId="Catalogues.Details.Remove"
                                        IsVisible="{Binding IsUser}" Command="{Binding RemoveCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Text="{x:Static loc:Strings.Library_DetailsNoSelection}" IsVisible="{Binding !HasSelection}"
                               Classes="muted" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" />
                </Panel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
