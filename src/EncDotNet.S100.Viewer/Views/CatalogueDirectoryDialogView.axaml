<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EncDotNet.S100.Viewer.ViewModels"
             xmlns:loc="using:EncDotNet.S100.Viewer.Resources"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="EncDotNet.S100.Viewer.Views.CatalogueDirectoryDialogView"
             x:DataType="vm:CatalogueDirectoryDialogViewModel">

    <UserControl.Styles>
        <!-- Rows draw their own selection (a tinted card), so the container is bare. -->
        <Style Selector="ListBox#CatalogueList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Background="Transparent"
                                      HorizontalContentAlignment="Stretch" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox#CatalogueList ListBoxItem:pointerover Border.catalogueRow">
            <Setter Property="Background" Value="{DynamicResource MutedBackgroundColor}" />
        </Style>
        <Style Selector="ListBox#CatalogueList ListBoxItem:pointerover Border.catalogueRow.chosen">
            <Setter Property="Background" Value="{DynamicResource WizardSelectedBrush}" />
        </Style>
        <Style Selector="Border.catalogueRow">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.catalogueRow.chosen">
            <Setter Property="Background" Value="{DynamicResource WizardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WizardSelectedBorderBrush}" />
        </Style>
        <!-- The 16 px radio mark. -->
        <Style Selector="Ellipse.radioRing">
            <Setter Property="Stroke" Value="{DynamicResource BorderColor}" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>
        <Style Selector="Ellipse.radioRing.chosen">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        </Style>
        <!-- Quality chips: a neutral pill, dimmed when it states a limitation. -->
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        </Style>
        <Style Selector="Border.chip.limited">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Border.chip TextBlock">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <!-- The collapsed "Add a catalogue by URL" row. -->
        <Style Selector="Button.addByUrl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="Transparent">
                        <Rectangle Name="PART_Dash" Stroke="{DynamicResource BorderColor}" StrokeThickness="1"
                                   StrokeDashArray="4,3" RadiusX="6" RadiusY="6" />
                        <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                          VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch" />
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.addByUrl:pointerover /template/ Rectangle#PART_Dash">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBox.error">
            <Setter Property="BorderBrush" Value="{DynamicResource DestructiveColor}" />
        </Style>
        <Style Selector="TextBox.error:focus /template/ Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DestructiveColor}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Search, with the count at the right. -->
        <Panel Grid.Row="0" Margin="0,0,0,8">
            <TextBox Text="{Binding SearchText}" Padding="10,0,72,0"
                     AutomationProperties.Name="{x:Static loc:Strings.Label_SearchCatalogues}"
                     AutomationProperties.HelpText="{x:Static loc:Strings.Library_DirectorySearchWatermark}"
                     AutomationProperties.AutomationId="Catalogues.Search"
                     PlaceholderText="{x:Static loc:Strings.Library_DirectorySearchWatermark}" />
            <TextBlock Text="{Binding CountText}" Classes="muted" FontSize="12" IsHitTestVisible="False"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
        </Panel>

        <Panel Grid.Row="1">
            <ListBox Name="CatalogueList"
                     AutomationProperties.AutomationId="Catalogues.List"
                     ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <!-- Rows are named after their catalogue or region, not their view model (#784). -->
                    <Style Selector="ListBoxItem" x:DataType="vm:CatalogueEntryViewModel">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CatalogueEntryViewModel">
                        <Panel>
                            <!-- Region header (not selectable). -->
                            <TextBlock IsVisible="{Binding IsGroupHeader}" Text="{Binding HeaderText}"
                                       Classes="muted" FontSize="11.5" FontWeight="SemiBold" LetterSpacing="0.7"
                                       Padding="4,10,4,4" />

                            <Border IsVisible="{Binding !IsGroupHeader}" Classes="catalogueRow"
                                    Classes.chosen="{Binding IsSelected}">
                                <Grid ColumnDefinitions="16,*" ColumnSpacing="10">
                                    <Panel Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <Ellipse Classes="radioRing" Classes.chosen="{Binding IsSelected}" />
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                                                 IsVisible="{Binding IsSelected}" />
                                    </Panel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding FormatText}" Classes="muted" FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding ProviderAndRegion}" Classes="muted" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Details of the chosen catalogue only. -->
                                        <StackPanel IsVisible="{Binding IsSelected}" Spacing="6" Margin="0,6,0,0">
                                            <WrapPanel Orientation="Horizontal">
                                                <Border Classes="chip" Classes.limited="{Binding IsCoverageLimited}" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding CoverageChip}" />
                                                </Border>
                                                <Border Classes="chip" Classes.limited="{Binding IsEditionsLimited}" Margin="0,0,4,0"
                                                        IsVisible="{Binding HasEditionChips}">
                                                    <TextBlock Text="{Binding EditionsChip}" />
                                                </Border>
                                                <Border Classes="chip" Classes.limited="{Binding IsSizesLimited}" Margin="0,0,4,0"
                                                        IsVisible="{Binding HasEditionChips}">
                                                    <TextBlock Text="{Binding SizesChip}" />
                                                </Border>
                                                <Border Classes="chip limited" Margin="0,0,4,0" IsVisible="{Binding IsPilot}">
                                                    <TextBlock Text="{x:Static loc:Strings.Library_Chip_Pilot}" />
                                                </Border>
                                                <Border Classes="chip" Margin="0,0,4,0" IsVisible="{Binding IsForecast}">
                                                    <TextBlock Text="{x:Static loc:Strings.Library_Chip_Forecast}" />
                                                </Border>
                                                <Border Classes="chip" Margin="0,0,4,0" IsVisible="{Binding IsForecast}">
                                                    <TextBlock Text="{x:Static loc:Strings.Library_Chip_LatestRunOnly}" />
                                                </Border>
                                                <Border Classes="chip limited" IsVisible="{Binding IsNotForNavigation}">
                                                    <TextBlock Text="{x:Static loc:Strings.Library_Chip_NotForNavigation}" />
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="12.5"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding CatalogUrl}" Classes="muted" FontSize="11.5"
                                                       FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CatalogUrl}" />
                                            <StackPanel Orientation="Horizontal" Spacing="14">
                                                <Button Classes="link" Content="{x:Static loc:Strings.Library_DirectoryTerms}"
                                                        AutomationProperties.AutomationId="Catalogues.Row.Terms"
                                                        IsVisible="{Binding HasHomepage}" Command="{Binding OpenHomepageCommand}" />
                                                <Button Classes="link danger" Content="{x:Static loc:Strings.Library_DirectoryRemove}"
                                                        AutomationProperties.AutomationId="Catalogues.Row.Remove"
                                                        IsVisible="{Binding IsUser}" Command="{Binding RemoveCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Panel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{x:Static loc:Strings.Library_DirectoryNoMatches}" IsVisible="{Binding HasNoMatches}"
                       Classes="muted" FontSize="13" HorizontalAlignment="Center" Margin="0,24,0,0" />
        </Panel>

        <!-- Add a catalogue by URL: collapsed to one dashed row until asked for. -->
        <Panel Grid.Row="2" Margin="0,10,0,0" IsVisible="{Binding CanAddByUrl}">
            <Button Classes="addByUrl" IsVisible="{Binding !IsUrlPanelOpen}" Command="{Binding OpenUrlPanelCommand}"
                    AutomationProperties.Name="{x:Static loc:Strings.Library_DirectoryAddByUrl}"
                    AutomationProperties.AutomationId="Catalogues.AddByUrl">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                    <ic:FluentIcon Icon="Add" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.Library_DirectoryAddByUrl}" FontSize="13"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{x:Static loc:Strings.Library_DirectoryAddByUrlHint}" Classes="muted"
                               FontSize="12" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Border Classes="wizardPanel" Padding="12,10" IsVisible="{Binding IsUrlPanelOpen}">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{x:Static loc:Strings.Library_DirectoryUrlHeading}" FontSize="13" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Classes="link" Content="{x:Static loc:Strings.Button_Close}"
                                AutomationProperties.AutomationId="Catalogues.CloseUrlPanel"
                                Command="{Binding CloseUrlPanelCommand}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Name="UrlBox" Text="{Binding CatalogueUrl}" Classes.error="{Binding HasUrlError}"
                                 AutomationProperties.Name="{x:Static loc:Strings.Library_DirectoryUrlHeading}"
                                 AutomationProperties.AutomationId="Catalogues.Url"
                                 PlaceholderText="https://…/catalogue.xml" />
                        <Button Grid.Column="1" Classes="Outline" Command="{Binding AddUrlCommand}"
                                AutomationProperties.Name="{x:Static loc:Strings.Button_CheckAndAdd}"
                                AutomationProperties.AutomationId="Catalogues.CheckAndAdd">
                            <Panel>
                                <TextBlock Text="{x:Static loc:Strings.Button_CheckAndAdd}" IsVisible="{Binding !IsChecking}" />
                                <TextBlock Text="{x:Static loc:Strings.Button_Checking}" IsVisible="{Binding IsChecking}" />
                            </Panel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{x:Static loc:Strings.Library_DirectoryUrlHelp}" IsVisible="{Binding ShowsUrlHelp}"
                               Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding UrlError}" IsVisible="{Binding HasUrlError}"
                               Classes="destructive" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding UrlSuccess}" IsVisible="{Binding UrlSuccess, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Classes="success" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</UserControl>
