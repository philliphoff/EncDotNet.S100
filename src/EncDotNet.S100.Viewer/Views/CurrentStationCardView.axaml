<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EncDotNet.S100.Viewer.ViewModels"
             xmlns:loc="using:EncDotNet.S100.Viewer.Resources"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="EncDotNet.S100.Viewer.Views.CurrentStationCardView"
             x:DataType="vm:CurrentStationCardViewModel"
             AutomationProperties.AutomationId="Pick.CurrentStation">
    <!-- The predicted current station card (tide predictions design Q8b, D16). -->
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
            <SelectableTextBlock Grid.Column="0"
                                 Text="{Binding Subtitle}"
                                 FontSize="11"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="Pick.CurrentStation.Subtitle" />
            <Panel Grid.Column="1" VerticalAlignment="Top" Margin="6,0,0,0">
                <Rectangle Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeDashArray="3,2" RadiusX="3" RadiusY="3" />
                <TextBlock Text="{x:Static loc:Strings.Tides_Card_PredictedChip}" Margin="6,1" FontSize="11" FontWeight="SemiBold" />
            </Panel>
        </Grid>

        <Panel AutomationProperties.AutomationId="Pick.CurrentStation.Now">
            <Rectangle Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="4" RadiusY="4" />
            <Grid ColumnDefinitions="*,Auto" Margin="12,10">
                <TextBlock Grid.Column="0" Text="{Binding NowLabel}" FontSize="10" FontWeight="SemiBold" LetterSpacing="1" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <SelectableTextBlock Text="{Binding NowValue}" FontSize="18" FontWeight="Bold" VerticalAlignment="Bottom"
                                         AutomationProperties.AutomationId="Pick.CurrentStation.NowValue" />
                    <TextBlock Text="{Binding NowDetail}" FontSize="12" Opacity="0.8" VerticalAlignment="Bottom" Margin="0,0,0,2"
                               AutomationProperties.AutomationId="Pick.CurrentStation.NowDetail" />
                </StackPanel>
            </Grid>
        </Panel>

        <StackPanel Spacing="2">
            <TextBlock FontSize="10" LetterSpacing="1" Opacity="0.7">
                <Run Text="{Binding CurveTitle}" FontWeight="SemiBold" />
                <Run Text="  " />
                <Run Text="{x:Static loc:Strings.Tides_Currents_CurveCaption}" />
            </TextBlock>
            <lvc:CartesianChart MinHeight="180"
                                Series="{Binding SpeedSeries}"
                                XAxes="{Binding TimeAxisArray}"
                                YAxes="{Binding SpeedAxisArray}"
                                Sections="{Binding CardSections}"
                                AutomationProperties.AutomationId="Pick.CurrentStation.Chart" />
        </StackPanel>

        <StackPanel Spacing="2">
            <TextBlock Text="{x:Static loc:Strings.Tides_Currents_SlacksAndMaxima}" FontSize="10" FontWeight="SemiBold" LetterSpacing="1" Opacity="0.7" />
            <ItemsControl ItemsSource="{Binding Events}" AutomationProperties.AutomationId="Pick.CurrentStation.Events">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CurrentEventRow">
                        <Grid ColumnDefinitions="76,*,Auto,8,Auto" Opacity="{Binding Opacity}" Margin="0,1">
                            <TextBlock Grid.Column="0" Text="{Binding Kind}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding When}" FontSize="12" />
                            <TextBlock Grid.Column="2" Text="{Binding Speed}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="{Binding Direction}" FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:Strings.Tides_Currents_FloodDirection}" FontSize="12" Opacity="0.7" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FloodDirection}" FontSize="12" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:Strings.Tides_Currents_EbbDirection}" FontSize="12" Opacity="0.7" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EbbDirection}" FontSize="12" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static loc:Strings.Tides_Currents_Depth}" FontSize="12" Opacity="0.7" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DepthText}" FontSize="12" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static loc:Strings.Tides_Currents_UsedFor}" FontSize="12" Opacity="0.7" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Static loc:Strings.Tides_Currents_DisplayOnly}" FontSize="12" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="Pick.CurrentStation.UsedFor" />
        </Grid>

        <Border Background="{DynamicResource MutedBackgroundColor}" CornerRadius="4" Padding="10,8"
                AutomationProperties.AutomationId="Pick.CurrentStation.Note">
            <TextBlock Text="{x:Static loc:Strings.Tides_Currents_Note}" FontSize="11" TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
