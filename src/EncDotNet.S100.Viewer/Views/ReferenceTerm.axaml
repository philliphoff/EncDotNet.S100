<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:EncDotNet.S100.Viewer.Views">

    <!--
      A chart reference term (symbol dictionary §4.6, R8, #1651): its words with a dotted
      underline in the text colour, never blue (blue is kept for actions), and its peek in
      a popup under it. A term the index doesn't hold is plain text.
    -->
    <Style Selector="views|ReferenceTerm">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <TextBlock Name="PART_Text"
                                   Text="{TemplateBinding Text}"
                                   TextTrimming="{TemplateBinding TextTrimming}"
                                   TextWrapping="{TemplateBinding TextWrapping}" />
                    </Border>
                    <Popup Name="PART_Peek"
                           IsOpen="{TemplateBinding IsPeekOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                           Placement="BottomEdgeAlignedLeft"
                           OverlayDismissEventPassThrough="True"
                           IsLightDismissEnabled="False">
                        <views:ReferencePeekView Name="PART_PeekView"
                                                 DataContext="{TemplateBinding Peek}" />
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- The dotted underline is set in code, in the text's own colour (ReferenceTerm.Underline). -->
    <Style Selector="views|ReferenceTerm:term:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource MutedBackgroundColor}" />
    </Style>
    <Style Selector="views|ReferenceTerm:term:focus-visible /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="-1" />
    </Style>
</Styles>
