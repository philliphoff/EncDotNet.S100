<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keys="using:EncDotNet.S100.Viewer.ViewModels.Keys"
             xmlns:loc="using:EncDotNet.S100.Viewer.Resources"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="EncDotNet.S100.Viewer.Views.ImportIdentityDialogView"
             x:DataType="keys:ImportIdentityDialogViewModel"
             Width="440">

    <!-- Import identity (#845 D): File → Check → Use. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.importMuted">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.importFoot">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="SelectableTextBlock.fieldValue.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ic|FluentIcon.fieldValue.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="SelectableTextBlock.fieldValue.success">
            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ic|FluentIcon.fieldValue.success">
            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="SelectableTextBlock.fieldValue.destructive">
            <Setter Property="Foreground" Value="{DynamicResource DestructiveColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="SelectableTextBlock.fieldValue.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Header: icon, title, step -->
        <Border DockPanel.Dock="Top" Padding="18,14,44,14" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <ic:FluentIcon Icon="ContactCard" IconVariant="Regular" FontSize="16" Opacity="0.65" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding StepLabel}" FontSize="11.5" Opacity="0.65" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Footer: Back (Check only), primary -->
        <Border DockPanel.Dock="Bottom" Padding="18,12" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <Button Classes="Outline" Content="{x:Static loc:Strings.Keys_Import_Back}"
                        Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}"
                        AutomationProperties.AutomationId="ImportIdentity.Back" />
                <Button Grid.Column="2" Classes="Outline" Content="{x:Static loc:Strings.Button_Cancel}"
                        Command="{Binding CancelCommand}" IsVisible="{Binding !IsUseStep}"
                        AutomationProperties.AutomationId="ImportIdentity.Cancel" />
                <Button Grid.Column="3" Classes="Primary" Content="{Binding PrimaryLabel}"
                        Command="{Binding PrimaryCommand}" IsDefault="True"
                        AutomationProperties.AutomationId="ImportIdentity.Primary" />
            </Grid>
        </Border>

        <StackPanel Margin="18,16" Spacing="12" MinHeight="250">
            <!-- D1: File -->
            <StackPanel Spacing="12" IsVisible="{Binding IsFileStep}">
                <TextBlock Classes="importMuted" Text="{x:Static loc:Strings.Keys_Import_FileIntro}" />
                <Panel>
                    <Rectangle Stroke="{DynamicResource BorderColor}" StrokeThickness="1.5" StrokeDashArray="4,3" RadiusX="6" RadiusY="6" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="12,11">
                        <ic:FluentIcon Icon="Document" IconVariant="Regular" FontSize="16" Opacity="0.65" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding FileName}" FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                                       FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding FileKind}" FontSize="11" Opacity="0.65" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="Ghost" Content="{x:Static loc:Strings.Keys_Import_Change}"
                                Command="{Binding ChangeFileCommand}" VerticalAlignment="Center"
                                FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                AutomationProperties.AutomationId="ImportIdentity.ChangeFile"
                                AutomationProperties.HelpText="{x:Static loc:Strings.Keys_Import_Change_Help}" />
                    </Grid>
                </Panel>
                <Grid ColumnDefinitions="90,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <TextBlock Text="{x:Static loc:Strings.Keys_Import_Password}" FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" PasswordChar="•" Text="{Binding Password}"
                             AutomationProperties.AutomationId="ImportIdentity.Password"
                             AutomationProperties.Name="{x:Static loc:Strings.Keys_Import_Password}"
                             AutomationProperties.HelpText="{x:Static loc:Strings.Keys_Import_Password_Help}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Error}" IsVisible="{Binding HasError}"
                               FontSize="11.5" Foreground="{DynamicResource DestructiveColor}" TextWrapping="Wrap" />
                </Grid>
                <TextBlock Classes="importFoot" Text="{x:Static loc:Strings.Keys_Import_PasswordFootnote}" />
            </StackPanel>

            <!-- D2: Check -->
            <StackPanel Spacing="12" IsVisible="{Binding IsCheckStep}">
                <Border Background="{DynamicResource MutedBackgroundColor}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="6" Padding="12,11">
                    <ItemsControl ItemsSource="{Binding CheckFields}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="keys:KeysField">
                                <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
                                    <TextBlock Text="{Binding Label}" FontSize="12" Opacity="0.65" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                        <ic:FluentIcon Icon="Checkmark" IconVariant="Regular" FontSize="12" IsVisible="{Binding ShowsCheck}"
                                                       Classes="fieldValue success" VerticalAlignment="Center" />
                                        <SelectableTextBlock Text="{Binding Value}" FontSize="12" TextWrapping="Wrap"
                                                             Classes="fieldValue"
                                                             Classes.mono="{Binding IsMono}"
                                                             Classes.warning="{Binding IsWarning}"
                                                             Classes.success="{Binding IsSuccess}"
                                                             Classes.destructive="{Binding IsDestructive}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
                    <TextBlock Text="{x:Static loc:Strings.Keys_Import_Name}" FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding Name}"
                             AutomationProperties.AutomationId="ImportIdentity.Name"
                             AutomationProperties.Name="{x:Static loc:Strings.Keys_Import_Name}"
                             AutomationProperties.HelpText="{x:Static loc:Strings.Keys_Import_Name_Help}" />
                </Grid>
                <TextBlock Text="{Binding Blocker}" IsVisible="{Binding HasBlocker}"
                           FontSize="11.5" Foreground="{DynamicResource DestructiveColor}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                    <ic:FluentIcon Icon="Key" IconVariant="Regular" FontSize="13" Opacity="0.65" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <TextBlock Grid.Column="1" Classes="importFoot" Text="{Binding KeyStoreNote}" />
                </Grid>
            </StackPanel>

            <!-- D3: Use -->
            <StackPanel Spacing="12" IsVisible="{Binding IsUseStep}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Panel Width="30" Height="30">
                        <Ellipse Fill="{DynamicResource SuccessColor}" Opacity="0.14" />
                        <ic:FluentIcon Icon="Checkmark" IconVariant="Regular" FontSize="15"
                                       Foreground="{DynamicResource SuccessColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                    <TextBlock Text="{Binding ImportedTitle}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                    <CheckBox IsChecked="{Binding UseForSecom}"
                              Content="{x:Static loc:Strings.Keys_Import_UseForSecom}"
                              FontSize="12.5" FontWeight="SemiBold"
                              AutomationProperties.AutomationId="ImportIdentity.UseForSecom" />
                </Border>
                <TextBlock Classes="importFoot" Text="{x:Static loc:Strings.Keys_Import_UseHelp}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{x:Static loc:Strings.Keys_ReferenceLabel}" FontSize="11" Opacity="0.65" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource MutedBackgroundColor}" CornerRadius="3" Padding="5,0">
                        <SelectableTextBlock Text="{Binding Reference}" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="11" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</UserControl>
