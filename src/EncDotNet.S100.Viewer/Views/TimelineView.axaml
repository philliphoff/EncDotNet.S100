<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EncDotNet.S100.Viewer.ViewModels"
             xmlns:views="using:EncDotNet.S100.Viewer.Views"
             xmlns:loc="using:EncDotNet.S100.Viewer.Resources"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:conv="using:EncDotNet.S100.Viewer"
             x:Class="EncDotNet.S100.Viewer.Views.TimelineView"
             x:DataType="vm:TimelineViewModel">

    <UserControl.Styles>
        <!-- Slider accent styling lives app-wide in App.axaml. -->
        <!-- Mode pill (#713 B1): outlined when pinned, filled when live. -->
        <Style Selector="Border.ModePill">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Live: a dark pill with white text in both themes (handoff B1). -->
        <Style Selector="Border.ModePill.live">
            <Setter Property="BorderBrush" Value="#18181B" />
            <Setter Property="Background" Value="#18181B" />
        </Style>
        <Style Selector="Border.ModePill.live TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- Status messages (#713 B3; loading #709). -->
        <Style Selector="Button.StatusText">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="Button.StatusText /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.StatusText.warning">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.StatusText.drawing">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource DestructiveColor}" />
        </Style>
        <Style Selector="Button.error /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource DestructiveColor}" />
        </Style>
        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
        </Style>
        <Style Selector="Button.warning /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
        </Style>
        <!-- Lanes (#710, handoff E1–E2). -->
        <Style Selector="Button.LaneGroup">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.LaneGroup /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.ExpiredTag">
            <Setter Property="BorderBrush" Value="{DynamicResource DestructiveColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.ExpiredTag TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DestructiveColor}" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style Selector="Border.NewRunTag">
            <Setter Property="BorderBrush" Value="{DynamicResource WarningColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.NewRunTag TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style Selector="Panel.LaneTrack.actions">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="TextBlock.LaneTime">
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="TextBlock.LaneTime.warning">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- One lane: label column (swatch, code, sub, tag; layer time below)
             and its data on the shared axis (handoff E1, E2). -->
        <DataTemplate x:Key="LaneTemplate" x:DataType="vm:TimelineLaneViewModel">
            <Grid ColumnDefinitions="248,*"
                  Height="34"
                  Background="Transparent"
                  ToolTip.Tip="{Binding Tooltip}">
                <DockPanel Grid.Column="0" Margin="14,0,8,0">
                    <Border DockPanel.Dock="Left"
                            Width="3"
                            Margin="0,5,8,5"
                            CornerRadius="1"
                            Background="{Binding Swatch}" />
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding Code}"
                                       MaxWidth="120"
                                       TextTrimming="CharacterEllipsis"
                                       FontFamily="Menlo, Consolas, monospace"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <!-- The Library's tags (#711 G3): New run before Expired. -->
                            <Border DockPanel.Dock="Right"
                                    Classes="ExpiredTag"
                                    IsVisible="{Binding IsExpiredTag}">
                                <TextBlock Text="{x:Static loc:Strings.Library_Tag_Expired}" />
                            </Border>
                            <Border DockPanel.Dock="Right"
                                    Classes="NewRunTag"
                                    IsVisible="{Binding IsNewRun}">
                                <TextBlock Text="{x:Static loc:Strings.Library_Tag_NewRun}" />
                            </Border>
                            <TextBlock Text="{Binding Sub}"
                                       Margin="6,0,6,0"
                                       FontSize="11"
                                       Opacity="0.6"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <!-- The layer time; with no data, a click jumps to the nearest data (D3). -->
                        <TextBlock Classes="LaneTime"
                                   Classes.warning="{Binding IsHidden}"
                                   Text="{Binding LayerTime}"
                                   FontFamily="Menlo, Consolas, monospace"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
                <!-- The lane's data: Library windows (dashed online, outlined on
                     disk) behind the loaded band; a click opens its actions (E5). -->
                <Panel Grid.Column="1"
                       Classes="LaneTrack"
                       Classes.actions="{Binding HasActions}"
                       Background="Transparent"
                       Margin="2,0,2,0">
                    <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="Top">
                            <StackPanel Spacing="6" MinWidth="220" x:DataType="vm:TimelineLaneViewModel">
                                <TextBlock Text="{Binding ActionTitle}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{Binding ActionDetail}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" MaxWidth="320" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                    <Button Classes="Primary"
                                            Height="28" MinHeight="0" Padding="12,0" FontSize="12"
                                            IsVisible="{Binding CanGet}"
                                            Content="{Binding GetText}"
                                            Command="{Binding GetCommand}" />
                                    <Button Classes="Outline"
                                            Height="28" MinHeight="0" Padding="12,0" FontSize="12"
                                            IsVisible="{Binding CanLoad}"
                                            Content="{x:Static loc:Strings.TimelinePanel_BandLoad}"
                                            Command="{Binding LoadCommand}" />
                                    <Button Classes="Ghost"
                                            Height="28" MinHeight="0" Padding="8,0" FontSize="12"
                                            Content="{x:Static loc:Strings.TimelinePanel_BandReveal}"
                                            Command="{Binding RevealCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                    <views:KnownBandControl Height="18"
                                            VerticalAlignment="Center"
                                            Stroke="{Binding Swatch}"
                                            OnlineBands="{Binding OnlineBands}"
                                            OnDiskBands="{Binding OnDiskBands}"
                                            Progress="{Binding Progress}" />
                    <views:CoverageBandControl Height="12"
                                               VerticalAlignment="Center"
                                               Fill="{Binding Swatch}"
                                               TrackBrush="#14808080"
                                               HatchBrush="#59A1A1AA"
                                               TickRise="0"
                                               BandCornerRadius="3"
                                               Bands="{Binding Bands}"
                                               Gaps="{Binding Gaps}" />
                </Panel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource BackgroundColor}"
            Padding="12,2"
            VerticalAlignment="Stretch">
        <Panel>
            <!-- Active state: timeline has at least one registered dataset.
                 The title-row readout and the slider/range body are grouped
                 so they only reserve layout space when active. When inactive,
                 the placeholder below fills (and centers within) the entire
                 timeline area rather than the leftover space under a docked
                 title row. -->
            <DockPanel LastChildFill="True"
                       IsVisible="{Binding IsActive}">

                <!-- Readout (#713 B1, B2): the mode pill, the view time and its
                     offset from now; Go live and the step buttons on the right. -->
                <Grid DockPanel.Dock="Top"
                      ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                      Margin="0,0,0,4">
                    <Border Grid.Column="0"
                            Classes="ModePill"
                            Classes.live="{Binding IsLive}"
                            CornerRadius="6"
                            Padding="7,2"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="7" Height="7"
                                     IsVisible="{Binding IsLive}"
                                     Fill="{DynamicResource SuccessColor}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ModeLabel}"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       LetterSpacing="0.6"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentTimeLabel}"
                               Margin="10,0,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               FontFamily="Menlo, Consolas, monospace"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding OffsetText}"
                               Margin="8,0,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center"
                                IsVisible="{Binding AreStepButtonsVisible}">
                        <!-- C7: previous / next data, flanking the step controls. -->
                        <Button Classes="Icon"
                                Command="{Binding PreviousDataCommand}"
                                ToolTip.Tip="{x:Static loc:Strings.Tooltip_TimelinePreviousData}">
                            <ic:FluentIcon Icon="Previous" IconVariant="Regular" FontSize="14" />
                        </Button>
                        <Button Classes="Icon"
                                Command="{Binding PreviousStepCommand}"
                                ToolTip.Tip="{x:Static loc:Strings.Tooltip_TimelinePreviousStep}">
                            <ic:FluentIcon Icon="ChevronLeft" IconVariant="Regular" FontSize="14" />
                        </Button>
                        <!-- C6: the step menu (built in code-behind: "Sample of ▸" lists the layers). -->
                        <Button x:Name="StepMenuButton"
                                Classes="Outline"
                                Height="28" MinHeight="0" Padding="8,0"
                                FontSize="12"
                                ToolTip.Tip="{x:Static loc:Strings.Tooltip_TimelineStep}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding StepLabel}" VerticalAlignment="Center" />
                                <ic:FluentIcon Icon="ChevronDown" IconVariant="Regular" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="Icon"
                                Command="{Binding NextStepCommand}"
                                ToolTip.Tip="{x:Static loc:Strings.Tooltip_TimelineNextStep}">
                            <ic:FluentIcon Icon="ChevronRight" IconVariant="Regular" FontSize="14" />
                        </Button>
                        <Button Classes="Icon"
                                Command="{Binding NextDataCommand}"
                                ToolTip.Tip="{x:Static loc:Strings.Tooltip_TimelineNextData}">
                            <ic:FluentIcon Icon="Next" IconVariant="Regular" FontSize="14" />
                        </Button>
                        <!-- Go live (A1): shown while pinned. -->
                        <Button Classes="Primary"
                                IsVisible="{Binding !IsLive}"
                                Height="28" MinHeight="0" Padding="12,0" Margin="6,0,0,0"
                                FontSize="12"
                                Content="{x:Static loc:Strings.TimelinePanel_GoLive}"
                                Command="{Binding NowCommand}"
                                ToolTip.Tip="{x:Static loc:Strings.Tooltip_TimelineNow}" />
                        <!-- C5: the window presets. -->
                        <Button x:Name="PresetMenuButton"
                                Classes="Outline"
                                Height="28" MinHeight="0" Padding="8,0" Margin="6,0,0,0"
                                FontSize="12"
                                ToolTip.Tip="{x:Static loc:Strings.Tooltip_TimelinePreset}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding PresetLabel}" VerticalAlignment="Center" />
                                <ic:FluentIcon Icon="ChevronDown" IconVariant="Regular" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Body: the slider, coverage band and status line. -->
                <DockPanel LastChildFill="True">

                    <Grid x:Name="AxisArea"
                          DockPanel.Dock="Top"
                          Background="Transparent"
                          ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <!-- E1: the summary row's label and the In map view
                             filter (E4), over the lanes' label column. -->
                        <StackPanel Grid.Column="0"
                                    Grid.Row="1"
                                    Grid.RowSpan="4"
                                    Width="248"
                                    Spacing="2"
                                    IsVisible="{Binding ShowLanes}"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding SummaryLabel, Converter={x:Static conv:ToUpperConverter.Instance}}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       LetterSpacing="0.6"
                                       Opacity="0.6" />
                            <CheckBox IsVisible="{Binding IsInMapViewAvailable}"
                                      IsChecked="{Binding IsInMapView}"
                                      Content="{x:Static loc:Strings.TimelinePanel_InMapView}"
                                      FontSize="12"
                                      ToolTip.Tip="{x:Static loc:Strings.Tooltip_TimelineInMapView}" />
                            <!-- #711 E2: what the Library knows but has not loaded. -->
                            <CheckBox IsVisible="{Binding IsShowOnlineAvailable}"
                                      IsChecked="{Binding ShowOnline}"
                                      Content="{x:Static loc:Strings.TimelinePanel_ShowOnline}"
                                      FontSize="12"
                                      ToolTip.Tip="{x:Static loc:Strings.Tooltip_TimelineShowOnline}" />
                        </StackPanel>
                        <!-- C5: the overview strip: everything loaded, and the shown window. -->
                        <views:OverviewStripControl Grid.Row="0" Grid.Column="1"
                                                    Height="6"
                                                    Margin="2,0,2,4"
                                                    Bands="{Binding OverviewBands}"
                                                    WindowStart="{Binding OverviewWindowStart}"
                                                    WindowWidth="{Binding OverviewWindowWidth}"
                                                    Fill="#59A1A1AA"
                                                    Bracket="{DynamicResource ForegroundColor}" />
                        <!-- A strip for the NOW label (every timeline, A2). -->
                        <Panel Grid.Row="1" Grid.Column="1" Height="14" />
                        <Slider Grid.Row="2" Grid.Column="1"
                                Foreground="{DynamicResource AccentBrush}"
                                Minimum="{Binding SliderMinimum, Mode=OneWay}"
                                Maximum="{Binding SliderMaximum, Mode=OneWay}"
                                Value="{Binding SliderValue, Mode=TwoWay}"
                                SmallChange="0.01"
                                LargeChange="0.1"
                                Ticks="{Binding Ticks, Mode=OneWay}"
                                TickFrequency="{Binding TickFrequency, Mode=OneWay}"
                                IsSnapToTickEnabled="{Binding IsSnapToTickEnabled, Mode=OneWay}"
                                TickPlacement="BottomRight"
                                ToolTip.Tip="{x:Static loc:Strings.Tooltip_TimelineSlider}" />
                        <!-- C2: the slider's track breaks at each collapsed gap. -->
                        <views:GapBreakControl Grid.Row="2" Grid.Column="1"
                                               Margin="2,0,2,0"
                                               Height="12"
                                               VerticalAlignment="Center"
                                               Gaps="{Binding Gaps}"
                                               Fill="{DynamicResource BackgroundColor}"
                                               Edge="#A1A1AA" />
                        <!-- Data-coverage band: data filled, collapsed gaps
                             hatched (with their length and ends on hover).
                             Inset by 2px to line up with the slider's track. -->
                        <views:CoverageBandControl x:Name="Band" Grid.Column="1"
                                                   Grid.Row="3"
                                                   Opacity="{Binding BandOpacity}"
                                                   Height="12"
                                                   Margin="2,2,2,0"
                                                   Fill="{DynamicResource AccentBrush}"
                                                   TrackBrush="#33808080"
                                                   HatchBrush="#59A1A1AA"
                                                   TickBrush="{DynamicResource AccentBrush}"
                                                   TickThickness="1.5"
                                                   TickRise="4"
                                                   Bands="{Binding CoverageBands, Mode=OneWay}"
                                                   Gaps="{Binding Gaps, Mode=OneWay}"
                                                   ToolTip.Tip="{x:Static loc:Strings.Tooltip_TimelineCoverageBand}" />
                        <!-- C3: gap, day and 6-hour labels. -->
                        <views:AxisLabelsControl Grid.Row="4" Grid.Column="1"
                                                 Height="14"
                                                 Margin="2,3,2,0"
                                                 Labels="{Binding AxisLabels}"
                                                 Foreground="{DynamicResource ForegroundColor}"
                                                 Muted="#A1A1AA" />
                        <!-- The NOW line: a dashed line through the slider and the band. -->
                        <views:NowMarkerControl Grid.Row="1" Grid.Column="1"
                                                Grid.RowSpan="3"
                                                Margin="2,0,2,0"
                                                Position="{Binding NowPosition}"
                                                Label="{x:Static loc:Strings.TimelinePanel_NowLabel}"
                                                Stroke="{DynamicResource ForegroundColor}" />
                    </Grid>

                    <!-- Status line (B3): the range on the left; one message
                         with its action on the right. -->
                    <Grid DockPanel.Dock="Bottom"
                          ColumnDefinitions="*,Auto"
                          Margin="0,4,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding RangeLabel}"
                                   FontSize="11"
                                   Opacity="0.6"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="12,0,0,0"
                                    IsVisible="{Binding HasStatusMessage}">
                            <!-- D4: "No data … for N of M layers" opens the layer list on the first hidden layer. -->
                            <Button Classes="StatusText"
                                    Content="{Binding StatusMessage}"
                                    Command="{Binding ShowLayersCommand}"
                                    IsHitTestVisible="{Binding IsStatusWarning}"
                                    ToolTip.Tip="{x:Static loc:Strings.Tooltip_TimelineShowLayers}"
                                    Classes.error="{Binding IsStatusError}"
                                    Classes.warning="{Binding IsStatusWarning}"
                                    Classes.drawing="{Binding IsDrawing}"
                                    VerticalAlignment="Center" />
                            <Button Classes="Ghost"
                                    IsVisible="{Binding HasStatusAction}"
                                    Content="{Binding StatusActionText}"
                                    Command="{Binding StatusActionCommand}"
                                    Padding="6,0" Height="22" MinHeight="0"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Classes.error="{Binding IsStatusError}"
                                    Classes.warning="{Binding IsStatusWarning}"
                                    VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Lanes (#710, handoff Part E): one per layer, grouped by
                         product, with NOW and the view time through all of them. -->
                    <ScrollViewer IsVisible="{Binding ShowLanes}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,4,0,0">
                        <Grid x:Name="LanesHost"
                              ColumnDefinitions="248,*"
                              Background="Transparent">
                            <StackPanel Grid.ColumnSpan="2">
                                <ItemsControl ItemsSource="{Binding LaneGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TimelineLaneGroupViewModel">
                                            <StackPanel>
                                                <Button Classes="LaneGroup" Command="{Binding ToggleCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <ic:FluentIcon Icon="ChevronDown" IconVariant="Regular" FontSize="10" VerticalAlignment="Center" IsVisible="{Binding IsExpanded}" />
                                                        <ic:FluentIcon Icon="ChevronRight" IconVariant="Regular" FontSize="10" VerticalAlignment="Center" IsVisible="{Binding !IsExpanded}" />
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Count}" Opacity="0.6" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <ItemsControl ItemsSource="{Binding Lanes}"
                                                              IsVisible="{Binding IsExpanded}"
                                                              ItemTemplate="{StaticResource LaneTemplate}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- E4: the layers outside the map view, folded into one row. -->
                                <StackPanel IsVisible="{Binding HasOutsideLanes}">
                                    <Grid ColumnDefinitions="248,*" Height="28">
                                        <Button Classes="LaneGroup"
                                                Command="{Binding ToggleOutsideCommand}"
                                                ToolTip.Tip="{x:Static loc:Strings.Tooltip_TimelineOutsideMapView}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ic:FluentIcon Icon="ChevronDown" IconVariant="Regular" FontSize="10" VerticalAlignment="Center" IsVisible="{Binding IsOutsideExpanded}" />
                                                <ic:FluentIcon Icon="ChevronRight" IconVariant="Regular" FontSize="10" VerticalAlignment="Center" IsVisible="{Binding !IsOutsideExpanded}" />
                                                <TextBlock Text="{Binding OutsideLabel}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <views:CoverageBandControl Grid.Column="1"
                                                                   Height="10"
                                                                   Margin="2,0,2,0"
                                                                   VerticalAlignment="Center"
                                                                   Fill="#A1A1AA"
                                                                   TickRise="0"
                                                                   BandCornerRadius="3"
                                                                   Bands="{Binding OutsideBands}"
                                                                   Gaps="{Binding Gaps}"
                                                                   HatchBrush="#59A1A1AA" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding OutsideLanes}"
                                                  IsVisible="{Binding IsOutsideExpanded}"
                                                  Opacity="0.7"
                                                  ItemTemplate="{StaticResource LaneTemplate}" />
                                </StackPanel>
                            </StackPanel>
                            <!-- E3: NOW (dashed) and the view time (2 px accent) through every lane. -->
                            <views:NowMarkerControl Grid.Column="1"
                                                    Margin="2,0,2,0"
                                                    LabelHeight="0"
                                                    Position="{Binding NowPosition}"
                                                    Stroke="{DynamicResource ForegroundColor}" />
                            <views:NowMarkerControl Grid.Column="1"
                                                    Margin="2,0,2,0"
                                                    LabelHeight="0"
                                                    IsDashed="False"
                                                    Thickness="2"
                                                    Opacity="0.55"
                                                    Position="{Binding SliderValue}"
                                                    Stroke="{DynamicResource AccentBrush}" />
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>

            <!-- Empty state: timeline pane is open but no time-varying
                 dataset is loaded. Fills the whole timeline area so its
                 content is centered, not offset below the title row. -->
            <views:PlaceholderView IsVisible="{Binding !IsActive}"
                                   Icon="Clock"
                                   Header="{x:Static loc:Strings.TimelinePanel_EmptyTitle}"
                                   Description="{x:Static loc:Strings.TimelinePanel_EmptyDescription}" />
        </Panel>
    </Border>
</UserControl>

