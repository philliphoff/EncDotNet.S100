<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:EncDotNet.S100.Viewer.ViewModels"
             xmlns:loc="using:EncDotNet.S100.Viewer.Resources"
             xmlns:bh="using:EncDotNet.S100.Viewer.Behaviors"
             xmlns:views="using:EncDotNet.S100.Viewer.Views"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             x:Class="EncDotNet.S100.Viewer.Views.LibraryPanelView"
             x:DataType="vm:LibraryPanelViewModel">

    <UserControl.Styles>
        <!-- Mirror of the main window's `GridSplitter.PaneSplitter` style;
             UserControls don't inherit window-scoped styles. -->
        <Style Selector="GridSplitter.PaneSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="GridSplitter.PaneSplitter.hovered">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="GridSplitter.PaneSplitter:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- Secondary-state tags on dataset rows: small sentence-case pills. -->
        <Style Selector="Border.libraryTag">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="{DynamicResource LibraryTagHeight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        </Style>
        <Style Selector="Border.libraryTag > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.libraryTag.update">
            <Setter Property="Background" Value="{DynamicResource LibraryTagWarningBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LibraryTagWarningBorder}" />
        </Style>
        <Style Selector="Border.libraryTag.update > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
        </Style>
        <Style Selector="Border.libraryTag.loaded">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
        </Style>
        <Style Selector="Border.libraryTag.loaded > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundColor}" />
        </Style>
        <Style Selector="Border.libraryTag.queued">
            <Setter Property="Background" Value="{DynamicResource MutedBackgroundColor}" />
        </Style>
        <Style Selector="Border.libraryTag.queued > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
        </Style>
        <Style Selector="Border.libraryTag.failed">
            <Setter Property="Background" Value="{DynamicResource LibraryTagErrorBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LibraryTagErrorBorder}" />
        </Style>
        <Style Selector="Border.libraryTag.failed > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ErrorColor}" />
        </Style>
        <!-- The state segments under the filter box. -->
        <Style Selector="Border.librarySegments">
            <Setter Property="Background" Value="{DynamicResource MutedBackgroundColor}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style Selector="RadioButton.librarySegment">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Segment" CornerRadius="6" MinHeight="30" Padding="6,0" Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.librarySegment:checked /template/ Border#PART_Segment">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
            <Setter Property="BoxShadow" Value="0 1 2 0 #22000000" />
        </Style>
        <Style Selector="RadioButton.librarySegment:not(:checked)">
            <Setter Property="Opacity" Value="0.75" />
        </Style>

        <!-- Details pane: small uppercase group headers, mono values, click-to-copy. -->
        <Style Selector="TextBlock.libraryGroupHeader">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="SelectableTextBlock.mono">
            <Setter Property="FontFamily" Value="{DynamicResource LibraryMonoFont}" />
        </Style>
        <Style Selector="SelectableTextBlock.copyable">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Tree: a small bordered mono tag for the source kind, and a status dot. -->
        <Style Selector="Border.libraryKindTag">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="MinHeight" Value="20" />
        </Style>
        <!-- A group node keeps the tag's width, so names line up, but shows no tag. -->
        <Style Selector="Border.libraryKindTag.empty">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.libraryKindTag > TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource LibraryMonoFont}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.libraryStatusDot">
            <Setter Property="Fill" Value="{DynamicResource MutedColor}" />
        </Style>
        <Style Selector="Ellipse.libraryStatusDot.busy">
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Ellipse.libraryStatusDot.warning">
            <Setter Property="Fill" Value="{DynamicResource WarningColor}" />
        </Style>
        <Style Selector="Ellipse.libraryStatusDot.error">
            <Setter Property="Fill" Value="{DynamicResource ErrorColor}" />
        </Style>
        <Style Selector="Ellipse.libraryStatusDot.ok">
            <Setter Property="Fill" Value="{DynamicResource SuccessColor}" />
        </Style>

        <!-- Rows: dataset codes in monospace; datasets of an unpacked package indented. -->
        <Style Selector="TextBlock.libraryRowName.mono">
            <Setter Property="FontFamily" Value="{DynamicResource LibraryMonoFont}" />
        </Style>
        <Style Selector="Border.libraryRow.groupChild">
            <Setter Property="Margin" Value="20,0,0,0" />
        </Style>
        <!-- An unpacked package's header row sits on a muted surface. -->
        <Style Selector="Border.libraryRow.groupHeader">
            <Setter Property="Background" Value="{DynamicResource MutedBackgroundColor}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style Selector="ListBox#ItemList ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
        </Style>

        <!-- Tree rows: taller, with room for the optional status line; the selection
             treatment comes from the app-wide accentTree style. -->
        <Style Selector="TreeView.libraryTree TreeViewItem">
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <!-- Toolbar and filter icon buttons: one 36 × 36 box for Button and ToggleButton
             alike (ShadUI's Icon class only sizes Button). -->
        <Style Selector="Button.libraryIcon, ToggleButton.libraryIcon">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- The details header's 32 × 32 icon actions. -->
        <Style Selector="Button.libraryHeaderAction">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- The bulk bar's compact buttons. -->
        <Style Selector="Button.libraryCompact">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Empty state's large targets. -->
        <Style Selector="Button.libraryQuickAction">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <!-- Non-interactive group headers in the Add menu. -->
        <Style Selector="MenuItem.libraryMenuHeader">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <!-- The coverage toggle reads as selected when on. -->
        <Style Selector="ToggleButton.coverageToggle:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.libraryTag.clickable">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <FontFamily x:Key="LibraryMonoFont">Cascadia Mono,Consolas,Menlo,monospace</FontFamily>
        <!-- Sizes that differ from the ShadUI defaults (14 px body text, 36 px controls). -->
        <x:Double x:Key="LibrarySecondaryFontSize">13</x:Double>
        <x:Double x:Key="LibraryTagHeight">22</x:Double>
        <!-- Tints for tags, from the theme's warning and error colours. -->
        <SolidColorBrush x:Key="LibraryTagWarningBackground" Color="{DynamicResource WarningColor}" Opacity="0.10" />
        <SolidColorBrush x:Key="LibraryTagWarningBorder" Color="{DynamicResource WarningColor}" Opacity="0.35" />
        <SolidColorBrush x:Key="LibraryTagErrorBackground" Color="{DynamicResource ErrorColor}" Opacity="0.08" />
        <SolidColorBrush x:Key="LibraryTagErrorBorder" Color="{DynamicResource ErrorColor}" Opacity="0.35" />

        <!-- A dataset's secondary-state tags. -->
        <DataTemplate x:Key="LibraryTagTemplate" x:DataType="vm:LibraryItemTag">
            <Border Classes="libraryTag"
                    Classes.update="{Binding IsUpdate}"
                    Classes.loaded="{Binding IsLoaded}"
                    Classes.queued="{Binding IsQueued}"
                    Classes.failed="{Binding IsFailed}"
                    Classes.clickable="{Binding IsClickable}"
                    Tapped="OnTagTapped">
                <TextBlock Text="{Binding Text}" />
            </Border>
        </DataTemplate>
        <!-- The "Add to Library" menu, shared by the toolbar and the empty state,
             grouped by where the data is. -->
        <MenuFlyout x:Key="AddMenu" Placement="BottomEdgeAlignedLeft">
            <MenuItem Header="{x:Static loc:Strings.Library_AddMenu_ThisComputer}" Classes="libraryMenuHeader" IsEnabled="False"  AutomationProperties.AutomationId="Library.AddMenu.ThisComputer"/>
            <MenuItem Header="{x:Static loc:Strings.Menu_AddLibraryFolder}" Command="{Binding AddFolderCommand}"  AutomationProperties.AutomationId="Library.AddMenu.Folder"/>
            <MenuItem Header="{x:Static loc:Strings.Menu_AddLibraryExchangeSetZip}" Command="{Binding AddExchangeSetZipCommand}"  AutomationProperties.AutomationId="Library.AddMenu.ExchangeSet"/>
            <MenuItem Header="{x:Static loc:Strings.Menu_AddLibraryS128}" Command="{Binding AddS128CatalogueCommand}"  AutomationProperties.AutomationId="Library.AddMenu.S128Catalogue"/>
            <MenuItem Header="{x:Static loc:Strings.Menu_AddLibraryManifest}" Command="{Binding AddCollectionManifestCommand}"  AutomationProperties.AutomationId="Library.AddMenu.Manifest"/>
            <Separator />
            <MenuItem Header="{x:Static loc:Strings.Library_AddMenu_Online}" Classes="libraryMenuHeader" IsEnabled="False"  AutomationProperties.AutomationId="Library.AddMenu.Online"/>
            <MenuItem Header="{x:Static loc:Strings.Menu_AddLibraryOnlineCatalogue}" Command="{Binding AddOnlineCatalogueCommand}"  AutomationProperties.AutomationId="Library.AddMenu.OnlineCatalogue"/>
            <Separator />
            <MenuItem Header="{x:Static loc:Strings.Library_AddMenu_AnotherComputer}" Classes="libraryMenuHeader" IsEnabled="False"  AutomationProperties.AutomationId="Library.AddMenu.AnotherComputer"/>
            <MenuItem Header="{x:Static loc:Strings.Menu_AddLibrarySharedFeed}" Command="{Binding AddSharedFeedCommand}"  AutomationProperties.AutomationId="Library.AddMenu.SharedFeed"/>
        </MenuFlyout>

        <!-- Rarely used, destructive actions live here rather than on the toolbar. -->
        <MenuFlyout x:Key="MoreMenu" Placement="BottomEdgeAlignedRight">
            <MenuItem Header="{x:Static loc:Strings.Menu_LibraryRefreshAll}" Command="{Binding RefreshAllCommand}"  AutomationProperties.AutomationId="Library.MoreMenu.RefreshAll"/>
            <MenuItem Header="{x:Static loc:Strings.Menu_LibraryRename}" Command="{Binding RenameCommand}"  AutomationProperties.AutomationId="Library.MoreMenu.Rename"/>
            <Separator />
            <MenuItem Header="{x:Static loc:Strings.Menu_LibraryRemove}" Command="{Binding RemoveCommand}"  AutomationProperties.AutomationId="Library.MoreMenu.Remove"/>
        </MenuFlyout>

        <!-- The tree's context menu acts on the selected node; the tree selects a node on right-press, so that is the one right-clicked. -->
        <ContextMenu x:Key="NodeMenu">
            <MenuItem Header="{x:Static loc:Strings.Menu_LibraryKeep}" Command="{Binding KeepInLibraryCommand}"
                      AutomationProperties.AutomationId="Library.NodeMenu.Keep"
                      IsVisible="{Binding SelectedNode.CanKeep, FallbackValue=False}" />
            <MenuItem Header="{x:Static loc:Strings.Menu_LibraryRefresh}" Command="{Binding RefreshCommand}"
                      AutomationProperties.AutomationId="Library.NodeMenu.Refresh"
                      IsVisible="{Binding !SelectedNode.IsGroup, FallbackValue=True}" />
            <MenuItem Header="{x:Static loc:Strings.Menu_LibraryRefreshSource}" Command="{Binding RefreshCommand}"
                      AutomationProperties.AutomationId="Library.NodeMenu.RefreshSource"
                      IsVisible="{Binding SelectedNode.IsGroup, FallbackValue=False}" />
            <MenuItem Header="{x:Static loc:Strings.Menu_LibraryChooseGroups}" Command="{Binding ChooseGroupsCommand}"
                      AutomationProperties.AutomationId="Library.NodeMenu.ChooseGroups"
                      IsVisible="{Binding SelectedNode.CanChooseGroups, FallbackValue=False}" />
            <MenuItem Header="{x:Static loc:Strings.Menu_LibraryAddCurrents}" Command="{Binding AddCurrentsForAreaCommand}"
                      AutomationProperties.AutomationId="Library.NodeMenu.AddCurrents"
                      IsVisible="{Binding CanAddCurrentsForArea}" />
            <MenuItem Header="{x:Static loc:Strings.Menu_LibraryRename}" Command="{Binding RenameCommand}"
                      AutomationProperties.AutomationId="Library.NodeMenu.Rename"
                      IsVisible="{Binding !SelectedNode.IsGroup, FallbackValue=True}" />
            <MenuItem Header="{x:Static loc:Strings.Menu_LibraryCopyUrl}" Click="OnCopySourceUrl"
                      AutomationProperties.AutomationId="Library.NodeMenu.CopyUrl"
                      IsVisible="{Binding SelectedNode.HasSourceUrl, FallbackValue=False}" />
            <Separator IsVisible="{Binding !SelectedNode.IsGroup, FallbackValue=True}" />
            <MenuItem Header="{x:Static loc:Strings.Menu_LibraryRemove}" Command="{Binding RemoveCommand}"
                      AutomationProperties.AutomationId="Library.NodeMenu.Remove"
                      IsVisible="{Binding !SelectedNode.IsGroup, FallbackValue=True}" />
        </ContextMenu>
    </UserControl.Resources>

    <Panel>
        <!-- Empty state: the most common ways in, as large targets. -->
        <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" Spacing="10" Margin="16,0">
            <TextBlock Text="{x:Static loc:Strings.Library_EmptyTitle}" FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{x:Static loc:Strings.Library_EmptyDescription}" FontSize="{StaticResource LibrarySecondaryFontSize}" Opacity="0.7"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,6" />
            <Button Classes="Outline libraryQuickAction" Command="{Binding AddFolderCommand}"
                    AutomationProperties.Name="{x:Static loc:Strings.Library_Quick_Folder}"
                    AutomationProperties.HelpText="{x:Static loc:Strings.Library_Quick_FolderSub}"
                    AutomationProperties.AutomationId="Library.Quick.Folder">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Grid.Column="0" Classes="libraryKindTag"><TextBlock Text="DIR" /></Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Static loc:Strings.Library_Quick_Folder}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static loc:Strings.Library_Quick_FolderSub}" FontSize="{StaticResource LibrarySecondaryFontSize}" FontWeight="Normal" Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>
            <Button Classes="Outline libraryQuickAction" Command="{Binding AddOnlineCatalogueCommand}"
                    AutomationProperties.Name="{x:Static loc:Strings.Library_Quick_Online}"
                    AutomationProperties.HelpText="{x:Static loc:Strings.Library_Quick_OnlineSub}"
                    AutomationProperties.AutomationId="Library.Quick.Online">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Grid.Column="0" Classes="libraryKindTag"><TextBlock Text="WEB" /></Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Static loc:Strings.Library_Quick_Online}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static loc:Strings.Library_Quick_OnlineSub}" FontSize="{StaticResource LibrarySecondaryFontSize}" FontWeight="Normal" Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>
            <Button Classes="Outline libraryQuickAction" Command="{Binding AddSharedFeedCommand}"
                    AutomationProperties.Name="{x:Static loc:Strings.Library_Quick_Feed}"
                    AutomationProperties.HelpText="{x:Static loc:Strings.Library_Quick_FeedSub}"
                    AutomationProperties.AutomationId="Library.Quick.Feed">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Grid.Column="0" Classes="libraryKindTag"><TextBlock Text="FEED" /></Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Static loc:Strings.Library_Quick_Feed}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static loc:Strings.Library_Quick_FeedSub}" FontSize="{StaticResource LibrarySecondaryFontSize}" FontWeight="Normal" Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>
            <Button Classes="Outline libraryQuickAction" Command="{Binding AddCollectionManifestCommand}"
                    AutomationProperties.Name="{x:Static loc:Strings.Library_Quick_Manifest}"
                    AutomationProperties.HelpText="{x:Static loc:Strings.Library_Quick_ManifestSub}"
                    AutomationProperties.AutomationId="Library.Quick.Manifest">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Grid.Column="0" Classes="libraryKindTag"><TextBlock Text="JSON" /></Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Static loc:Strings.Library_Quick_Manifest}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static loc:Strings.Library_Quick_ManifestSub}" FontSize="{StaticResource LibrarySecondaryFontSize}" FontWeight="Normal" Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>
            <TextBlock Text="{x:Static loc:Strings.Library_DropHint}" FontSize="{StaticResource LibrarySecondaryFontSize}" Opacity="0.55"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <Grid x:Name="PanelGrid" IsVisible="{Binding !IsEmpty}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="60" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="100" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="60" />
            </Grid.RowDefinitions>

            <!-- Toolbar: a labelled Add menu; refresh, coverage and an overflow on the right.
                 (The dock's own header already says "LIBRARY".) -->
            <DockPanel Grid.Row="0" Margin="6,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                    <Button Classes="Icon libraryIcon"
                            AutomationProperties.AutomationId="Library.Refresh"
                            AutomationProperties.Name="{x:Static loc:Strings.Tooltip_RefreshLibrary}"
                            Command="{Binding RefreshCommand}"
                            ToolTip.Tip="{x:Static loc:Strings.Tooltip_RefreshLibrary}">
                        <ic:FluentIcon Icon="ArrowSync" FontSize="16" />
                    </Button>
                    <ToggleButton Classes="Icon libraryIcon coverageToggle"
                                  AutomationProperties.AutomationId="Library.ShowCoverage"
                                  AutomationProperties.Name="{x:Static loc:Strings.Label_ShowCoverage}"
                                  AutomationProperties.HelpText="{x:Static loc:Strings.Tooltip_ShowCoverage}"
                                  IsChecked="{Binding ShowCoverage}"
                                  ToolTip.Tip="{x:Static loc:Strings.Tooltip_ShowCoverage}">
                        <ic:FluentIcon Icon="Map" FontSize="16" />
                    </ToggleButton>
                    <Button Classes="Icon libraryIcon"
                            AutomationProperties.AutomationId="Library.More"
                            AutomationProperties.Name="{x:Static loc:Strings.Tooltip_LibraryMore}"
                            Flyout="{StaticResource MoreMenu}"
                            ToolTip.Tip="{x:Static loc:Strings.Tooltip_LibraryMore}">
                        <ic:FluentIcon Icon="MoreHorizontal" FontSize="16" />
                    </Button>
                </StackPanel>
                <Button Classes="Secondary" HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="Library.Add"
                        AutomationProperties.Name="{x:Static loc:Strings.Library_AddButton}"
                        AutomationProperties.HelpText="{x:Static loc:Strings.Tooltip_AddToLibrary}"
                        ToolTip.Tip="{x:Static loc:Strings.Tooltip_AddToLibrary}"
                        Flyout="{StaticResource AddMenu}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ic:FluentIcon Icon="Add" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static loc:Strings.Library_AddButton}" VerticalAlignment="Center" />
                        <ic:FluentIcon Icon="ChevronDown" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- Collections and their sources: sized to its content (up to about 40 % of the
                 panel, see code-behind) until the user drags the splitter. -->
            <TreeView Grid.Row="1"
                      x:Name="CollectionTree"
                      AutomationProperties.AutomationId="Library.Tree"
                      Classes="accentTree libraryTree"
                      Margin="4,0"
                      ItemsSource="{Binding Nodes}"
                      SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                      ContextMenu="{StaticResource NodeMenu}"
                      Background="Transparent"
                      BorderThickness="0">
                <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="vm:LibraryNodeViewModel">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:LibraryNodeViewModel" ItemsSource="{Binding Children}">
                        <!-- Kind tag, name, count; a second line only when something is off-normal. -->
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8"
                              MinHeight="20" Background="Transparent"
                              ToolTip.Tip="{Binding Tooltip}">
                            <!-- Centred on the first line (row 0), also when a status line follows. -->
                            <Border Grid.Column="0" Classes="libraryKindTag" Classes.empty="{Binding !HasKindTag}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding KindTag}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                       IsVisible="{Binding !IsRenaming}"
                                       FontWeight="{Binding IsCollection, Converter={x:Static views:LibraryPanelView.BoolToWeight}}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding RenameText}"
                                     AutomationProperties.Name="{x:Static loc:Strings.Library_RenameBox}"
                                     AutomationProperties.AutomationId="Library.Tree.RenameBox"
                                     IsVisible="{Binding IsRenaming}"
                                     Padding="4,1" MinHeight="0"
                                     AttachedToVisualTree="OnRenameBoxAttached">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter"
                                                Command="{Binding $parent[TreeView].((vm:LibraryPanelViewModel)DataContext).CommitRenameCommand}" />
                                    <KeyBinding Gesture="Escape"
                                                Command="{Binding $parent[TreeView].((vm:LibraryPanelViewModel)DataContext).CancelRenameCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <TextBlock Grid.Column="2" Text="{Binding Status}"
                                       FontSize="{StaticResource LibrarySecondaryFontSize}"
                                       Foreground="{DynamicResource ForegroundColor}" Opacity="0.6" VerticalAlignment="Center" />
                            <!-- A manifest source named like its collection shows its file name. -->
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SecondaryName}"
                                       IsVisible="{Binding HasSecondaryName}" Margin="0,1,0,0"
                                       FontSize="{StaticResource LibrarySecondaryFontSize}"
                                       Foreground="{DynamicResource ForegroundColor}" Opacity="0.55"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding HasStatusLine}" Margin="0,2,0,0">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Classes="libraryStatusDot"
                                         Classes.busy="{Binding IsStatusBusy}"
                                         Classes.warning="{Binding IsStatusWarning}"
                                         Classes.error="{Binding IsStatusError}"
                                         Classes.ok="{Binding IsStatusOk}" />
                                <TextBlock Text="{Binding StatusLine}" FontSize="{StaticResource LibrarySecondaryFontSize}"
                                           Foreground="{DynamicResource ForegroundColor}" Opacity="0.7"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <Border Grid.Row="2" Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    IsHitTestVisible="False" Background="{DynamicResource BorderColor}" />
            <GridSplitter Grid.Row="2"
                          x:Name="TreeSplitter"
                          Classes="PaneSplitter"
                          Height="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          bh:HoverDelay.DelayMilliseconds="500"
                          bh:SplitterPersistence.SavedFraction="{Binding $parent[shadui:Window].((vm:MainViewModel)DataContext).CatalogInnerSplit, Mode=TwoWay}" />

            <!-- Datasets of the selected node -->
            <DockPanel Grid.Row="3">
                <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="8,6,8,4">
                    <!-- After a map tap: the tap selected one of the outlined datasets there and left the list
                         alone. Step through them, or list every dataset at the point ("List these"). -->
                    <Panel IsVisible="{Binding HasTap}">
                        <Border Background="{DynamicResource AccentBrush}" Opacity="0.06" CornerRadius="6" />
                        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Opacity="0.3" CornerRadius="6" />
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6" Margin="8,2,2,2">
                            <ic:FluentIcon Grid.Column="0" Icon="Location" FontSize="14"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource LibrarySecondaryFontSize}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding TapHitsText}" FontWeight="SemiBold" />
                                <Run Text="{Binding TapPositionText}" />
                            </TextBlock>
                            <Button Grid.Column="2" Classes="Ghost" Padding="6,0" FontSize="{StaticResource LibrarySecondaryFontSize}"
                                    AutomationProperties.AutomationId="Library.Tap.Next"
                                    Content="{x:Static loc:Strings.Library_LocationNext}"
                                    Command="{Binding NextTapHitCommand}" />
                            <Button Grid.Column="3" Classes="Ghost" Padding="6,0" FontSize="{StaticResource LibrarySecondaryFontSize}"
                                    AutomationProperties.AutomationId="Library.Tap.ListAll"
                                    Content="{x:Static loc:Strings.Library_TapListThese}"
                                    Command="{Binding ListTapHitsCommand}" />
                            <Button Grid.Column="4" Classes="Icon" Padding="2" Command="{Binding ClearTapCommand}"
                                    AutomationProperties.AutomationId="Library.Tap.Clear"
                                    AutomationProperties.Name="{x:Static loc:Strings.Tooltip_ClearTap}"
                                    ToolTip.Tip="{x:Static loc:Strings.Tooltip_ClearTap}">
                                <ic:FluentIcon Icon="Dismiss" FontSize="12" />
                            </Button>
                        </Grid>
                    </Panel>
                    <!-- After "List these": how many datasets cover the point, and a way to step through them. -->
                    <!-- A thin accent outline over a faint accent wash (both follow the user's accent colour). -->
                    <Panel IsVisible="{Binding HasLocation}" ToolTip.Tip="{Binding LocationSummary}">
                        <Border Background="{DynamicResource AccentBrush}" Opacity="0.06" CornerRadius="6" />
                        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Opacity="0.3" CornerRadius="6" />
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6" Margin="8,2,2,2">
                            <ic:FluentIcon Grid.Column="0" Icon="Location" FontSize="14"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource LibrarySecondaryFontSize}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding LocationHitsText}" FontWeight="SemiBold" />
                                <Run Text="{Binding LocationCoverText}" />
                            </TextBlock>
                            <TextBlock Grid.Column="2" Text="{Binding LocationPositionText}" FontSize="{StaticResource LibrarySecondaryFontSize}" Opacity="0.6"
                                       FontFamily="{StaticResource LibraryMonoFont}" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Classes="Ghost" Padding="6,0" FontSize="{StaticResource LibrarySecondaryFontSize}"
                                    AutomationProperties.AutomationId="Library.Location.Next"
                                    Content="{x:Static loc:Strings.Library_LocationNext}"
                                    Command="{Binding NextAtLocationCommand}" />
                            <Button Grid.Column="4" Classes="Icon" Padding="2" Command="{Binding ClearLocationCommand}"
                                    AutomationProperties.AutomationId="Library.Location.Clear"
                                    AutomationProperties.Name="{x:Static loc:Strings.Tooltip_ClearLocation}"
                                    ToolTip.Tip="{x:Static loc:Strings.Tooltip_ClearLocation}">
                                <ic:FluentIcon Icon="Dismiss" FontSize="12" />
                            </Button>
                        </Grid>
                    </Panel>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                        <TextBox Grid.Column="0" Text="{Binding FilterText}"
                                 AutomationProperties.Name="{x:Static loc:Strings.Label_Filter}"
                                 AutomationProperties.HelpText="{x:Static loc:Strings.Library_FilterWatermark}"
                                 AutomationProperties.AutomationId="Library.Filter"
                                 PlaceholderText="{x:Static loc:Strings.Library_FilterWatermark}">
                            <TextBox.InnerRightContent>
                                <TextBlock Text="{Binding ItemsSummary}" FontSize="{StaticResource LibrarySecondaryFontSize}" Opacity="0.6"
                                           VerticalAlignment="Center" Margin="4,0,8,0" />
                            </TextBox.InnerRightContent>
                        </TextBox>
                        <!-- #711 G2: only data valid at the Timeline's view time (with any segment). -->
                        <ToggleButton Grid.Column="1" Classes="Icon libraryIcon coverageToggle"
                                      AutomationProperties.AutomationId="Library.AtViewTime"
                                      IsVisible="{Binding HasViewTime}"
                                      IsChecked="{Binding IsAtViewTime}"
                                      ToolTip.Tip="{Binding AtViewTimeTooltip}"
                                      AutomationProperties.Name="{x:Static loc:Strings.Library_State_AtViewTime}">
                            <ic:FluentIcon Icon="Clock" FontSize="16" />
                        </ToggleButton>
                        <Button Grid.Column="2" Classes="Icon libraryIcon"
                                AutomationProperties.AutomationId="Library.FilterOptions"
                                AutomationProperties.Name="{x:Static loc:Strings.Tooltip_LibraryFilterOptions}"
                                ToolTip.Tip="{x:Static loc:Strings.Tooltip_LibraryFilterOptions}">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <CheckBox IsChecked="{Binding ShowCancelled}"
                                              AutomationProperties.AutomationId="Library.FilterOptions.ShowCancelled"
                                              Content="{x:Static loc:Strings.Library_ShowCancelled}" />
                                </Flyout>
                            </Button.Flyout>
                            <ic:FluentIcon Icon="Filter" FontSize="16" />
                        </Button>
                    </Grid>
                    <!-- State segments: what do I have, what can I get, what is new. -->
                    <Border Classes="librarySegments">
                        <UniformGrid Rows="1">
                            <RadioButton Classes="librarySegment" GroupName="LibraryState" IsChecked="{Binding IsStateAll}" AutomationProperties.AutomationId="Library.State.All" AutomationProperties.Name="{x:Static loc:Strings.Library_State_All}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Static loc:Strings.Library_State_All}" />
                                    <TextBlock Text="{Binding AllCount, StringFormat={}{0:N0}}" Opacity="0.55" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Classes="librarySegment" GroupName="LibraryState" IsChecked="{Binding IsStateLocal}" AutomationProperties.AutomationId="Library.State.Local" AutomationProperties.Name="{x:Static loc:Strings.Library_State_Local}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Static loc:Strings.Library_State_Local}" />
                                    <TextBlock Text="{Binding LocalCount, StringFormat={}{0:N0}}" Opacity="0.55" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Classes="librarySegment" GroupName="LibraryState" IsChecked="{Binding IsStateOnline}" AutomationProperties.AutomationId="Library.State.Online" AutomationProperties.Name="{x:Static loc:Strings.Library_State_Online}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Static loc:Strings.Library_State_Online}" />
                                    <TextBlock Text="{Binding OnlineCount, StringFormat={}{0:N0}}" Opacity="0.55" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Classes="librarySegment" GroupName="LibraryState" IsChecked="{Binding IsStateUpdates}" AutomationProperties.AutomationId="Library.State.Updates" AutomationProperties.Name="{x:Static loc:Strings.Library_State_Updates}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Static loc:Strings.Library_State_Updates}" />
                                    <TextBlock Text="{Binding UpdatesCount, StringFormat={}{0:N0}}" Opacity="0.55" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </Border>
                    <!-- One bulk bar: what the buttons act on, then Download (or Cancel) and On pan. -->
                    <Border IsVisible="{Binding HasBulkBar}" Background="{DynamicResource MutedBackgroundColor}"
                            CornerRadius="8" Padding="10,6">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="{Binding BulkSummary}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding BulkScope}" FontSize="{StaticResource LibrarySecondaryFontSize}" Opacity="0.65"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                <Button Classes="Primary libraryCompact"
                                        AutomationProperties.AutomationId="Library.Bulk.Download"
                                        IsVisible="{Binding HasDownloadable}"
                                        Content="{Binding DownloadListedText}"
                                        Command="{Binding DownloadListedCommand}"
                                        ToolTip.Tip="{x:Static loc:Strings.Tooltip_DownloadListed}" />
                                <Button Classes="Primary libraryCompact"
                                        AutomationProperties.AutomationId="Library.Bulk.CheckForRuns"
                                        IsVisible="{Binding IsCheckForRuns}"
                                        Content="{x:Static loc:Strings.Library_BulkCheckForRuns}"
                                        Command="{Binding RefreshCommand}" />
                                <Button Classes="Primary libraryCompact" IsEnabled="False"
                                        AutomationProperties.AutomationId="Library.Bulk.Update"
                                        IsVisible="{Binding IsBulkOffline}"
                                        Content="{x:Static loc:Strings.Library_BulkUpdate}"
                                        ToolTip.Tip="{x:Static loc:Strings.Tooltip_BulkOffline}" />
                                <Button Classes="Primary libraryCompact"
                                        AutomationProperties.AutomationId="Library.Bulk.Cancel"
                                        IsVisible="{Binding IsBulkDownloading}"
                                        Content="{x:Static loc:Strings.Button_Cancel}"
                                        Command="{Binding CancelDownloadsCommand}" />
                            </Panel>
                            <Button Grid.Column="2" Classes="Outline libraryCompact"
                                    AutomationProperties.AutomationId="Library.Bulk.LoadAsYouPan"
                                    Content="{x:Static loc:Strings.Library_BulkOnPan}"
                                    Command="{Binding LoadAsYouPanCommand}"
                                    ToolTip.Tip="{x:Static loc:Strings.Tooltip_LoadAsYouPan}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <ListBox x:Name="ItemList"
                         AutomationProperties.AutomationId="Library.Items"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Classes="accentList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <!-- Swatch (drawn like the map outline, so the list is the map's legend),
                             name and tags, title, meta line. Kept cheap: the list is virtualised
                             and can hold thousands of rows. -->
                        <DataTemplate x:DataType="vm:LibraryItemViewModel">
                            <Border Classes="libraryRow"
                                    Classes.groupHeader="{Binding IsGroupHeader}"
                                    Classes.groupChild="{Binding IsGroupChild}"
                                    Background="Transparent">
                                <Grid ColumnDefinitions="18,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                    <!-- The swatch (or an unpacked package's chevron) sits in one 18 px column,
                                         centred on the name line. -->
                                    <views:LibrarySwatch Grid.Row="0" Grid.Column="0" State="{Binding PrimaryAvailability}"
                                                         Width="18" IsVisible="{Binding !IsGroupHeader}"
                                                         VerticalAlignment="Center" />
                                    <Button Grid.Row="0" Grid.Column="0" Classes="Icon" Padding="0" Width="18" Height="20" MinHeight="0"
                                            AutomationProperties.AutomationId="Library.Row.ToggleGroup"
                                            AutomationProperties.Name="{x:Static loc:Strings.Label_ToggleGroup}"
                                            AutomationProperties.HelpText="{x:Static loc:Strings.Library_ToggleGroup}"
                                            IsVisible="{Binding IsGroupHeader}" VerticalAlignment="Center"
                                            Command="{Binding ToggleCommand}">
                                        <Panel>
                                            <ic:FluentIcon Icon="ChevronRight" FontSize="14" IsVisible="{Binding !IsExpanded}" />
                                            <ic:FluentIcon Icon="ChevronDown" FontSize="14" IsVisible="{Binding IsExpanded}" />
                                        </Panel>
                                    </Button>
                                    <!-- Name, and its tags right-aligned: the name truncates first, tags never. -->
                                    <DockPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Tags}"
                                                      ItemTemplate="{StaticResource LibraryTagTemplate}"
                                                      Margin="12,0,0,0" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Name}" Classes="accentListTitle libraryRowName"
                                                   Classes.mono="{Binding IsNameMono}"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Subtitle}" Margin="0,2,0,0"
                                               FontSize="{StaticResource LibrarySecondaryFontSize}" Opacity="0.8"
                                               IsVisible="{Binding HasSubtitle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary}" Margin="0,2,0,0"
                                               FontSize="{StaticResource LibrarySecondaryFontSize}" Opacity="0.6"
                                               TextTrimming="CharacterEllipsis" />
                                    <!-- A forecast run (#685): its valid window — the grey part has passed, the
                                         tinted part is ahead — and the time left (red once ended). -->
                                    <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,5,0,0"
                                          IsVisible="{Binding HasForecastWindow}">
                                        <Panel Height="4" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource AccentBrush}" Opacity="0.3" CornerRadius="2" />
                                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding WindowElapsed}"
                                                         Height="4" MinHeight="4" Background="Transparent"
                                                         Foreground="{DynamicResource BorderColor}" />
                                        </Panel>
                                        <Panel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TimeLeftText}" FontSize="{StaticResource LibrarySecondaryFontSize}"
                                                       Opacity="0.75" IsVisible="{Binding !IsWindowEnded}" />
                                            <TextBlock Text="{Binding TimeLeftText}" FontSize="{StaticResource LibrarySecondaryFontSize}"
                                                       Foreground="{DynamicResource DestructiveColor}" IsVisible="{Binding IsWindowEnded}" />
                                        </Panel>
                                    </Grid>
                                    <!-- While downloading: a thin progress bar, how much has arrived, and Cancel. -->
                                    <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"
                                          IsVisible="{Binding IsDownloading}" Margin="0,4,0,0">
                                        <ProgressBar Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding DownloadProgress}"
                                                     Height="4" MinHeight="4" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding DownloadProgressText}"
                                                   FontSize="{StaticResource LibrarySecondaryFontSize}" Opacity="0.65"
                                                   FontFamily="{StaticResource LibraryMonoFont}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Classes="Ghost" Padding="6,0" Height="24" MinHeight="0"
                                                AutomationProperties.AutomationId="Library.Row.CancelDownload"
                                                FontSize="{StaticResource LibrarySecondaryFontSize}"
                                                Content="{x:Static loc:Strings.Library_CancelDownload}"
                                                Command="{Binding CancelDownloadCommand}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Row="4" Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    IsHitTestVisible="False" Background="{DynamicResource BorderColor}" />
            <GridSplitter Grid.Row="4"
                          Classes="PaneSplitter"
                          Height="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext" />

            <!-- Details of the selected dataset -->
            <DockPanel Grid.Row="5" ClipToBounds="True">
                <Border DockPanel.Dock="Top" Padding="8,8,8,4">
                    <Panel>
                        <TextBlock IsVisible="{Binding !HasSelectedItem}"
                                   Text="{x:Static loc:Strings.Library_SelectItemPlaceholder}"
                                   Opacity="0.6" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <StackPanel IsVisible="{Binding HasSelectedItem}" Spacing="2">
                            <!-- Swatch, name (truncating), and the actions as compact icon buttons. -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <views:LibrarySwatch Grid.Column="0" State="{Binding SelectedItem.PrimaryAvailability, FallbackValue=Listed}"
                                                     Width="18" VerticalAlignment="Center" />
                                <SelectableTextBlock Grid.Column="1" Text="{Binding SelectedItem.Name}"
                                                     FontFamily="{StaticResource LibraryMonoFont}"
                                                     FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                     VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <Button Classes="Primary libraryHeaderAction"
                                            Command="{Binding DownloadOnlyCommand}"
                                            AutomationProperties.AutomationId="Library.Details.Download"
                                            IsVisible="{Binding SelectedItem.CanDownload, FallbackValue=False}"
                                            ToolTip.Tip="{Binding SelectedItem.DownloadTooltip}"
                                            AutomationProperties.Name="{Binding SelectedItem.DownloadTooltip}">
                                        <ic:FluentIcon Icon="ArrowDownload" FontSize="16" />
                                    </Button>
                                    <!-- #711 G3: the dataset's window on the Timeline. -->
                                    <Button Classes="Icon libraryHeaderAction"
                                            Command="{Binding ShowOnTimelineCommand}"
                                            AutomationProperties.AutomationId="Library.Details.ShowOnTimeline"
                                            IsVisible="{Binding HasValidWindow}"
                                            ToolTip.Tip="{x:Static loc:Strings.Library_ShowOnTimeline}"
                                            AutomationProperties.Name="{x:Static loc:Strings.Library_ShowOnTimeline}">
                                        <ic:FluentIcon Icon="Clock" FontSize="16" />
                                    </Button>
                                    <Button Classes="Icon libraryHeaderAction"
                                            Command="{Binding GoToRunStartCommand}"
                                            AutomationProperties.AutomationId="Library.Details.GoToRunStart"
                                            IsVisible="{Binding HasValidWindow}"
                                            ToolTip.Tip="{x:Static loc:Strings.Library_GoToRunStart}"
                                            AutomationProperties.Name="{x:Static loc:Strings.Library_GoToRunStart}">
                                        <ic:FluentIcon Icon="Previous" FontSize="16" />
                                    </Button>
                                    <Button Classes="Icon libraryHeaderAction"
                                            Command="{Binding ZoomToCommand}"
                                            AutomationProperties.AutomationId="Library.Details.ZoomTo"
                                            ToolTip.Tip="{x:Static loc:Strings.Button_ZoomTo}"
                                            AutomationProperties.Name="{x:Static loc:Strings.Button_ZoomTo}">
                                        <ic:FluentIcon Icon="ZoomFit" FontSize="16" />
                                    </Button>
                                    <Button Classes="Icon libraryHeaderAction"
                                            Command="{Binding LoadOrDownloadCommand}"
                                            AutomationProperties.AutomationId="Library.Details.Load"
                                            ToolTip.Tip="{Binding SelectedItem.LoadTooltip}"
                                            AutomationProperties.Name="{Binding SelectedItem.LoadTooltip}">
                                        <ic:FluentIcon Icon="Layer" FontSize="16" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <!-- Title and state, indented to the name's left edge (swatch 18 + spacing 10). -->
                            <TextBlock Text="{Binding SelectedItem.Subtitle}" IsVisible="{Binding SelectedItem.HasSubtitle, FallbackValue=False}"
                                       Margin="28,0,0,0"
                                       FontSize="{StaticResource LibrarySecondaryFontSize}" Opacity="0.8" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedItem.PrimaryStateText}" Margin="28,0,0,0"
                                       FontSize="{StaticResource LibrarySecondaryFontSize}" Opacity="0.6" />
                        </StackPanel>
                    </Panel>
                </Border>

                <ScrollViewer IsVisible="{Binding HasSelectedItem}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10" Margin="8,4,8,8">
                        <Border IsVisible="{Binding SelectedItem.NotForNavigation, FallbackValue=False}"
                                Background="#FFE4B5" BorderBrush="#B8860B" BorderThickness="1"
                                CornerRadius="4" Padding="10,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:FluentIcon Icon="Warning" IconVariant="Filled" FontSize="20" Foreground="#8B4513" />
                                <TextBlock Text="{x:Static loc:Strings.Library_NotForNavigation}"
                                           FontWeight="SemiBold" Foreground="#8B4513" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Product, Coverage, Source. -->
                        <ItemsControl ItemsSource="{Binding SelectedItem.Details}" Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LibraryDetailGroup">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Header}" Classes="libraryGroupHeader" />
                                        <ItemsControl ItemsSource="{Binding Fields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LibraryDetailField">
                                                    <Grid ColumnSpacing="12" Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="LibraryDetailKey" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" Opacity="0.6"
                                                                   FontSize="{StaticResource LibrarySecondaryFontSize}" />
                                                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                                                             FontSize="{StaticResource LibrarySecondaryFontSize}"
                                                                             Classes.mono="{Binding IsMono}"
                                                                             Classes.copyable="{Binding IsCopyable}"
                                                                             ToolTip.Tip="{Binding CopyValue}"
                                                                             Tapped="OnDetailValueTapped" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The S-102 tile in the same grid cell as an S-111 tile (#685, B7). -->
                        <Border IsVisible="{Binding HasPairing}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="6" Padding="10,8">
                            <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="10">
                                <views:LibrarySwatch Grid.Column="0" State="Online" Width="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Pairing.Title, FallbackValue=''}" FontWeight="SemiBold"
                                               FontSize="{StaticResource LibrarySecondaryFontSize}" />
                                    <TextBlock Text="{Binding Pairing.Detail, FallbackValue=''}" Opacity="0.65" TextWrapping="Wrap"
                                               FontSize="{StaticResource LibrarySecondaryFontSize}" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="Outline libraryCompact" VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="Library.Details.GetPairing"
                                        Content="{x:Static loc:Strings.Library_Pairing_Get}"
                                        Command="{Binding Pairing.GetCommand, FallbackValue={x:Null}}"
                                        IsVisible="{Binding Pairing.CanGet, FallbackValue=False}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Panel>
</UserControl>
