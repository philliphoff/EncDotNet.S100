<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EncDotNet.S100.Viewer.ViewModels"
             xmlns:viewer="using:EncDotNet.S100.Viewer"
             xmlns:loc="using:EncDotNet.S100.Viewer.Resources"
             x:Class="EncDotNet.S100.Viewer.Views.Settings.AppearanceSettingsPage"
             x:DataType="vm:SettingsViewModel">

    <!-- Settings → Appearance: accent colour, chrome theme, colour profile, symbol and text scale (#845). -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="settingsPage">
            <StackPanel Spacing="3">
                <TextBlock Classes="settingsPageTitle" Text="{x:Static loc:Strings.Settings_Category_Appearance}" />
                <TextBlock Classes="settingsPageHelp" Text="{x:Static loc:Strings.Settings_Category_Appearance_Help}" />
            </StackPanel>

            <!-- Accent Color -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_AccentColor}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <ColorPicker Color="{Binding AccentColor}"
                             IsAlphaVisible="False"
                             HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Chrome Theme -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_ChromeTheme}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Static loc:Strings.Settings_ChromeTheme_Help}"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding AvailableChromeThemes}"
                          AutomationProperties.AutomationId="Settings.ChromeTheme"
                          AutomationProperties.Name="{x:Static loc:Strings.Settings_ChromeTheme}"
                          SelectedItem="{Binding SelectedChromeTheme}"
                          ToolTip.Tip="{x:Static loc:Strings.Settings_ChromeTheme_Help}"
                          MinWidth="140"
                          HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static viewer:ChromeThemeNameConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Color Profile -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_ColorProfile}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Static loc:Strings.Settings_ColorProfile_Help}"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding AvailablePalettes}"
                          AutomationProperties.AutomationId="Settings.Palette"
                          AutomationProperties.Name="{x:Static loc:Strings.Settings_ColorProfile}"
                          SelectedItem="{Binding SelectedPalette}"
                          ToolTip.Tip="{x:Static loc:Strings.Settings_ColorProfile_Help}"
                          MinWidth="140"
                          HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static viewer:PaletteTypeNameConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Symbol Scale -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_SymbolScale}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Static loc:Strings.Settings_SymbolScale_Help}"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto">
                    <Slider Grid.Column="0"
                            AutomationProperties.AutomationId="Settings.SymbolScale"
                            AutomationProperties.Name="{x:Static loc:Strings.Settings_SymbolScale}"
                            Minimum="0.5"
                            Maximum="3.0"
                            TickFrequency="0.1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding SymbolScale}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding SymbolScale, StringFormat={}{0:F1}x}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               MinWidth="36" />
                </Grid>
            </StackPanel>

            <!-- Text Scale -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_TextScale}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Static loc:Strings.Settings_TextScale_Help}"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto">
                    <Slider Grid.Column="0"
                            AutomationProperties.AutomationId="Settings.TextScale"
                            AutomationProperties.Name="{x:Static loc:Strings.Settings_TextScale}"
                            Minimum="0.5"
                            Maximum="3.0"
                            TickFrequency="0.1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding TextScale}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding TextScale, StringFormat={}{0:F1}x}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               MinWidth="36" />
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
