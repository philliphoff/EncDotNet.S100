<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EncDotNet.S100.Viewer.ViewModels"
             xmlns:loc="using:EncDotNet.S100.Viewer.Resources"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="EncDotNet.S100.Viewer.Views.AddCatalogueSheetView"
             x:DataType="vm:AddCatalogueSheetViewModel"
             AutomationProperties.AutomationId="Catalogues.Sheet"
             MinWidth="420">

    <!-- Add catalogue…'s confirmation sheet (catalogue-panels D5, §6.2). -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="20,12,20,16" RowSpacing="14">

        <!-- Header (the dialog host supplies the close button). -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,24,0">
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                       AutomationProperties.AutomationId="Catalogues.Sheet.Title" />
            <TextBlock Text="{Binding PathText}" FontSize="12" Opacity="0.7" FontFamily="{StaticResource MonoFontFamily}"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PathText}"
                       AutomationProperties.AutomationId="Catalogues.Sheet.Path" />
        </StackPanel>

        <!-- What it is, what it replaces, what it redraws. -->
        <StackPanel Grid.Row="1" Spacing="12" IsVisible="{Binding IsFound}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Classes="kindTag" VerticalAlignment="Top" Margin="0,2,0,0">
                    <TextBlock Text="{Binding SpecText}" AutomationProperties.AutomationId="Catalogues.Sheet.Spec" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding KindText}" FontWeight="SemiBold"
                               AutomationProperties.AutomationId="Catalogues.Sheet.Kind" />
                    <TextBlock Text="{Binding NameText}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                <TextBlock Text="{x:Static loc:Strings.Catalogues_Field_Replaces}" FontSize="12" Opacity="0.6" />
                <TextBlock Grid.Column="1" Text="{Binding ReplacesText}" FontSize="12" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="Catalogues.Sheet.Replaces" />
                <TextBlock Grid.Row="1" Text="{x:Static loc:Strings.Catalogues_Field_Redraws}" FontSize="12" Opacity="0.6" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RedrawsText}" FontSize="12" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="Catalogues.Sheet.Redraws" />
            </Grid>
            <TextBlock Text="{Binding CommandLineNote}" IsVisible="{Binding HasCommandLineNote}"
                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource WarningColor}"
                       AutomationProperties.AutomationId="Catalogues.Sheet.CommandLineNote" />
            <CheckBox IsChecked="{Binding KeepAfterRestart}"
                      AutomationProperties.AutomationId="Catalogues.Sheet.Keep"
                      Content="{x:Static loc:Strings.Catalogues_Sheet_Keep}" />
        </StackPanel>

        <!-- Refused: the reason, Choose another… and Cancel. -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding IsRefused}">
            <ic:FluentIcon Icon="Warning" FontSize="16" Foreground="{DynamicResource ErrorColor}" VerticalAlignment="Top" Margin="0,1,0,0" />
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{x:Static loc:Strings.Catalogues_Sheet_RefusedTitle}" FontWeight="SemiBold" />
                <SelectableTextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontSize="12.5"
                                     AutomationProperties.AutomationId="Catalogues.Sheet.Reason" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="Outline"
                    AutomationProperties.AutomationId="Catalogues.Sheet.ChooseAnother"
                    Content="{x:Static loc:Strings.Catalogues_Sheet_ChooseAnother}"
                    ToolTip.Tip="{x:Static loc:Strings.Tooltip_CataloguesAdd}"
                    IsVisible="{Binding IsRefused}"
                    Command="{Binding ChooseAnotherCommand}" />
            <Button Classes="Outline"
                    AutomationProperties.AutomationId="Catalogues.Sheet.Cancel"
                    Content="{x:Static loc:Strings.Button_Cancel}"
                    ToolTip.Tip="{x:Static loc:Strings.Button_Cancel}"
                    Command="{Binding CancelCommand}" />
            <Button Classes="Primary"
                    AutomationProperties.AutomationId="Catalogues.Sheet.Confirm"
                    Content="{Binding ConfirmLabel}"
                    ToolTip.Tip="{Binding ConfirmLabel}"
                    IsVisible="{Binding IsFound}"
                    Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
