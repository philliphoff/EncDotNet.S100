<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EncDotNet.S100.Viewer.ViewModels"
             xmlns:loc="using:EncDotNet.S100.Viewer.Resources"
             xmlns:views="using:EncDotNet.S100.Viewer.Views"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="EncDotNet.S100.Viewer.Views.RoutesView"
             x:DataType="vm:RoutesPanelViewModel">

    <UserControl.Styles>
        <!--
          Full-width selectable waypoint row. The accent left bar and the
          low-opacity accent tint live on the row Border so the selection
          spans the whole list width (content + overflow), matching the
          `accentList` language used by the Datasets / Search / Pick lists.
          The inner hit button is a bare, chrome-free click target; hover
          and selection visuals are driven by the parent Border's pseudo /
          selected classes.
        -->
        <!--
          Full-width selectable waypoint row. This mirrors the `accentList`
          ListBoxItem template (a "3,*" grid with a rounded accent bar plus a
          tinted content panel) so the waypoint list lines up pixel-for-pixel
          with the routes list above it. Hover/selection visuals are driven by
          the root grid's pseudo/selected classes; a full-area, chrome-free
          hit button sits beneath the (non-hit-testable) row visuals so a click
          anywhere on the row selects the waypoint.
        -->
        <Style Selector="Grid.wpRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="Border.wpBar">
            <Setter Property="Width" Value="3" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Leg rows share the waypoint rows' selection look (#896): the
             selected leg is haloed on the map too. -->
        <Style Selector="Grid.legRow">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Grid.legRow.selected Border.wpBar">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Grid.legRow:pointerover Border.wpTint">
            <Setter Property="Opacity" Value="0.06" />
        </Style>
        <Style Selector="Grid.legRow.selected Border.wpTint">
            <Setter Property="Opacity" Value="0.12" />
        </Style>
        <Style Selector="Grid.legRow.selected TextBlock.legText">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Grid.wpRow.selected Border.wpBar">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.wpTint">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Grid.wpRow:pointerover Border.wpTint">
            <Setter Property="Opacity" Value="0.06" />
        </Style>
        <Style Selector="Grid.wpRow.selected Border.wpTint">
            <Setter Property="Opacity" Value="0.12" />
        </Style>

        <!-- Full-area click target for the waypoint row. The templated Border
             carries the (transparent) background so the entire row area is
             hit-testable, not just where content happens to sit. -->
        <Style Selector="Button.wpHit">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Numbered timeline circle: outlined by default, filled accent when
             its waypoint is selected. -->
        <Style Selector="Border.wpCircle">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.wpRow.selected Border.wpCircle">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.wpNum">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.wpRow.selected TextBlock.wpNum">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.wpLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Grid.wpRow.selected TextBlock.wpLabel">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- Vertical connector segment drawn in the rail of each leg row so
             consecutive waypoint circles read as a single timeline spine. The
             rail width (28) and leading offset match the waypoint circle so
             the line passes through the circle centres. -->
        <Style Selector="Border.legConnector">
            <Setter Property="Width" Value="2" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="{DynamicResource BorderColor}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <!-- Leg geometry pill. -->
        <Style Selector="Button.geoChip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style Selector="Button.geoChip.geodesic">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <!-- Inline-edit text fields in a waypoint row: they read as plain text
             until hovered or focused, then show a field border. -->
        <Style Selector="TextBox.inlineEdit">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="21" />
            <Setter Property="Margin" Value="-5,0,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.inlineEdit:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        </Style>
        <Style Selector="TextBox.inlineEdit:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
        </Style>
        <Style Selector="TextBox.wpName">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Grid.wpRow.selected TextBox.wpName">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBox.wpCoords">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Menlo,Consolas,Courier New,monospace" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="TextBox.wpCoords:focus-within">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBox.wpCoords.invalid">
            <Setter Property="BorderBrush" Value="{DynamicResource DestructiveColor}" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- "Editing" pill beside the active route's name. -->
        <Style Selector="Border.editingPill">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Footer mode toggles (Edit, Check passage): 32px, outlined when
             off, filled with the accent when on. -->
        <Style Selector="ToggleButton.modeToggle">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.modeToggle:checked">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ToggleButton.modeToggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ToggleButton.modeToggle:checked ic|FluentIcon">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ToggleButton.modeToggle:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- Passage card and leg detail fields (#898, handoff B1/B2/B5):
             26 px. A set value has a solid border and a mono value; an
             unset one is dashed (a Rectangle behind a borderless box) and
             shows its muted placeholder. An overridden leg value has an
             accent border; text that doesn't parse, a destructive one. -->
        <Style Selector="TextBox.passageField">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.passageField.set">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="FontFamily" Value="Menlo,Consolas,Courier New,monospace" />
        </Style>
        <Style Selector="TextBox.passageField.clock">
            <Setter Property="Padding" Value="26,0,8,0" />
        </Style>
        <Style Selector="TextBox.passageField.overridden">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Padding" Value="8,0,44,0" />
        </Style>
        <Style Selector="TextBox.passageField:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBox.passageField.invalid">
            <Setter Property="BorderBrush" Value="{DynamicResource DestructiveColor}" />
        </Style>
        <Style Selector="Rectangle.dashedField">
            <Setter Property="Stroke" Value="{DynamicResource BorderColor}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeDashArray" Value="3,2" />
            <Setter Property="RadiusX" Value="6" />
            <Setter Property="RadiusY" Value="6" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="TextBlock.passageLabel">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="TextBlock.passageLabel.overridden">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.fieldButton">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.fieldButton.set">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.link:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- One passage value: label (with an override dot), then the field. -->
        <DataTemplate x:Key="PassageFieldTemplate" x:DataType="vm:PassageFieldViewModel">
            <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Ellipse Width="5" Height="5"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource AccentBrush}"
                             IsVisible="{Binding IsOverridden}" />
                    <TextBlock Classes="passageLabel"
                               Classes.overridden="{Binding IsOverridden}"
                               Text="{Binding Label}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Panel Height="26">
                    <Rectangle Classes="dashedField" IsVisible="{Binding IsUnset}" />
                    <TextBox Classes="passageField"
                             Classes.set="{Binding IsSet}"
                             Classes.clock="{Binding ShowsClockWhenUnset}"
                             Classes.overridden="{Binding IsOverridden}"
                             Classes.invalid="{Binding HasError}"
                             AutomationProperties.AutomationId="{Binding Id}"
                             AutomationProperties.Name="{Binding Label}"
                             Text="{Binding Text, Mode=TwoWay}"
                             PlaceholderText="{Binding Placeholder}"
                             ToolTip.Tip="{Binding ErrorTip}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
                            <KeyBinding Gesture="Escape" Command="{Binding RevertCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <ic:FluentIcon Icon="Clock"
                                   IconVariant="Regular"
                                   FontSize="13"
                                   Margin="8,0,0,0"
                                   Opacity="0.6"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   IsVisible="{Binding ShowsClock}" />
                    <TextBlock Text="{Binding Suffix}"
                               FontSize="10.5"
                               Opacity="0.55"
                               Margin="0,0,8,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               IsVisible="{Binding ShowsSuffix}" />
                    <Button Classes="link"
                            AutomationProperties.AutomationId="{Binding ResetId}"
                            AutomationProperties.HelpText="{x:Static loc:Strings.Tooltip_LegReset}"
                            Content="{x:Static loc:Strings.Leg_Reset}"
                            Margin="0,0,4,0"
                            HorizontalAlignment="Right"
                            IsVisible="{Binding IsOverridden}"
                            Command="{Binding ResetCommand}"
                            ToolTip.Tip="{x:Static loc:Strings.Tooltip_LegReset}" />
                </Panel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- Route-collection header actions (the host pane supplies the
             "ROUTES" title above this row). -->
        <Border DockPanel.Dock="Top" Padding="8,4,6,4">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <Button Grid.Column="1"
                        AutomationProperties.AutomationId="Routes.PromoteMeasurement"
                        AutomationProperties.Name="{x:Static loc:Strings.Label_PromoteMeasurement}"
                        AutomationProperties.HelpText="{x:Static loc:Strings.Tooltip_PromoteMeasurement}"
                        Classes="Icon"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PromoteMeasurementToRouteCommand}"
                        ToolTip.Tip="{x:Static loc:Strings.Tooltip_PromoteMeasurement}">
                    <ic:FluentIcon Icon="Ruler" IconVariant="Regular" FontSize="16" />
                </Button>
                <Button Grid.Column="2"
                        AutomationProperties.AutomationId="Routes.Add"
                        AutomationProperties.Name="{x:Static loc:Strings.Label_AddRoute}"
                        AutomationProperties.HelpText="{x:Static loc:Strings.Tooltip_AddRoute}"
                        Classes="Icon"
                        Command="{Binding AddRouteCommand}"
                        ToolTip.Tip="{x:Static loc:Strings.Tooltip_AddRoute}">
                    <ic:FluentIcon Icon="Add" IconVariant="Regular" FontSize="16" />
                </Button>
            </Grid>
        </Border>

        <!-- Empty state. -->
        <views:PlaceholderView DockPanel.Dock="Top"
                               IsVisible="{Binding !HasRoutes}"
                               Icon="Flow"
                               Header="{x:Static loc:Strings.Pane_Routes}"
                               Description="{Binding EmptyText}" />

        <!-- Main body: routes list (top) over the active route detail. -->
        <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding HasRoutes}">

            <!-- Routes list. -->
            <ListBox Grid.Row="0"
                     AutomationProperties.AutomationId="Routes.List"
                     x:Name="RouteList"
                     MaxHeight="200"
                     ItemsSource="{Binding Routes}"
                     SelectedItem="{Binding SelectedRoute, Mode=TwoWay}"
                     Classes="accentList"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     Margin="8,2,8,4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <!-- Rows are named after their route, not RouteRowViewModel (#784). -->
                    <Style Selector="ListBoxItem" x:DataType="vm:RouteRowViewModel">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:RouteRowViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <ic:FluentIcon Grid.Column="0"
                                           Icon="Flow"
                                           IconVariant="Filled"
                                           FontSize="16"
                                           VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           Classes="accentListTitle"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Meta}"
                                           FontSize="11"
                                           Opacity="0.6" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    AutomationProperties.AutomationId="Routes.Row.Menu"
                                    AutomationProperties.Name="{x:Static loc:Strings.Tooltip_RouteRowMenu}"
                                    Classes="Icon"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{x:Static loc:Strings.Tooltip_RouteRowMenu}">
                                <ic:FluentIcon Icon="MoreHorizontal" IconVariant="Regular" FontSize="16" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="{x:Static loc:Strings.Menu_RenameRoute}"
                                                  AutomationProperties.AutomationId="Routes.RowMenu.Rename"
                                                  Command="{Binding $parent[ListBox].((vm:RoutesPanelViewModel)DataContext).RenameRouteCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="{x:Static loc:Strings.Menu_ReverseRoute}"
                                                  AutomationProperties.AutomationId="Routes.RowMenu.Reverse"
                                                  Command="{Binding $parent[ListBox].((vm:RoutesPanelViewModel)DataContext).ReverseRouteCommand}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="{x:Static loc:Strings.Menu_RemoveRoute}"
                                                  AutomationProperties.AutomationId="Routes.RowMenu.Remove"
                                                  Command="{Binding $parent[ListBox].((vm:RoutesPanelViewModel)DataContext).RemoveRouteCommand}"
                                                  CommandParameter="{Binding}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Active-route detail header: name (+ inline rename), the
                 Editing pill, meta, and the editing toolbar. -->
            <Border Grid.Row="1"
                    IsVisible="{Binding HasActiveRoute}"
                    Padding="11,6,8,6"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,1,0,1">
                <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                          ColumnSpacing="6"
                          IsVisible="{Binding !IsRenamingActiveRoute}">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ActiveRouteName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1"
                                AutomationProperties.AutomationId="Routes.Active.Rename"
                                AutomationProperties.Name="{x:Static loc:Strings.Tooltip_EditRouteName}"
                                Classes="Icon"
                                Command="{Binding BeginRenameCommand}"
                                ToolTip.Tip="{x:Static loc:Strings.Tooltip_EditRouteName}">
                            <ic:FluentIcon Icon="Edit" IconVariant="Regular" FontSize="14" />
                        </Button>
                        <Border Grid.Column="3"
                                Classes="editingPill"
                                AutomationProperties.AutomationId="Routes.Active.EditingBadge"
                                IsVisible="{Binding IsEditing}">
                            <TextBlock Text="{x:Static loc:Strings.Routes_EditingBadge}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                        </Border>
                    </Grid>
                    <TextBox Text="{Binding RenameText, Mode=TwoWay}"
                             AutomationProperties.AutomationId="Routes.Active.NameBox"
                             AutomationProperties.Name="{x:Static loc:Strings.Tooltip_EditRouteName}"
                             FontSize="13"
                             Padding="4,2"
                             IsVisible="{Binding IsRenamingActiveRoute}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding CommitRenameCommand}" />
                            <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <TextBlock Text="{Binding ActiveRouteDetailMeta}"
                               FontSize="11"
                               Opacity="0.6" />

                    <!-- Editing toolbar: undo / redo, zoom to route / reverse,
                         and the keyboard hint. -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*"
                          Margin="-6,2,0,0">
                        <Button Grid.Column="0"
                                AutomationProperties.AutomationId="Routes.Undo"
                                AutomationProperties.Name="{x:Static loc:Strings.Label_UndoRouteEdit}"
                                AutomationProperties.HelpText="{Binding UndoTooltip}"
                                Classes="Icon"
                                Command="{Binding UndoCommand}"
                                ToolTip.Tip="{Binding UndoTooltip}">
                            <ic:FluentIcon Icon="ArrowUndo" IconVariant="Regular" FontSize="16" />
                        </Button>
                        <Button Grid.Column="1"
                                AutomationProperties.AutomationId="Routes.Redo"
                                AutomationProperties.Name="{x:Static loc:Strings.Label_RedoRouteEdit}"
                                AutomationProperties.HelpText="{Binding RedoTooltip}"
                                Classes="Icon"
                                Command="{Binding RedoCommand}"
                                ToolTip.Tip="{Binding RedoTooltip}">
                            <ic:FluentIcon Icon="ArrowRedo" IconVariant="Regular" FontSize="16" />
                        </Button>
                        <Border Grid.Column="2"
                                Width="1"
                                Height="16"
                                Margin="4,0"
                                Background="{DynamicResource BorderColor}" />
                        <Button Grid.Column="3"
                                AutomationProperties.AutomationId="Routes.ZoomToRoute"
                                AutomationProperties.Name="{x:Static loc:Strings.Label_ZoomToRoute}"
                                AutomationProperties.HelpText="{x:Static loc:Strings.Tooltip_ZoomToRoute}"
                                Classes="Icon"
                                Command="{Binding ZoomToRouteCommand}"
                                ToolTip.Tip="{x:Static loc:Strings.Tooltip_ZoomToRoute}">
                            <ic:FluentIcon Icon="ZoomFit" IconVariant="Regular" FontSize="16" />
                        </Button>
                        <Button Grid.Column="4"
                                AutomationProperties.AutomationId="Routes.Reverse"
                                AutomationProperties.Name="{x:Static loc:Strings.Button_ReverseRoute}"
                                AutomationProperties.HelpText="{x:Static loc:Strings.Tooltip_ReverseRoute}"
                                Classes="Icon"
                                Command="{Binding ReverseActiveRouteCommand}"
                                ToolTip.Tip="{x:Static loc:Strings.Tooltip_ReverseRoute}">
                            <ic:FluentIcon Icon="ArrowSwap" IconVariant="Regular" FontSize="16" />
                        </Button>
                        <TextBlock Grid.Column="5"
                                   Text="{Binding EditHint}"
                                   FontSize="10.5"
                                   Opacity="0.55"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Active-route waypoint/leg timeline. -->
            <Grid Grid.Row="2" RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0"
                              IsVisible="{Binding HasActiveRoute}"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <!-- Passage card (#898, handoff B1–B3). It scrolls with the
                         waypoints so small windows keep room for both. -->
                    <Border Margin="10,8,10,4"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderColor}"
                            Background="{DynamicResource CardBackgroundColor}">
                        <StackPanel>
                            <Panel>
                                <!-- Full-area toggle target under the (non-hit-testable) header. -->
                                <Button Classes="wpHit"
                                        AutomationProperties.AutomationId="Routes.Passage.Toggle"
                                        AutomationProperties.Name="{x:Static loc:Strings.Passage_Title}"
                                        AutomationProperties.HelpText="{x:Static loc:Strings.Tooltip_PassageToggle}"
                                        Command="{Binding PassageCard.ToggleCommand}"
                                        ToolTip.Tip="{x:Static loc:Strings.Tooltip_PassageToggle}" />
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                      ColumnSpacing="6"
                                      Margin="10,7,10,5"
                                      IsHitTestVisible="False">
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Static loc:Strings.Passage_Title}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding PassageCard.IsExpanded}" />
                                    <Border Grid.Column="1"
                                            CornerRadius="9"
                                            Padding="6,1"
                                            Background="{DynamicResource MutedBackgroundColor}"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding PassageCard.IsExpanded}">
                                        <TextBlock Text="{x:Static loc:Strings.Passage_Optional}"
                                                   FontSize="10"
                                                   Opacity="0.7" />
                                    </Border>
                                    <TextBlock Grid.Column="0"
                                               Grid.ColumnSpan="3"
                                               AutomationProperties.AutomationId="Routes.Passage.Collapsed"
                                               Text="{Binding PassageCard.CollapsedText}"
                                               FontSize="11.5"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !PassageCard.IsExpanded}" />
                                    <Panel Grid.Column="3" VerticalAlignment="Center" Opacity="0.6">
                                        <ic:FluentIcon Icon="ChevronUp" IconVariant="Regular" FontSize="12"
                                                       IsVisible="{Binding PassageCard.IsExpanded}" />
                                        <ic:FluentIcon Icon="ChevronDown" IconVariant="Regular" FontSize="12"
                                                       IsVisible="{Binding !PassageCard.IsExpanded}" />
                                    </Panel>
                                </Grid>
                            </Panel>
                            <StackPanel IsVisible="{Binding PassageCard.IsExpanded}">
                                <Grid ColumnDefinitions="*,*"
                                      RowDefinitions="Auto,Auto,Auto"
                                      ColumnSpacing="8"
                                      RowSpacing="6"
                                      Margin="10,2,10,6">
                                    <ContentControl Grid.Row="0" Grid.Column="0"
                                                    Content="{Binding PassageCard.DraftSquat}"
                                                    ContentTemplate="{StaticResource PassageFieldTemplate}" />
                                    <ContentControl Grid.Row="0" Grid.Column="1"
                                                    Content="{Binding PassageCard.Speed}"
                                                    ContentTemplate="{StaticResource PassageFieldTemplate}" />
                                    <ContentControl Grid.Row="1" Grid.Column="0"
                                                    Content="{Binding PassageCard.Departure}"
                                                    ContentTemplate="{StaticResource PassageFieldTemplate}" />
                                    <ContentControl Grid.Row="1" Grid.Column="1"
                                                    Content="{Binding PassageCard.RequiredUkc}"
                                                    ContentTemplate="{StaticResource PassageFieldTemplate}" />
                                    <!-- Vessel: the name, with the particulars in a popover. -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="3">
                                        <TextBlock Classes="passageLabel" Text="{x:Static loc:Strings.Passage_Vessel}" />
                                        <Panel Height="26">
                                            <Rectangle Classes="dashedField" IsVisible="{Binding PassageCard.Vessel.IsUnset}" />
                                            <Button Classes="fieldButton"
                                                    Classes.set="{Binding PassageCard.Vessel.IsSet}"
                                                    AutomationProperties.AutomationId="Routes.Passage.Vessel"
                                                    AutomationProperties.Name="{x:Static loc:Strings.Passage_Vessel}">
                                                <Panel>
                                                    <TextBlock Text="{Binding PassageCard.Vessel.Summary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding PassageCard.Vessel.IsSet}" />
                                                    <TextBlock Text="{Binding PassageCard.Vessel.Placeholder}"
                                                               FontSize="11.5"
                                                               Opacity="0.55"
                                                               IsVisible="{Binding PassageCard.Vessel.IsUnset}" />
                                                </Panel>
                                                <Button.Flyout>
                                                    <Flyout Placement="Bottom">
                                                        <Grid DataContext="{Binding PassageCard.Vessel}"
                                                              x:DataType="vm:VesselFieldsViewModel"
                                                              ColumnDefinitions="Auto,180"
                                                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                                              ColumnSpacing="8"
                                                              RowSpacing="6"
                                                              Margin="4">
                                                            <TextBlock Grid.Row="0" Classes="passageLabel" VerticalAlignment="Center" Text="{x:Static loc:Strings.Label_VesselName}" />
                                                            <TextBox Grid.Row="0" Grid.Column="1" AutomationProperties.AutomationId="Routes.Passage.Vessel.Name" AutomationProperties.Name="{x:Static loc:Strings.Label_VesselName}" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                            <TextBlock Grid.Row="1" Classes="passageLabel" VerticalAlignment="Center" Text="{x:Static loc:Strings.Label_VesselMmsi}" />
                                                            <TextBox Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="Routes.Passage.Vessel.Mmsi" AutomationProperties.Name="{x:Static loc:Strings.Label_VesselMmsi}" Text="{Binding Mmsi, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                            <TextBlock Grid.Row="2" Classes="passageLabel" VerticalAlignment="Center" Text="{x:Static loc:Strings.Label_VesselImo}" />
                                                            <TextBox Grid.Row="2" Grid.Column="1" AutomationProperties.AutomationId="Routes.Passage.Vessel.Imo" AutomationProperties.Name="{x:Static loc:Strings.Label_VesselImo}" Text="{Binding Imo, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                            <TextBlock Grid.Row="3" Classes="passageLabel" VerticalAlignment="Center" Text="{x:Static loc:Strings.Label_VesselCallsign}" />
                                                            <TextBox Grid.Row="3" Grid.Column="1" AutomationProperties.AutomationId="Routes.Passage.Vessel.Callsign" AutomationProperties.Name="{x:Static loc:Strings.Label_VesselCallsign}" Text="{Binding Callsign, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                            <TextBlock Grid.Row="4" Classes="passageLabel" VerticalAlignment="Center" Text="{x:Static loc:Strings.Label_VesselLength}" />
                                                            <TextBox Grid.Row="4" Grid.Column="1" AutomationProperties.AutomationId="Routes.Passage.Vessel.Length" AutomationProperties.Name="{x:Static loc:Strings.Label_VesselLength}" Text="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                            <TextBlock Grid.Row="5" Classes="passageLabel" VerticalAlignment="Center" Text="{x:Static loc:Strings.Label_VesselBeam}" />
                                                            <TextBox Grid.Row="5" Grid.Column="1" AutomationProperties.AutomationId="Routes.Passage.Vessel.Beam" AutomationProperties.Name="{x:Static loc:Strings.Label_VesselBeam}" Text="{Binding Beam, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                        </Grid>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Panel>
                                    </StackPanel>
                                    <ContentControl Grid.Row="2" Grid.Column="1"
                                                    Content="{Binding PassageCard.CrossTrack}"
                                                    ContentTemplate="{StaticResource PassageFieldTemplate}" />
                                </Grid>
                                <TextBlock Text="{Binding PassageCard.HelpText}"
                                           FontSize="10.5"
                                           Opacity="0.6"
                                           TextWrapping="Wrap"
                                           Margin="10,0,10,9" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ItemsControl x:Name="TimelineItems"
                                  ItemsSource="{Binding Timeline}"
                                  Margin="8,2,8,4">
                        <ItemsControl.DataTemplates>
                            <!-- Waypoint row. The accent bar + tint live on
                                 the row Border so selection spans the full
                                 width (content + overflow). The inner grid's
                                 8,5 margin matches the `accentList` content
                                 padding so this list lines up with the routes
                                 list above it. -->
                            <DataTemplate x:DataType="vm:RouteWaypointRowViewModel">
                                <Grid Classes="wpRow"
                                      Classes.selected="{Binding IsSelected}"
                                      ColumnDefinitions="3,*">
                                    <Border Grid.Column="0" Classes="wpBar" />
                                    <Panel Grid.Column="1">
                                        <Border Classes="wpTint" />
                                        <!-- Full-area select target (bottom layer). -->
                                        <Button Classes="wpHit"
                                                AutomationProperties.AutomationId="Routes.Waypoint"
                                                AutomationProperties.Name="{Binding Label}"
                                                Command="{Binding $parent[ItemsControl].((vm:RoutesPanelViewModel)DataContext).SelectWaypointCommand}"
                                                CommandParameter="{Binding}" />
                                        <!-- Row visuals (top layer). The disc is
                                             non-hit-testable so clicks fall through
                                             to the select target; the name and
                                             position fields and the overflow
                                             button take their own clicks. -->
                                        <Grid ColumnDefinitions="*,Auto" Margin="8,5">
                                            <Grid Grid.Column="0"
                                                  ColumnDefinitions="28,*"
                                                  ColumnSpacing="8">
                                                <Border Grid.Column="0"
                                                        Classes="wpCircle"
                                                        VerticalAlignment="Top"
                                                        Margin="0,2,0,0"
                                                        IsHitTestVisible="False">
                                                    <TextBlock Classes="wpNum"
                                                               Text="{Binding Number}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBox Classes="inlineEdit wpName"
                                                             AutomationProperties.AutomationId="Routes.Waypoint.Name"
                                                             AutomationProperties.Name="{x:Static loc:Strings.Label_WaypointName}"
                                                             Text="{Binding NameText, Mode=TwoWay}"
                                                             PlaceholderText="{Binding FallbackName}">
                                                        <TextBox.KeyBindings>
                                                            <KeyBinding Gesture="Enter" Command="{Binding CommitNameCommand}" />
                                                            <KeyBinding Gesture="Escape" Command="{Binding RevertNameCommand}" />
                                                        </TextBox.KeyBindings>
                                                    </TextBox>
                                                    <TextBox Classes="inlineEdit wpCoords"
                                                             Classes.invalid="{Binding HasCoordsError}"
                                                             AutomationProperties.AutomationId="Routes.Waypoint.Position"
                                                             AutomationProperties.Name="{x:Static loc:Strings.Label_WaypointPosition}"
                                                             Text="{Binding CoordsText, Mode=TwoWay}">
                                                        <TextBox.KeyBindings>
                                                            <KeyBinding Gesture="Enter" Command="{Binding CommitCoordsCommand}" />
                                                            <KeyBinding Gesture="Escape" Command="{Binding RevertCoordsCommand}" />
                                                        </TextBox.KeyBindings>
                                                    </TextBox>
                                                    <TextBlock AutomationProperties.AutomationId="Routes.Waypoint.PositionError"
                                                               Text="{Binding CoordsError}"
                                                               IsVisible="{Binding HasCoordsError}"
                                                               Foreground="{DynamicResource DestructiveColor}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <!-- Overflow menu. The flyout binds to
                                                 commands surfaced on the row VM:
                                                 ancestor bindings do not resolve
                                                 across the flyout popup, but the
                                                 inherited DataContext does. -->
                                            <Button Grid.Column="1"
                                                    AutomationProperties.AutomationId="Routes.Waypoint.Menu"
                                                    AutomationProperties.Name="{x:Static loc:Strings.Tooltip_WaypointRowMenu}"
                                                    Classes="Icon"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="{x:Static loc:Strings.Tooltip_WaypointRowMenu}">
                                                <ic:FluentIcon Icon="MoreHorizontal" IconVariant="Regular" FontSize="16" />
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="{x:Static loc:Strings.Menu_InsertWaypointAfter}"
                                                                  AutomationProperties.AutomationId="Routes.WaypointMenu.InsertAfter"
                                                                  Command="{Binding InsertAfterCommand}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Header="{x:Static loc:Strings.Menu_DeleteWaypoint}"
                                                                  AutomationProperties.AutomationId="Routes.WaypointMenu.Delete"
                                                                  Command="{Binding DeleteCommand}"
                                                                  CommandParameter="{Binding}" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </Panel>
                                </Grid>
                            </DataTemplate>
                            <!-- Leg row (sits between two waypoint rows). The
                                 11px left margin (3px accent bar + 8px content
                                 margin) lines the connector up with the
                                 waypoint circle centres above and below. -->
                            <DataTemplate x:DataType="vm:RouteLegRowViewModel">
                                <Panel>
                                <Grid Classes="legRow"
                                      IsVisible="{Binding IsCollapsed}"
                                      Classes.selected="{Binding IsSelected}"
                                      ColumnDefinitions="3,*">
                                    <Border Grid.Column="0" Classes="wpBar" />
                                    <Panel Grid.Column="1">
                                    <Border Classes="wpTint" />
                                    <!-- Full-area select target (bottom layer). -->
                                    <Button Classes="wpHit"
                                            AutomationProperties.AutomationId="Routes.Leg"
                                            AutomationProperties.Name="{Binding LegText}"
                                            AutomationProperties.HelpText="{x:Static loc:Strings.Tooltip_SelectLeg}"
                                            Command="{Binding $parent[ItemsControl].((vm:RoutesPanelViewModel)DataContext).SelectLegCommand}"
                                            CommandParameter="{Binding}" />
                                <Grid ColumnDefinitions="28,*" ColumnSpacing="8" Margin="8,5,8,5">
                                    <Border Grid.Column="0" Classes="legConnector" IsHitTestVisible="False" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                        <TextBlock Classes="legText"
                                                   Text="{Binding LegText}"
                                                   FontSize="11"
                                                   Opacity="0.75"
                                                   IsHitTestVisible="False"
                                                   VerticalAlignment="Center" />
                                        <!-- Overridden values (handoff B4): "● 8,0 kn". -->
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="4"
                                                    VerticalAlignment="Center"
                                                    IsHitTestVisible="False"
                                                    IsVisible="{Binding HasOverrides}">
                                            <Ellipse Width="5" Height="5"
                                                     VerticalAlignment="Center"
                                                     Fill="{DynamicResource AccentBrush}" />
                                            <TextBlock AutomationProperties.AutomationId="Routes.Leg.Overrides"
                                                       Text="{Binding OverrideSummary}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Classes="geoChip"
                                                AutomationProperties.AutomationId="Routes.Leg.Geometry"
                                                Classes.geodesic="{Binding IsGeodesic}"
                                                Content="{Binding GeometryText}"
                                                Command="{Binding $parent[ItemsControl].((vm:RoutesPanelViewModel)DataContext).ToggleLegGeometryAtCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{x:Static loc:Strings.Tooltip_ToggleLegGeometry}" />
                                    </StackPanel>
                                </Grid>
                                    </Panel>
                                </Grid>
                                <!-- Leg detail (#898, handoff B5): the selected leg
                                     opens inline, so one leg is open at a time. -->
                                <Panel Margin="10,2,0,2" IsVisible="{Binding IsSelected}">
                                    <Border CornerRadius="8"
                                            Background="{DynamicResource CardBackgroundColor}" />
                                    <Border CornerRadius="8"
                                            Background="{DynamicResource AccentBrush}"
                                            Opacity="0.07" />
                                    <Border CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            Opacity="0.3" />
                                    <Border Width="3"
                                            CornerRadius="1.5"
                                            Margin="0,8"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource AccentBrush}" />
                                    <StackPanel Spacing="8" Margin="14,9,10,10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Header}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding LegText}"
                                                       FontSize="11"
                                                       Opacity="0.65"
                                                       FontFamily="Menlo,Consolas,Courier New,monospace"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="2"
                                                    Classes="link"
                                                    AutomationProperties.AutomationId="Routes.Leg.Close"
                                                    AutomationProperties.Name="{x:Static loc:Strings.Tooltip_CloseLeg}"
                                                    Command="{Binding CloseCommand}"
                                                    ToolTip.Tip="{x:Static loc:Strings.Tooltip_CloseLeg}">
                                                <ic:FluentIcon Icon="ChevronUp" IconVariant="Regular" FontSize="12" />
                                            </Button>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*"
                                              RowDefinitions="Auto,Auto"
                                              ColumnSpacing="8"
                                              RowSpacing="6">
                                            <ContentControl Grid.Row="0" Grid.Column="0"
                                                            Content="{Binding Speed}"
                                                            ContentTemplate="{StaticResource PassageFieldTemplate}" />
                                            <ContentControl Grid.Row="0" Grid.Column="1"
                                                            Content="{Binding Draft}"
                                                            ContentTemplate="{StaticResource PassageFieldTemplate}" />
                                            <ContentControl Grid.Row="1" Grid.Column="0"
                                                            Content="{Binding CrossTrack}"
                                                            ContentTemplate="{StaticResource PassageFieldTemplate}" />
                                            <ContentControl Grid.Row="1" Grid.Column="1"
                                                            Content="{Binding RequiredUkc}"
                                                            ContentTemplate="{StaticResource PassageFieldTemplate}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Classes="segmentTrack">
                                                <UniformGrid Rows="1">
                                                    <ToggleButton Classes="segment"
                                                                  AutomationProperties.AutomationId="Routes.Leg.Rhumb"
                                                                  Content="{x:Static loc:Strings.Routes_GeometryLoxodrome}"
                                                                  IsChecked="{Binding IsRhumb, Mode=OneWay}"
                                                                  Command="{Binding SetRhumbCommand}" />
                                                    <ToggleButton Classes="segment"
                                                                  AutomationProperties.AutomationId="Routes.Leg.GreatCircle"
                                                                  Content="{x:Static loc:Strings.Routes_GeometryGeodesic}"
                                                                  IsChecked="{Binding IsGeodesic, Mode=OneWay}"
                                                                  Command="{Binding SetGreatCircleCommand}" />
                                                </UniformGrid>
                                            </Border>
                                            <Button Grid.Column="2"
                                                    Classes="link"
                                                    AutomationProperties.AutomationId="Routes.Leg.AddNote"
                                                    Content="{x:Static loc:Strings.Leg_AddNote}"
                                                    FontSize="11"
                                                    IsVisible="{Binding IsNoteHidden}"
                                                    Command="{Binding AddNoteCommand}" />
                                        </Grid>
                                        <TextBox Classes="legNote"
                                                 AutomationProperties.AutomationId="Routes.Leg.Note"
                                                 AutomationProperties.Name="{x:Static loc:Strings.Leg_Note}"
                                                 PlaceholderText="{x:Static loc:Strings.Leg_Note}"
                                                 FontSize="12"
                                                 Text="{Binding Note, Mode=TwoWay}"
                                                 IsVisible="{Binding IsNoteVisible}">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" Command="{Binding CommitNoteCommand}" />
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                        <TextBlock Text="{Binding Footnote}"
                                                   FontSize="10.5"
                                                   Opacity="0.6"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Panel>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- No-active-route hint. -->
                <TextBlock Grid.Row="0"
                           Text="{Binding NoActiveRouteText}"
                           FontSize="11"
                           Opacity="0.55"
                           TextWrapping="Wrap"
                           Margin="12,8"
                           VerticalAlignment="Top"
                           IsVisible="{Binding !HasActiveRoute}" />

                <!-- Footer mode toggles: Edit on the left, Check passage on
                     the right, in fixed places so a mode is turned off where it
                     was turned on. Turning Edit off is "done". -->
                <Border Grid.Row="1"
                        IsVisible="{Binding HasActiveRoute}"
                        Padding="8,6,8,8"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <ToggleButton Grid.Column="0"
                                      Classes="modeToggle"
                                      AutomationProperties.AutomationId="Routes.EditToggle"
                                      AutomationProperties.Name="{x:Static loc:Strings.Button_EditRoute}"
                                      AutomationProperties.HelpText="{Binding EditToggleTooltip}"
                                      IsChecked="{Binding IsEditing, Mode=TwoWay}"
                                      ToolTip.Tip="{Binding EditToggleTooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <ic:FluentIcon Icon="Edit" IconVariant="Regular" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static loc:Strings.Button_EditRoute}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Grid.Column="2"
                                      Classes="modeToggle"
                                      AutomationProperties.AutomationId="Routes.CheckPassageToggle"
                                      AutomationProperties.Name="{x:Static loc:Strings.Button_CheckPassage}"
                                      AutomationProperties.HelpText="{Binding CheckPassageTooltip}"
                                      IsEnabled="{Binding CanCheckPassage}"
                                      IsChecked="{Binding IsCheckingPassage, Mode=OneWay}"
                                      ToolTip.Tip="{Binding CheckPassageTooltip}"
                                      ToolTip.ShowOnDisabled="True">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <ic:FluentIcon Icon="Gauge" IconVariant="Regular" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static loc:Strings.Button_CheckPassage}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
