<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EncDotNet.S100.Viewer.ViewModels"
             xmlns:loc="using:EncDotNet.S100.Viewer.Resources"
             x:Class="EncDotNet.S100.Viewer.Views.SharedFeedDialogView"
             x:DataType="vm:SharedFeedDialogViewModel"
             MinWidth="440">

    <Grid RowDefinitions="Auto,Auto,Auto" Margin="20,12,20,16">
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,24,12">
            <TextBlock Text="{x:Static loc:Strings.Library_SharedFeedTitle}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static loc:Strings.Library_SharedFeedDescription}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
            <Border Background="{DynamicResource MutedBackgroundColor}" CornerRadius="4" Padding="8,4">
                <SelectableTextBlock Text="{Binding ServeCommand}" FontSize="12"
                                     FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
            </Border>
            <TextBlock Text="{x:Static loc:Strings.Library_SharedFeedHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBox Text="{Binding Url}" PlaceholderText="{x:Static loc:Strings.Library_SharedFeedUrlWatermark}" />
            <TextBlock Text="{x:Static loc:Strings.Library_SharedFeedChecking}" IsVisible="{Binding IsChecking}"
                       FontSize="11" Opacity="0.7" />
            <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}"
                       FontSize="11" Foreground="{DynamicResource ErrorColor}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Classes="Outline" Content="{x:Static loc:Strings.Button_Cancel}" Command="{Binding CancelCommand}" />
            <Button Classes="Primary" Content="{x:Static loc:Strings.Button_Connect}" Command="{Binding ConnectCommand}"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</UserControl>
