<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:EncDotNet.S100.Viewer.ViewModels"
             xmlns:views="using:EncDotNet.S100.Viewer.Views"
             xmlns:diag="using:EncDotNet.S100.Viewer.Diagnostics"
             xmlns:loc="using:EncDotNet.S100.Viewer.Resources"
             x:Class="EncDotNet.S100.Viewer.Views.MapPane"
             x:DataType="vm:MainViewModel">
    <!--
      The automation ids below are defaults: MapPane.Bind and NameNavigation
      name them after the pane's map id (MapPane.map-2.Close), and the
      rightmost pane's zoom buttons keep Map.ZoomIn and the rest.

      One map pane (#1729, dual-map design note §2.1): the map control and the
      chrome that belongs to this map (D8): the header while the map is split
      (D9), the scale bar, the zoom buttons and compass, and the map stamp. The
      window-level overlays (mode column, tool cards, chips) stay in
      MainWindow, placed over the whole map area; the one Time HUD is moved
      into the active pane's HUD slot. The DataContext is the window's
      MainViewModel; the header and the folded strip bind to the pane's
      MapPaneViewModel (set in code).
    -->
    <UserControl.Styles>
        <!-- D5: the active header is white with a 2 px accent line and a
             filled number; the others are grey with a grey chip. -->
        <Style Selector="Border.paneHeader">
            <Setter Property="Background" Value="{DynamicResource MutedBackgroundColor}" />
        </Style>
        <Style Selector="Border.paneHeader.active">
            <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
        </Style>
        <Style Selector="Border.paneChip">
            <Setter Property="Background" Value="{DynamicResource BorderColor}" />
        </Style>
        <Style Selector="Border.paneChip TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        </Style>
        <Style Selector="Border.paneChip.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.paneChip.active TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- D13: a linked chain is drawn in the accent colour. -->
        <Style Selector="ToggleButton.paneLink ic|FluentIcon.linked">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ToggleButton.paneLink:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBlock.paneTitle">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="TextBlock.paneTitle.active">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- The pane header (D9): number chip and name, then the link chain
             (D13) and close. -->
        <Border x:Name="Header"
                AutomationProperties.AutomationId="MapPane.Header"
                x:DataType="vm:MapPaneViewModel"
                DockPanel.Dock="Top"
                Height="26"
                Classes="paneHeader"
                Classes.active="{Binding IsActive}"
                IsVisible="{Binding IsHeaderVisible}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1">
            <Panel>
                <Border Height="2"
                        VerticalAlignment="Top"
                        Background="{DynamicResource AccentBrush}"
                        IsVisible="{Binding IsActive}" />
                <DockPanel Margin="8,0,4,0">
                    <Button x:Name="CloseButton"
                AutomationProperties.AutomationId="MapPane.Close"
                            DockPanel.Dock="Right"
                            Classes="Ghost"
                            Command="{Binding CloseCommand}"
                            AutomationProperties.Name="{Binding CloseText}"
                            ToolTip.Tip="{Binding CloseText}"
                            Width="20" Height="20" MinHeight="0" MinWidth="0"
                            Padding="0"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" FontSize="12"
                                       Foreground="{DynamicResource ForegroundColor}" />
                    </Button>
                    <!-- D13: one link state for the window in step 1; every
                         header's chain shows it and toggles it. -->
                    <ToggleButton x:Name="LinkButton"
                                  AutomationProperties.AutomationId="MapPane.Link"
                                  DockPanel.Dock="Right"
                                  Classes="paneLink"
                                  IsChecked="{Binding IsLinked, Mode=OneWay}"
                                  Command="{Binding ToggleLinkCommand}"
                                  AutomationProperties.Name="{Binding LinkText}"
                                  ToolTip.Tip="{Binding LinkText}"
                                  Height="20" MinHeight="0" MinWidth="20"
                                  Margin="0,0,4,0"
                                  Padding="3,0"
                                  VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Background="Transparent"
                                  BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <ic:FluentIcon Icon="Link" IconVariant="Regular" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundColor}"
                                           Classes.linked="{Binding IsLinked}" />
                            <TextBlock Text="{x:Static loc:Strings.SplitMap_Linked}"
                                       IsVisible="{Binding IsLinked}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </ToggleButton>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Classes="paneChip"
                                Classes.active="{Binding IsActive}"
                                CornerRadius="3"
                                MinWidth="16"
                                Height="16"
                                Padding="4,0">
                            <TextBlock Text="{Binding Number}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <!-- D19: double-click the name to rename the pane in
                             place; Enter commits, Esc cancels, blank goes
                             back to "Map N". -->
                        <TextBlock x:Name="TitleText"
                                   AutomationProperties.AutomationId="MapPane.Title"
                                   Classes="paneTitle"
                                   Classes.active="{Binding IsActive}"
                                   Text="{Binding Title}"
                                   IsVisible="{Binding !IsRenaming}"
                                   ToolTip.Tip="{Binding RenameText}"
                                   Background="Transparent"
                                   FontSize="12"
                                   Foreground="{DynamicResource ForegroundColor}"
                                   VerticalAlignment="Center"
                                   DoubleTapped="OnTitleDoubleTapped" />
                        <TextBox x:Name="NameEditor"
                                 AutomationProperties.AutomationId="MapPane.NameEditor"
                                 AutomationProperties.Name="{Binding RenameText}"
                                 Text="{Binding EditedName}"
                                 IsVisible="{Binding IsRenaming}"
                                 MaxLength="64"
                                 AcceptsReturn="False"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 Width="160"
                                 Height="20" MinHeight="0"
                                 Margin="-5,0,0,0"
                                 Padding="4,0"
                                 CornerRadius="4"
                                 BorderThickness="1"
                                 BorderBrush="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource BackgroundColor}"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 LostFocus="OnNameEditorLostFocus" />
                    </StackPanel>
                </DockPanel>
            </Panel>
        </Border>

        <!-- A folded pane (D17): a 28 px strip with its number; a click
             unfolds it and makes it active. -->
        <Button x:Name="FoldStrip"
                AutomationProperties.AutomationId="MapPane.FoldStrip"
                x:DataType="vm:MapPaneViewModel"
                IsVisible="{Binding IsFolded}"
                Command="{Binding ActivateCommand}"
                AutomationProperties.Name="{Binding UnfoldText}"
                ToolTip.Tip="{Binding UnfoldText}"
                Width="28"
                MinWidth="0"
                Padding="0,6,0,0"
                CornerRadius="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Top"
                BorderThickness="0"
                Background="{DynamicResource MutedBackgroundColor}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <Border Classes="paneChip"
                        CornerRadius="3"
                        MinWidth="16"
                        Height="16"
                        Padding="4,0"
                        HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Number}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <LayoutTransformControl HorizontalAlignment="Center">
                    <LayoutTransformControl.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </LayoutTransformControl.LayoutTransform>
                    <TextBlock Text="{Binding FoldedText}"
                               FontSize="11"
                               Opacity="0.7"
                               Foreground="{DynamicResource ForegroundColor}" />
                </LayoutTransformControl>
            </StackPanel>
        </Button>

        <Panel x:Name="MapContent">
            <diag:InstrumentedMapControl x:Name="MapControl" />
            <diag:GpuAccelerationProbe />
            <views:ScaleBarView x:Name="ScaleBar"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,4,0,0" />
            <!-- Map stamp (#713 B4): the view time over the map while the
                 Timeline tab is shown in the dock, so the map (and any
                 screenshot of it) says which time it shows; the Time HUD
                 takes over otherwise, never both (design note
                 time-overlays D1). Green dot Live, accent Pinned. With
                 date-dependent data loaded and the time pinned it starts
                 "Display Not Real Time" (S-98 §12.7.2; #993), as the HUD
                 does. -->
            <Panel HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="12,12,0,0"
                   IsHitTestVisible="False"
                   AutomationProperties.AutomationId="Map.TimeStamp"
                   IsVisible="{Binding Layout.IsMapStampVisible}">
                <Border Background="{DynamicResource MapOverlaySurfaceBrush}"
                        CornerRadius="6" />
                <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            Margin="8,4">
                    <Panel VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7"
                                 IsVisible="{Binding Timeline.IsLive}"
                                 Fill="{DynamicResource SuccessColor}" />
                        <Ellipse Width="7" Height="7"
                                 IsVisible="{Binding !Timeline.IsLive}"
                                 Fill="{DynamicResource AccentBrush}" />
                        <!-- Grey while the map is still drawing the new time (#709). -->
                        <Ellipse Width="7" Height="7"
                                 IsVisible="{Binding Timeline.IsDrawing}"
                                 Fill="#A1A1AA" />
                    </Panel>
                    <TextBlock Text="{Binding Timeline.StampText}"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11.5"
                               Foreground="{DynamicResource ForegroundColor}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Panel>

            <!-- The pane's zoom buttons and compass (D8). In the rightmost
                 pane they sit under the window's mode buttons, in the window's
                 overlay column; MainWindow moves them there. -->
            <Panel x:Name="NavigationHost"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,12,12,12">
                <StackPanel x:Name="Navigation" Orientation="Vertical" Spacing="2" Margin="0,2,0,0">
                    <!--
                      StackPanel with vertical margin gives the cluster its
                      own visual grouping (separated from the Pick Mode
                      button above and the compass rose below).
                    -->
                    <StackPanel Orientation="Vertical" Spacing="2" Margin="0,16,0,16">
                        <Button x:Name="ZoomInButton"
                AutomationProperties.AutomationId="Map.ZoomIn"
                                AutomationProperties.Name="{x:Static loc:Strings.Tooltip_ZoomIn}"
                                Classes="Icon MapOverlay"
                                ToolTip.Tip="{x:Static loc:Strings.Tooltip_ZoomIn}">
                            <ic:FluentIcon Icon="ZoomIn" IconVariant="Regular" FontSize="16" />
                        </Button>
                        <Button x:Name="ZoomOutButton"
                AutomationProperties.AutomationId="Map.ZoomOut"
                                AutomationProperties.Name="{x:Static loc:Strings.Tooltip_ZoomOut}"
                                Classes="Icon MapOverlay"
                                ToolTip.Tip="{x:Static loc:Strings.Tooltip_ZoomOut}">
                            <ic:FluentIcon Icon="ZoomOut" IconVariant="Regular" FontSize="16" />
                        </Button>
                        <Button x:Name="ZoomToExtentButton"
                AutomationProperties.AutomationId="Map.ZoomToExtent"
                                AutomationProperties.Name="{x:Static loc:Strings.Tooltip_ZoomToExtent}"
                                Classes="Icon MapOverlay"
                                ToolTip.Tip="{x:Static loc:Strings.Tooltip_ZoomToExtent}">
                            <ic:FluentIcon Icon="ZoomFit" IconVariant="Regular" FontSize="16" />
                        </Button>
                    </StackPanel>
                    <views:CompassRoseView x:Name="CompassRose"
                                           Margin="0,4,0,0"
                                           Width="{Binding Bounds.Width, ElementName=ZoomInButton}"
                                           Height="{Binding Bounds.Width, ElementName=ZoomInButton}" />
                </StackPanel>
            </Panel>

            <!-- The one Time HUD sits here in the active pane (D8). -->
            <Panel x:Name="HudHost" />
        </Panel>
    </DockPanel>
</UserControl>
