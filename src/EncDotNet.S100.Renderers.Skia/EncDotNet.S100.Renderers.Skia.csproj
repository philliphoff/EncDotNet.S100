<Project Sdk="Microsoft.NET.Sdk">


  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- Ship the self-contained SkiaSharp Linux native so the headless render
         path works on arm64 and on hosts without fontconfig (issue #23). -->
    <UseSkiaSharpLinuxNoDependencies>true</UseSkiaSharpLinuxNoDependencies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Svg.Skia" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deterministic text fallback for hosts with no usable system font
         (e.g. NoDependencies native without fontconfig). See Assets/Fonts/README.md. -->
    <EmbeddedResource Include="Assets/Fonts/OpenSans-Regular.ttf">
      <LogicalName>EncDotNet.S100.Renderers.Skia.Assets.Fonts.OpenSans-Regular.ttf</LogicalName>
    </EmbeddedResource>
    <None Include="Assets/Fonts/README.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EncDotNet.S100.Core\EncDotNet.S100.Core.csproj" />
    <ProjectReference Include="..\EncDotNet.S100.Portrayals\EncDotNet.S100.Portrayals.csproj" />
  </ItemGroup>

</Project>
